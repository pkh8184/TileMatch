    Ko: "\uB2E4\uB978 \uC0AC\uB78C\uBCF4\uB2E4 \uBE60\uB974\uAC8C \uC2A4\uD14C\uC774\uC9C0
      \\n15\uAC1C\uB97C \uC644\uB8CC\uD558\uC5EC \uBCF4\uC0C1\uC744 \uBC1B\uC73C\uC138\uC694!"
    Ja: "\u4ED6\u3088\u308A\u901F\u304F\u30B9\u30C6\u30FC\u30B8 \\n15\u500B\u3092\u5B8C\u4E86\u3057\u3066\u5831\u916C\u3092\u53D7\u3051\u53D6\u308D\u3046\uFF01"
    Zh: "\u6BD4\u5176\u4ED6\u73A9\u5BB6\u66F4\u5FEB\u5B8C\u6210 15 \u4E2A\u5173\u5361\u5373\u53EF\u83B7\u5F97\u5956\u52B1\uFF01"
    Vi: "Ho\xE0n th\xE0nh 15 m\xE0n ch\u01A1i nhanh h\u01A1n nh\u1EEFng ng\u01B0\u1EDDi
      kh\xE1c \u0111\u1EC3 nh\u1EADn ph\u1EA7n th\u01B0\u1EDFng!"
    Hi: "\u092A\u0941\u0930\u0938\u094D\u0915\u093E\u0930 \u092A\u093E\u0928\u0947
      \u0915\u0947 \u0932\u093F\u090F 15 \u091A\u0930\u0923\u094B\u0902 \u0915\u094B
      \u0926\u0942\u0938\u0930\u094B\u0902 \u0938\u0947 \u092A\u0939\u0932\u0947
      \u092A\u0942\u0930\u093E \u0915\u0930\u0947\u0902!"
    Ar: "\u0623\u0643\u0645\u0644 15 \u0645\u0631\u062D\u0644\u0629 \u0623\u0633\u0631\u0639
      \u0645\u0646 \u0627\u0644\u0622\u062E\u0631\u064A\u0646 \u0644\u062A\u062D\u0635\u0644
      \u0639\u0644\u0649 \u0645\u0643\u0627\u0641\u0622\u062A!"
