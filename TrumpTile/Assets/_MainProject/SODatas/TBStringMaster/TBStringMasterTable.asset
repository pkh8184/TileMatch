    Ko: "\uC2A4\uD14C\uC774\uC9C0\uC5D0\uC11C \uBCF4\uC11D\uC744 \uC218\uC9D1\uD558\uACE0
      \uC218\uC9D1\uD568\uC5D0 \uB4F1\uB85D\uD55C \uD6C4 \uBCF4\uC0C1\uC744 \uD68D\uB4DD\uD574\uC694!"
    Ja: "\u30B9\u30C6\u30FC\u30B8\u3067\u30B8\u30A7\u30E0\u3092\u96C6\u3081\u3066\u30B3\u30EC\u30AF\u30B7\u30E7\u30F3\u306B\u767B\u9332\u3057\u3001\u5831\u916C\u3092\u7372\u5F97\u3057\u3088\u3046\uFF01"
    Zh: "\u5728\u5173\u5361\u4E2D\u6536\u96C6\u5B9D\u77F3\u5E76\u767B\u8BB0\u5230\u6536\u85CF\u518C\uFF0C\u5373\u53EF\u83B7\u5F97\u5956\u52B1\uFF01"
    Vi: "Thu th\u1EADp \u0111\xE1 qu\xFD trong m\xE0n ch\u01A1i, \u0111\u0103ng k\xFD
      v\xE0o b\u1ED9 s\u01B0u t\u1EADp v\xE0 nh\u1EADn th\u01B0\u1EDFng!"
    Hi: "\u0938\u094D\u091F\u0947\u091C \u092E\u0947\u0902 \u091C\u0947\u092E \u0907\u0915\u091F\u094D\u0920\u093E
      \u0915\u0930\u0947\u0902, \u0915\u0932\u0947\u0915\u094D\u0936\u0928 \u092E\u0947\u0902
      \u0926\u0930\u094D\u091C \u0915\u0930\u0947\u0902 \u0914\u0930 \u0907\u0928\u093E\u092E
      \u092A\u093E\u090F\u0901!"
    Ar: "\u0627\u062C\u0645\u0639 \u0627\u0644\u062C\u0648\u0627\u0647\u0631 \u0641\u064A
      \u0627\u0644\u0645\u0631\u0627\u062D\u0644 \u0648\u0633\u062C\u0651\u0644\u0647\u0627
      \u0641\u064A \u0627\u0644\u0645\u062C\u0645\u0648\u0639\u0629 \u062B\u0645
      \u0627\u062D\u0635\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062A!"
  - Key: 200172
    En: The ranking competition has begun! Compete with others through the rankings!
    Ko: "\uC21C\uC704 \uACBD\uC7C1\uC774 \uC2DC\uC791\uB418\uC5C8\uC5B4\uC694! \uC21C\uC704
