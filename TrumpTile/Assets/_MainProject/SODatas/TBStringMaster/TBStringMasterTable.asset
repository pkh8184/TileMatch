    Hi: "\u0932\u0917\u093E\u0924\u093E\u0930 7 \u0932\u0947\u0935\u0932 \u092A\u0942\u0930\u0947
      \u0915\u0930\u0947\u0902 \u0914\u0930 \u0907\u0928\u093E\u092E \u092A\u093E\u090F\u0901!"
    Ar: "\u0623\u0643\u0645\u0644 7 \u0645\u0633\u062A\u0648\u064A\u0627\u062A \u0645\u062A\u062A\u0627\u0644\u064A\u0629
