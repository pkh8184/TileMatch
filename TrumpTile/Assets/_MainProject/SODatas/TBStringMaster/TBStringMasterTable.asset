    Ja: "\u30C7\u30FC\u30BF\u306E\u8AAD\u307F\u8FBC\u307F\u306B\u6210\u529F\u3057\u307E\u3057\u305F\u3002\u30B2\u30FC\u30E0\u3092\u518D\u8D77\u52D5\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    Zh: "\u6570\u636E\u52A0\u8F7D\u6210\u529F\u3002\u8BF7\u91CD\u65B0\u542F\u52A8\u6E38\u620F\u3002"
    Vi: "D\u1EEF li\u1EC7u \u0111\xE3 \u0111\u01B0\u1EE3c t\u1EA3i th\xE0nh c\xF4ng.
      Vui l\xF2ng kh\u1EDFi \u0111\u1ED9ng l\u1EA1i tr\xF2 ch\u01A1i."
    Hi: "\u0921\u0947\u091F\u093E \u0938\u092B\u0932\u0924\u093E\u092A\u0942\u0930\u094D\u0935\u0915
      \u0932\u094B\u0921 \u0939\u094B \u0917\u092F\u093E \u0939\u0948\u0964 \u0915\u0943\u092A\u092F\u093E
      \u0917\u0947\u092E \u0915\u094B \u092A\u0941\u0928\u0903 \u0906\u0930\u0902\u092D
      \u0915\u0930\u0947\u0902\u0964"
    Ar: "\u062A\u0645 \u062A\u062D\u0645\u064A\u0644 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A
      \u0628\u0646\u062C\u0627\u062D. \u064A\u0631\u062C\u0649 \u0625\u0639\u0627\u062F\u0629
      \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0644\u0639\u0628\u0629."
  - Key: 200232
    En: Failed to load data. No data is stored.
    Ko: "\uB370\uC774\uD130\uB97C \uBD88\uB7EC\uC624\uB294\uB370\uC5D0 \uC2E4\uD328\uD558\uC600\uC2B5\uB2C8\uB2E4.
      \uC800\uC7A5\uB41C \uB370\uC774\uD130\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    Ja: "\u30C7\u30FC\u30BF\u306E\u8AAD\u307F\u8FBC\u307F\u306B\u5931\u6557\u3057\u307E\u3057\u305F\u3002\u4FDD\u5B58\u3055\u308C\u305F\u30C7\u30FC\u30BF\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
    Zh: "\u6570\u636E\u52A0\u8F7D\u5931\u8D25\u3002\u672A\u5B58\u50A8\u4EFB\u4F55\u6570\u636E\u3002"
    Vi: "Kh\xF4ng th\u1EC3 t\u1EA3i d\u1EEF li\u1EC7u. Kh\xF4ng c\xF3 d\u1EEF li\u1EC7u
      n\xE0o \u0111\u01B0\u1EE3c l\u01B0u tr\u1EEF."
    Hi: "\u0921\u0947\u091F\u093E \u0932\u094B\u0921 \u0915\u0930\u0928\u0947 \u092E\u0947\u0902
      \u0935\u093F\u092B\u0932\u0964 \u0915\u094B\u0908 \u0921\u0947\u091F\u093E
      \u0938\u0902\u0917\u094D\u0930\u0939\u0940\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
    Ar: "\u0641\u0634\u0644 \u062A\u062D\u0645\u064A\u0644 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A.
      \u0644\u0627 \u062A\u0648\u062C\u062F \u0628\u064A\u0627\u0646\u0627\u062A
      \u0645\u062E\u0632\u0646\u0629."
