    Zh: "\u914D\u5BF9 3 \u5F20\u76F8\u540C\u56FE\u6848\uFF0C\u6BCF\u5929\u9886\u53D6\u5956\u52B1\uFF01"
    Vi: "Gh\xE9p 3 l\xE1 b\xE0i gi\u1ED1ng nhau \u0111\u1EC3 nh\u1EADn th\u01B0\u1EDFng
      m\u1ED7i ng\xE0y!"
    Hi: "3 \u090F\u0915 \u091C\u0948\u0938\u0947 \u0915\u093E\u0930\u094D\u0921 \u092E\u093F\u0932\u093E\u0915\u0930
      \u0930\u094B\u091C\u093C\u093E\u0928\u093E \u0907\u0928\u093E\u092E \u092A\u093E\u090F\u0901!"
    Ar: "\u0637\u0627\u0628\u0642 3 \u0628\u0637\u0627\u0642\u0627\u062A \u0645\u062A\u0634\u0627\u0628\u0647\u0629
      \u0648\u0627\u062D\u0635\u0644 \u0639\u0644\u0649 \u0645\u0643\u0627\u0641\u0623\u062A\u0643
