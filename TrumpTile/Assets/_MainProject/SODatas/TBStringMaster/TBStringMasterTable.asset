      \u0909\u0928\u094D\u0939\u0947\u0902 \u0939\u091F\u093E\u0915\u0930 \u0926\u094B\u092C\u093E\u0930\u093E
      \u0926\u0930\u094D\u091C \u0915\u0930\u0947\u0902\u0964"
    Ar: "\u064A\u062D\u062A\u0648\u064A \u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062A\u0639\u0627\u0631
