    Ja: "\u30E9\u30F3\u30AD\u30F3\u30B0\u7AF6\u4E89\u304C\u59CB\u307E\u308A\u307E\u3057\u305F\uFF01\u30E9\u30F3\u30AD\u30F3\u30B0\u7AF6\u4E89\u3067\u5BFE\u6C7A\u3057\u3088\u3046\uFF01"
    Zh: "\u6392\u540D\u7ADE\u8D5B\u5F00\u59CB\u4E86\uFF01\u901A\u8FC7\u6392\u540D\u7ADE\u8D5B\u4E00\u51B3\u9AD8\u4E0B\u5427\uFF01"
    Vi: "Cu\u1ED9c \u0111ua x\u1EBFp h\u1EA1ng \u0111\xE3 b\u1EAFt \u0111\u1EA7u!
      H\xE3y tranh t\xE0i qua cu\u1ED9c \u0111ua x\u1EBFp h\u1EA1ng!"
    Hi: "\u0930\u0948\u0902\u0915\u093F\u0902\u0917 \u092A\u094D\u0930\u0924\u093F\u092F\u094B\u0917\u093F\u0924\u093E
      \u0936\u0941\u0930\u0942 \u0939\u094B \u0917\u0908 \u0939\u0948! \u0930\u0948\u0902\u0915\u093F\u0902\u0917
      \u0915\u0947 \u091C\u093C\u0930\u093F\u090F \u092E\u0941\u0915\u093E\u092C\u0932\u093E
      \u0915\u0930\u0947\u0902!"
    Ar: "\u0628\u062F\u0623\u062A \u0645\u0646\u0627\u0641\u0633\u0629 \u0627\u0644\u062A\u0631\u062A\u064A\u0628!
      \u062A\u0646\u0627\u0641\u0633 \u0645\u0639 \u0627\u0644\u0622\u062E\u0631\u064A\u0646
      \u0639\u0628\u0631 \u0627\u0644\u062A\u0631\u062A\u064A\u0628!"
  - Key: 200173
    En: Spin the lucky wheel for amazing rewards and conquer the levels!
    Ko: "\uD589\uC6B4\uC758 \uB8F0\uB81B\uC744 \uD68C\uC804\uC2DC\uCF1C \uB180\uB77C\uC6B4
      \uBCF4\uC0C1\uC744 \uC5BB\uACE0 \uB808\uBCA8\uC744 \uACF5\uB7B5\uD558\uC138\uC694!"
    Ja: "\u30E9\u30C3\u30AD\u30FC\u30EB\u30FC\u30EC\u30C3\u30C8\u3092\u56DE\u3057\u3066\u9A5A\u304D\u306E\u5831\u916C\u3092\u624B\u306B\u5165\u308C\u3001\u30EC\u30D9\u30EB\u3092\u653B\u7565\u3057\u3088\u3046\uFF01"
    Zh: "\u8F6C\u52A8\u5E78\u8FD0\u8F6E\u76D8\uFF0C\u83B7\u5F97\u60CA\u559C\u5956\u52B1\uFF0C\u653B\u514B\u5173\u5361\u5427\uFF01"
    Vi: "Quay v\xF2ng quay may m\u1EAFn \u0111\u1EC3 nh\u1EADn th\u01B0\u1EDFng b\u1EA5t
      ng\u1EDD v\xE0 chinh ph\u1EE5c c\xE1c m\xE0n ch\u01A1i!"
    Hi: "\u0932\u0915\u0940 \u0935\u094D\u0939\u0940\u0932 \u0918\u0941\u092E\u093E\u0915\u0930
      \u0936\u093E\u0928\u0926\u093E\u0930 \u0907\u0928\u093E\u092E \u092A\u093E\u090F\u0901
      \u0914\u0930 \u0932\u0947\u0935\u0932 \u091C\u0940\u0924\u0947\u0902!"
    Ar: "\u0623\u062F\u0631 \u0639\u062C\u0644\u0629 \u0627\u0644\u062D\u0638 \u0644\u062A\u062D\u0635\u0644
      \u0639\u0644\u0649 \u0645\u0643\u0627\u0641\u0622\u062A \u0645\u0630\u0647\u0644\u0629
      \u0648\u062A\u062A\u063A\u0644\u0628 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u062A\u0648\u064A\u0627\u062A!"
  - Key: 200174
