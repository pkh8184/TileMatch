      \u0915\u093F\u092F\u093E \u091C\u093E \u0938\u0915\u0924\u093E \u0939\u0948\u0964\\n-
      4~8 \u0905\u0915\u094D\u0937\u0930\u094B\u0902 \u0915\u0947 \u092D\u0940\u0924\u0930
      \u092C\u0928\u093E\u092F\u093E \u091C\u093E \u0938\u0915\u0924\u093E \u0939\u0948"
    Ar: "\u064A\u0645\u0643\u0646 \u062A\u0639\u064A\u064A\u0646 \u0627\u0644\u0627\u0633\u0645
