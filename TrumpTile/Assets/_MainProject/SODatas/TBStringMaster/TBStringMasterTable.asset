    Ko: "16\uB808\uBCA8 \uC624\uD508"
    Ja: "16\u30EC\u30D9\u30EB\u30AA\u30FC\u30D7\u30F3"
    Zh: "16\u7EA7\u5F00\u653E"
    Vi: "T\u1EA7ng 16 \u0111\xE3 m\u1EDF c\u1EEDa"
    Hi: "\u0932\u0947\u0935\u0932 16 \u0916\u0941\u0932\u093E \u0939\u0948"
    Ar: "\u0627\u0644\u0645\u0633\u062A\u0648\u0649 16 \u0645\u0641\u062A\u0648\u062D"
  - Key: 1005
    En: The hammer returns one tile to the board.
    Ko: "\uB9DD\uCE58\uB294 \uD0C0\uC77C \uD558\uB098\uB97C \uBCF4\uB4DC\uB85C \uB418\uB3CC\uB9BD\uB2C8\uB2E4."
    Ja: "\u30CF\u30F3\u30DE\u30FC\u306F\u30BF\u30A4\u30EB1\u679A\u3092\u30DC\u30FC\u30C9\u306B\u623B\u3057\u307E\u3059\u3002"
    Zh: "\u9524\u5B50\u4F1A\u5C06\u4E00\u5757\u65B9\u5757\u653E\u56DE\u68CB\u76D8\u3002"
    Vi: "Chi\u1EBFc b\xFAa s\u1EBD \u0111\u01B0a m\u1ED9t qu\xE2n c\u1EDD tr\u1EDF
      l\u1EA1i b\xE0n c\u1EDD."
    Hi: "\u0939\u0925\u094C\u0921\u093C\u093E \u090F\u0915 \u091F\u093E\u0907\u0932
      \u0915\u094B \u0935\u093E\u092A\u0938 \u092C\u094B\u0930\u094D\u0921 \u092A\u0930
      \u0930\u0916 \u0926\u0947\u0924\u093E \u0939\u0948\u0964"
    Ar: "\u064A\u0639\u064A\u062F \u0627\u0644\u0645\u0637\u0631\u0642\u0629 \u0642\u0637\u0639\u0629
      \u0648\u0627\u062D\u062F\u0629 \u0625\u0644\u0649 \u0627\u0644\u0644\u0648\u062D\u0629."
  - Key: 1006
    En: The clock prevents the timer from moving.
    Ko: "\uC2DC\uACC4\uB294 \uD0C0\uC774\uBA38\uB97C \uC6C0\uC9C1\uC774\uC9C0 \uBABB\uD558\uAC8C
      \uD569\uB2C8\uB2E4."
    Ja: "\u6642\u8A08\u306F\u30BF\u30A4\u30DE\u30FC\u3092\u52D5\u304B\u3059\u306E\u3092\u9632\u304E\u307E\u3059\u3002"
    Zh: "\u65F6\u949F\u963B\u6B62\u4E86\u8BA1\u65F6\u5668\u7684\u79FB\u52A8\u3002"
    Vi: "Chi\u1EBFc \u0111\u1ED3ng h\u1ED3 ng\u0103n kh\xF4ng cho b\u1ED9 \u0111\u1EBFm
      th\u1EDDi gian ho\u1EA1t \u0111\u1ED9ng."
    Hi: "\u0918\u0921\u093C\u0940 \u091F\u093E\u0907\u092E\u0930 \u0915\u094B \u0939\u093F\u0932\u0928\u0947
      \u0938\u0947 \u0930\u094B\u0915\u0924\u0940 \u0939\u0948\u0964"
    Ar: "\u062A\u0645\u0646\u0639 \u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u0645\u0624\u0642\u062A
      \u0645\u0646 \u0627\u0644\u062A\u062D\u0631\u0643."
  - Key: 1007
    En: The hat shuffles the board tiles randomly.
    Ko: "\uBAA8\uC790\uB294 \uBCF4\uB4DC \uD0C0\uC77C\uC744 \uBB34\uC791\uC704\uB85C
      \uC154\uD50C\uD569\uB2C8\uB2E4."
    Ja: "\u5E3D\u5B50\u306F\u30DC\u30FC\u30C9\u30BF\u30A4\u30EB\u3092\u30E9\u30F3\u30C0\u30E0\u306B\u30B7\u30E3\u30C3\u30D5\u30EB\u3057\u307E\u3059\u3002"
    Zh: "\u5E3D\u5B50\u4F1A\u968F\u673A\u6253\u4E71\u68CB\u76D8\u4E0A\u7684\u65B9\u5757\u3002"
    Vi: "Chi\u1EBFc m\u0169 s\u1EBD x\xE1o tr\u1ED9n ng\u1EABu nhi\xEAn c\xE1c qu\xE2n
      c\u1EDD tr\xEAn b\xE0n c\u1EDD."
    Hi: "\u091F\u094B\u092A\u0940 \u092C\u094B\u0930\u094D\u0921 \u0915\u0940 \u091F\u093E\u0907\u0932\u094B\u0902
      \u0915\u094B \u092C\u0947\u0924\u0930\u0924\u0940\u092C \u0922\u0902\u0917
      \u0938\u0947 \u092B\u0947\u0930\u092C\u0926\u0932 \u0915\u0930\u0924\u0940
      \u0939\u0948\u0964"
    Ar: "\u062A\u0642\u0648\u0645 \u0627\u0644\u0642\u0628\u0639\u0629 \u0628\u062E\u0644\u0637
      \u0642\u0637\u0639 \u0627\u0644\u0644\u0648\u062D\u0629 \u0628\u0634\u0643\u0644
      \u0639\u0634\u0648\u0627\u0626\u064A."
  - Key: 1008
    En: The bomb explodes tiles over a wide area.
    Ko: "\uD3ED\uD0C4\uC740 \uD0C0\uC77C\uC744 \uAD11\uBC94\uC704\uB85C \uD3ED\uBC1C\uC2DC\uD0B5\uB2C8\uB2E4."
    Ja: "\u7206\u5F3E\u306F\u30BF\u30A4\u30EB\u3092\u5E83\u7BC4\u56F2\u306B\u7206\u767A\u3055\u305B\u307E\u3059\u3002"
    Zh: "\u70B8\u5F39\u4F1A\u5728\u5927\u7247\u533A\u57DF\u5185\u5F15\u7206\u74F7\u7816\u3002"
    Vi: "Qu\u1EA3 bom ph\xE1t n\u1ED5, l\xE0m v\u1EE1 c\xE1c vi\xEAn g\u1EA1ch tr\xEAn
      m\u1ED9t khu v\u1EF1c r\u1ED9ng l\u1EDBn."
