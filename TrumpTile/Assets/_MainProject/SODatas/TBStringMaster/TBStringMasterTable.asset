    Ja: "\u30CB\u30C3\u30AF\u30CD\u30FC\u30E0\u306B\u4E0D\u9069\u5207\u306A\u8A00\u8449\u304C\u542B\u307E\u308C\u3066\u3044\u307E\u3059\u3002\\n\u4E0D\u9069\u5207\u306A\u8A00\u8449\u3092\u9664\u3044\u3066\u518D\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    Zh: "\u6635\u79F0\u4E2D\u5305\u542B\u4E0D\u5F53\u7528\u8BED\u3002\\n\u8BF7\u5220\u9664\u540E\u91CD\u65B0\u8F93\u5165\u3002"
    Vi: "Bi\u1EC7t danh c\xF3 ch\u1EE9a t\u1EEB ng\u1EEF kh\xF4ng ph\xF9 h\u1EE3p.\\nVui
      l\xF2ng lo\u1EA1i b\u1ECF v\xE0 nh\u1EADp l\u1EA1i."
    Hi: "\u0909\u092A\u0928\u093E\u092E \u092E\u0947\u0902 \u0905\u092A\u0936\u092C\u094D\u0926
