    Ar: "\u0631\u062D\u0644\u0629 \u0625\u0644\u0649 \u0628\u0631\u062C \u0625\u064A\u0641\u0644
      \u0641\u064A \u0628\u0627\u0631\u064A\u0633"
  - Key: 200110
    En: Winter sledding race
    Ko: "\uACA8\uC6B8 \uB208\uC370\uB9E4 \uC9C8\uC8FC"
    Ja: "\u51AC\u306E\u96EA\u305D\u308A\u75BE\u8D70"
    Zh: "\u51AC\u5B63\u96EA\u6A47\u6BD4\u8D5B"
    Vi: "Cu\u1ED9c \u0111ua tr\u01B0\u1EE3t tuy\u1EBFt m\xF9a \u0111\xF4ng"
    Hi: "\u0936\u0940\u0924\u0915\u093E\u0932\u0940\u0928 \u0938\u094D\u0932\u0947\u091C\u093F\u0902\u0917
      \u0926\u094C\u0921\u093C"
    Ar: "\u0633\u0628\u0627\u0642 \u0627\u0644\u062A\u0632\u0644\u062C \u0627\u0644\u0634\u062A\u0648\u064A"
  - Key: 200111
    En: Building sandcastles on the beach
    Ko: "\uD574\uBCC0\uC5D0\uC11C \uBAA8\uB798\uC131 \uC313\uAE30"
    Ja: "\u30D3\u30FC\u30C1\u3067\u7802\u306E\u7A4D\u307F\u91CD\u306D"
    Zh: "\u5728\u6D77\u6EE9\u4E0A\u5806\u6C99\u5821"
    Vi: "X\xE2y l\xE2u \u0111\xE0i c\xE1t tr\xEAn b\xE3i bi\u1EC3n"
    Hi: "\u0938\u092E\u0941\u0926\u094D\u0930 \u0924\u091F \u092A\u0930 \u0930\u0947\u0924
      \u0915\u0947 \u092E\u0939\u0932 \u092C\u0928\u093E\u0928\u093E"
    Ar: "\u0628\u0646\u0627\u0621 \u0642\u0644\u0627\u0639 \u0631\u0645\u0644\u064A\u0629
      \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0637\u0626"
  - Key: 200112
    En: Exciting pajama pillow fight
    Ko: "\uC2E0\uB098\uB294 \uD30C\uC790\uB9C8 \uBCA0\uAC1C \uC2F8\uC6C0"
    Ja: "\u30A8\u30AD\u30B5\u30A4\u30C6\u30A3\u30F3\u30B0\u306A\u30D1\u30B8\u30E3\u30DE\u6795\u306E\u6226\u3044"
    Zh: "\u7CBE\u5F69\u7684\u7761\u8863\u6795\u5934\u5927\u6218"
    Vi: "Tr\u1EADn chi\u1EBFn g\u1ED1i ng\u1EE7 th\xFA v\u1ECB"
    Hi: "\u0930\u094B\u092E\u093E\u0902\u091A\u0915 \u092A\u093E\u092F\u091C\u093E\u092E\u093E
      \u0924\u0915\u093F\u092F\u093E \u0932\u0921\u093C\u093E\u0908"
    Ar: "\u0645\u0639\u0631\u0643\u0629 \u0648\u0633\u0627\u0626\u062F \u0645\u062B\u064A\u0631\u0629
      \u0628\u0645\u0644\u0627\u0628\u0633 \u0627\u0644\u0646\u0648\u0645"
  - Key: 200113
    En: Egyptian Pyramid Exploration
    Ko: "\uC774\uC9D1\uD2B8 \uD53C\uB77C\uBBF8\uB4DC \uD0D0\uD5D8"
    Ja: "\u30A8\u30B8\u30D7\u30C8\u306E\u30D4\u30E9\u30DF\u30C3\u30C9\u3092\u63A2\u308B"
    Zh: "\u57C3\u53CA\u91D1\u5B57\u5854\u63A2\u9669"
    Vi: "Kh\xE1m ph\xE1 Kim t\u1EF1 th\xE1p Ai C\u1EADp"
    Hi: "\u092E\u093F\u0938\u094D\u0930 \u0915\u0947 \u092A\u093F\u0930\u093E\u092E\u093F\u0921
      \u0915\u0940 \u0916\u094B\u091C"
    Ar: "\u0627\u0633\u062A\u0643\u0634\u0627\u0641 \u0627\u0644\u0623\u0647\u0631\u0627\u0645\u0627\u062A
      \u0627\u0644\u0645\u0635\u0631\u064A\u0629"
  - Key: 200114
    En: Cute animal friends are enjoying camping in the forest. Gathering around
      a warm campfire, they roast marshmallows, drink cocoa, and share laughter.
      Isn't taking a break like this sometimes an essential moment for living life?
    Ko: "\uADC0\uC5EC\uC6B4 \uB3D9\uBB3C \uCE5C\uAD6C\uB4E4\uC774 \uC232\uC18D\uC5D0\uC11C
      \uCEA0\uD551\uC744 \uC990\uAE30\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uB530\uB73B\uD55C
      \uBAA8\uB2E5\uBD88 \uC55E\uC5D0 \uB458\uB7EC\uC549\uC544 \uB9C8\uC2DC\uBA5C\uB85C\uB97C
      \uAD7D\uACE0 \uCF54\uCF54\uC544\uB97C \uB9C8\uC2DC\uBA70 \uC6C3\uC74C\uAF43\uC744
      \uD53C\uC6C1\uB2C8\uB2E4. \uAC00\uB054\uC740 \uC774\uB807\uAC8C \uD734\uC2DD\uC744
      \uCDE8\uD558\uB294 \uAC83\uB3C4 \uC0B6\uC744 \uC0B4\uC544\uAC00\uB294 \uB370
      \uAF2D \uD544\uC694\uD55C \uC21C\uAC04\uC774 \uC544\uB2D0\uAE4C\uC694?"
    Ja: "\u304B\u308F\u3044\u3044\u52D5\u7269\u306E\u53CB\u9054\u304C\u68EE\u306E\u4E2D\u3067\u30AD\u30E3\u30F3\u30D7\u3092\u697D\u3057\u3093\u3067\u3044\u307E\u3059\u3002\u6696\u304B\u3044\u711A\u304D\u706B\u306E\u524D\u306B\u56F2\u307F\u3001\u30DE\u30B7\u30E5\u30DE\u30ED\u3092\u713C\u304D\u3001\u30B3\u30B3\u30A2\u3092\u98F2\u307F\u306A\u304C\u3089\u7B11\u3044\u306E\u82B1\u3092\u54B2\u304B\u305B\u307E\u3059\u3002\u305F\u307E\u306B\u306F\u3053\u3093\u306A\u4F11\u61A9\u3092\u53D6\u308B\u3053\u3068\u3082\u4EBA\u751F\u3092\u751F\u304D\u3066\u3044\u304F\u306E\u306B\u5FC5\u305A\u5FC5\u8981\u306A\u77AC\u9593\u3067\u306F\u306A\u3044\u3067\u3057\u3087\u3046\u304B\uFF1F"
    Zh: "\u4E00\u7FA4\u53EF\u7231\u7684\u52A8\u7269\u670B\u53CB\u6B63\u5728\u68EE\u6797\u91CC\u9732\u8425\u3002\u5B83\u4EEC\u56F4\u5750\u5728\u6E29\u6696\u7684\u7BDD\u706B\u65C1\uFF0C\u70E4\u68C9\u82B1\u7CD6\uFF0C\u559D\u70ED\u53EF\u53EF\uFF0C\u6B22\u58F0\u7B11\u8BED\u4E0D\u65AD\u3002\u50CF\u8FD9\u6837\u653E\u677E\u8EAB\u5FC3\uFF0C\u96BE\u9053\u4E0D\u662F\u751F\u6D3B\u4E2D\u4E0D\u53EF\u6216\u7F3A\u7684\u4E00\u90E8\u5206\u5417\uFF1F"
    Vi: "Nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n \u0111\u1ED9ng v\u1EADt \u0111\xE1ng
      y\xEAu \u0111ang t\u1EADn h\u01B0\u1EDFng chuy\u1EBFn c\u1EAFm tr\u1EA1i trong
      r\u1EEBng. Qu\xE2y qu\u1EA7n b\xEAn \u0111\u1ED1ng l\u1EEDa \u1EA5m \xE1p,
      ch\xFAng n\u01B0\u1EDBng k\u1EB9o d\u1EBBo, u\u1ED1ng ca cao v\xE0 c\xF9ng
      nhau c\u01B0\u1EDDi \u0111\xF9a. Ch\u1EB3ng ph\u1EA3i nh\u1EEFng kho\u1EA3nh
      kh\u1EAFc th\u01B0 gi\xE3n nh\u01B0 th\u1EBF n\xE0y \u0111\xF4i khi l\xE0 \u0111i\u1EC1u
      thi\u1EBFt y\u1EBFu \u0111\u1EC3 t\u1EADn h\u01B0\u1EDFng cu\u1ED9c s\u1ED1ng
      sao?"
    Hi: "\u092A\u094D\u092F\u093E\u0930\u0947-\u092A\u094D\u092F\u093E\u0930\u0947
      \u091C\u093E\u0928\u0935\u0930 \u0926\u094B\u0938\u094D\u0924 \u091C\u0902\u0917\u0932
      \u092E\u0947\u0902 \u0915\u0948\u0902\u092A\u093F\u0902\u0917 \u0915\u093E
      \u0906\u0928\u0902\u0926 \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964
      \u0917\u0930\u094D\u092E \u0905\u0932\u093E\u0935 \u0915\u0947 \u091A\u093E\u0930\u094B\u0902
      \u0913\u0930 \u0907\u0915\u091F\u094D\u0920\u093E \u0939\u094B\u0915\u0930
      \u0935\u0947 \u092E\u093E\u0930\u094D\u0936\u092E\u0948\u0932\u094B \u092D\u0942\u0928\u0924\u0947
      \u0939\u0948\u0902, \u0915\u094B\u0915\u094B \u092A\u0940\u0924\u0947 \u0939\u0948\u0902
      \u0914\u0930 \u0916\u0942\u092C \u0939\u0902\u0938\u0924\u0947 \u0939\u0948\u0902\u0964
      \u0915\u094D\u092F\u093E \u0907\u0938 \u0924\u0930\u0939 \u0915\u093E \u0906\u0930\u093E\u092E
      \u0915\u0930\u0928\u093E \u0915\u092D\u0940-\u0915\u092D\u0940 \u091C\u0940\u0935\u0928
      \u091C\u0940\u0928\u0947 \u0915\u093E \u090F\u0915 \u091C\u093C\u0930\u0942\u0930\u0940
      \u092A\u0932 \u0928\u0939\u0940\u0902 \u0939\u094B\u0924\u093E?"
    Ar: "\u0623\u0635\u062F\u0642\u0627\u0621 \u062D\u064A\u0648\u0627\u0646\u0627\u062A
      \u0644\u0637\u064A\u0641\u0648\u0646 \u064A\u0633\u062A\u0645\u062A\u0639\u0648\u0646
      \u0628\u0627\u0644\u062A\u062E\u064A\u064A\u0645 \u0641\u064A \u0627\u0644\u063A\u0627\u0628\u0629.
      \u064A\u062C\u062A\u0645\u0639\u0648\u0646 \u062D\u0648\u0644 \u0646\u0627\u0631
      \u062F\u0627\u0641\u0626\u0629\u060C \u064A\u0634\u0648\u0648\u0646 \u0627\u0644\u0645\u0627\u0631\u0634\u0645\u064A\u0644\u0648\u060C
      \u0648\u064A\u0634\u0631\u0628\u0648\u0646 \u0627\u0644\u0643\u0627\u0643\u0627\u0648\u060C
      \u0648\u064A\u062A\u0628\u0627\u062F\u0644\u0648\u0646 \u0627\u0644\u0636\u062D\u0643\u0627\u062A.
      \u0623\u0644\u064A\u0633 \u0623\u062E\u0630 \u0627\u0633\u062A\u0631\u0627\u062D\u0629
      \u0643\u0647\u0630\u0647 \u0623\u062D\u064A\u0627\u0646\u064B\u0627 \u0644\u062D\u0638\u0629
      \u0636\u0631\u0648\u0631\u064A\u0629 \u0644\u0644\u0627\u0633\u062A\u0645\u062A\u0627\u0639
      \u0628\u0627\u0644\u062D\u064A\u0627\u0629\u061F"
  - Key: 200115
    En: "Friends gathered in a caf\xE9 filled with the fragrant aroma of coffee.
      They chatted intimately while sharing cappuccino and sweet cake. With good
      friends, even an ordinary afternoon becomes a special memory."
    Ko: "\uD5A5\uAE0B\uD55C \uCEE4\uD53C \uB0C4\uC0C8\uAC00 \uAC00\uB4DD\uD55C \uCE74\uD398\uC5D0
      \uCE5C\uAD6C\uB4E4\uC774 \uBAA8\uC600\uC2B5\uB2C8\uB2E4. \uCE74\uD478\uCE58\uB178\uC640
      \uB2EC\uCF64\uD55C \uCF00\uC774\uD06C\uB97C \uB098\uB204\uBA70 \uB3C4\uB780\uB3C4\uB780
      \uC774\uC57C\uAE30\uB97C \uB098\uB215\uB2C8\uB2E4. \uC88B\uC740 \uCE5C\uAD6C\uC640
      \uD568\uAED8\uB77C\uBA74 \uD3C9\uBC94\uD55C \uC624\uD6C4\uB3C4 \uD2B9\uBCC4\uD55C
      \uCD94\uC5B5\uC774 \uB429\uB2C8\uB2E4."
    Ja: "\u9999\u308A\u8C4A\u304B\u306A\u30B3\u30FC\u30D2\u30FC\u306E\u9999\u308A\u304C\u3044\u3063\u3071\u3044\u306E\u30AB\u30D5\u30A7\u306B\u53CB\u9054\u304C\u96C6\u307E\u308A\u307E\u3057\u305F\u3002\u30AB\u30D7\u30C1\u30FC\u30CE\u3068\u7518\u3044\u30B1\u30FC\u30AD\u3092\u5206\u3051\u3001\u30C9\u30E9\u30F3\u30C9\u30E9\u30F3\u3068\u3044\u3046\u8A71\u3092\u4EA4\u308F\u3057\u307E\u3059\u3002\u826F\u3044\u53CB\u9054\u3068\u3044\u3048\u3070\u3001\u666E\u901A\u306E\u5348\u5F8C\u3082\u7279\u5225\u306A\u601D\u3044\u51FA\u306B\u306A\u308A\u307E\u3059\u3002"
    Zh: "\u670B\u53CB\u4EEC\u805A\u96C6\u5728\u4E00\u5BB6\u5F25\u6F2B\u7740\u5496\u5561\u9999\u6C14\u7684\u5496\u5561\u9986\u91CC\u3002\u4ED6\u4EEC\u4E00\u8FB9\u54C1\u5C1D\u5361\u5E03\u5947\u8BFA\u548C\u751C\u70B9\uFF0C\u4E00\u8FB9\u4EB2\u5207\u5730\u804A\u5929\u3002\u548C\u597D\u670B\u53CB\u5728\u4E00\u8D77\uFF0C\u5373\u4F7F\u662F\u666E\u901A\u7684\u4E0B\u5348\u4E5F\u80FD\u6210\u4E3A\u4E00\u6BB5\u7F8E\u597D\u7684\u56DE\u5FC6\u3002"
    Vi: "B\u1EA1n b\xE8 t\u1EE5 t\u1EADp trong m\u1ED9t qu\xE1n c\xE0 ph\xEA ng\u1EADp
      tr\xE0n h\u01B0\u01A1ng th\u01A1m c\xE0 ph\xEA. H\u1ECD tr\xF2 chuy\u1EC7n
      th\xE2n m\u1EADt trong khi c\xF9ng nhau th\u01B0\u1EDFng th\u1EE9c cappuccino
      v\xE0 b\xE1nh ng\u1ECDt. V\u1EDBi nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n t\u1ED1t,
      ngay c\u1EA3 m\u1ED9t bu\u1ED5i chi\u1EC1u b\xECnh th\u01B0\u1EDDng c\u0169ng
      tr\u1EDF th\xE0nh m\u1ED9t k\u1EF7 ni\u1EC7m \u0111\u1EB7c bi\u1EC7t."
    Hi: "\u0915\u0949\u092B\u0940 \u0915\u0940 \u092E\u0928\u092E\u094B\u0939\u0915
      \u0916\u0941\u0936\u092C\u0942 \u0938\u0947 \u092E\u0939\u0915\u0924\u0947
      \u090F\u0915 \u0915\u0948\u092B\u0947 \u092E\u0947\u0902 \u0926\u094B\u0938\u094D\u0924
      \u0907\u0915\u091F\u094D\u0920\u093E \u0939\u0941\u090F\u0964 \u0909\u0928\u094D\u0939\u094B\u0902\u0928\u0947
      \u0915\u0948\u092A\u0941\u091A\u0940\u0928\u094B \u0914\u0930 \u092E\u0940\u0920\u093E
      \u0915\u0947\u0915 \u0916\u093E\u0924\u0947 \u0939\u0941\u090F \u0906\u092A\u0938
      \u092E\u0947\u0902 \u0926\u093F\u0932 \u0916\u094B\u0932\u0915\u0930 \u092C\u093E\u0924\u0947\u0902
      \u0915\u0940\u0902\u0964 \u0905\u091A\u094D\u091B\u0947 \u0926\u094B\u0938\u094D\u0924\u094B\u0902
      \u0915\u0947 \u0938\u093E\u0925, \u090F\u0915 \u0938\u093E\u0927\u093E\u0930\u0923
      \u0926\u094B\u092A\u0939\u0930 \u092D\u0940 \u092F\u093E\u0926\u0917\u093E\u0930
      \u092C\u0928 \u091C\u093E\u0924\u0940 \u0939\u0948\u0964"
    Ar: "\u062A\u062C\u0645\u0651\u0639 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0641\u064A \u0645\u0642\u0647\u0649 \u062A\u0641\u0648\u062D \u0645\u0646\u0647
      \u0631\u0627\u0626\u062D\u0629 \u0627\u0644\u0642\u0647\u0648\u0629 \u0627\u0644\u0639\u0637\u0631\u0629.
      \u062A\u0628\u0627\u062F\u0644\u0648\u0627 \u0623\u0637\u0631\u0627\u0641 \u0627\u0644\u062D\u062F\u064A\u062B
      \u0628\u0648\u062F\u064D\u0651 \u0648\u0647\u0645 \u064A\u062A\u0646\u0627\u0648\u0644\u0648\u0646
      \u0627\u0644\u0643\u0627\u0628\u062A\u0634\u064A\u0646\u0648 \u0645\u0639 \u0627\u0644\u0643\u0639\u0643
      \u0627\u0644\u0644\u0630\u064A\u0630. \u0645\u0639 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0627\u0644\u0645\u0642\u0631\u0628\u064A\u0646\u060C \u062D\u062A\u0649 \u0623\u0645\u0633\u064A\u0629
      \u0639\u0627\u062F\u064A\u0629 \u062A\u062A\u062D\u0648\u0651\u0644 \u0625\u0644\u0649
      \u0630\u0643\u0631\u0649 \u0645\u0645\u064A\u0632\u0629."
  - Key: 200116
    En: On a spring day with pink cherry blossoms fluttering in the breeze, animal
      friends enjoy a picnic on a hill bathed in the sunset. They capture this moment
      with a camera, recording their happiness. It is a day to fully savor the short
      but beautiful spring.
    Ko: "\uBD84\uD64D\uBE5B \uBC9A\uAF43\uC774 \uD769\uB0A0\uB9AC\uB294 \uBD04\uB0A0,
      \uB3D9\uBB3C \uCE5C\uAD6C\uB4E4\uC774 \uB178\uC744 \uC9C4 \uC5B8\uB355\uC5D0\uC11C
      \uD53C\uD06C\uB2C9\uC744 \uC990\uAE41\uB2C8\uB2E4. \uCE74\uBA54\uB77C\uB85C
      \uC774 \uC21C\uAC04\uC744 \uB2F4\uC73C\uBA70 \uD589\uBCF5\uC744 \uAE30\uB85D\uD569\uB2C8\uB2E4.
      \uC9E7\uC9C0\uB9CC \uC544\uB984\uB2E4\uC6B4 \uBD04\uC744 \uB9C8\uC74C\uAECF
      \uB9CC\uB07D\uD558\uB294 \uD558\uB8E8\uC785\uB2C8\uB2E4."
    Ja: "\u30D4\u30F3\u30AF\u306E\u685C\u304C\u6563\u308B\u6625\u306E\u65E5\u3001\u52D5\u7269\u306E\u53CB\u9054\u304C\u904A\u3093\u3060\u4E18\u3067\u30D4\u30AF\u30CB\u30C3\u30AF\u3092\u697D\u3057\u3093\u3067\u3044\u307E\u3059\u3002\u30AB\u30E1\u30E9\u306B\u3053\u306E\u77AC\u9593\u3092\u76DB\u308A\u8FBC\u3093\u3067\u5E78\u305B\u3092\u8A18\u9332\u3057\u307E\u3059\u3002\u77ED\u3044\u304C\u7F8E\u3057\u3044\u6625\u3092\u5B58\u5206\u306B\u6E80\u55AB\u3059\u308B\u4E00\u65E5\u3067\u3059\u3002"
    Zh: "\u5728\u4E00\u4E2A\u6625\u5149\u660E\u5A9A\u7684\u65E5\u5B50\u91CC\uFF0C\u7C89\u8272\u7684\u6A31\u82B1\u5728\u5FAE\u98CE\u4E2D\u6447\u66F3\uFF0C\u4E00\u7FA4\u52A8\u7269\u670B\u53CB\u5728\u5915\u9633\u897F\u4E0B\u7684\u5C71\u5761\u4E0A\u4EAB\u53D7\u7740\u91CE\u9910\u3002\u5B83\u4EEC\u7528\u76F8\u673A\u8BB0\u5F55\u4E0B\u8FD9\u7F8E\u597D\u7684\u77AC\u95F4\uFF0C\u8BB0\u5F55\u4E0B\u5F7C\u6B64\u7684\u5FEB\u4E50\u3002\u8FD9\u662F\u4E00\u4E2A\u503C\u5F97\u597D\u597D\u4EAB\u53D7\u77ED\u6682\u800C\u7F8E\u597D\u6625\u5929\u7684\u65E5\u5B50\u3002"
    Vi: "V\xE0o m\u1ED9t ng\xE0y xu\xE2n, khi nh\u1EEFng c\xE1nh hoa anh \u0111\xE0o
      m\xE0u h\u1ED3ng kh\u1EBD lay \u0111\u1ED9ng trong gi\xF3, nh\u1EEFng ng\u01B0\u1EDDi
      b\u1EA1n \u0111\u1ED9ng v\u1EADt c\xF9ng nhau t\u1EADn h\u01B0\u1EDFng m\u1ED9t
      bu\u1ED5i d\xE3 ngo\u1EA1i tr\xEAn ng\u1ECDn \u0111\u1ED3i ng\u1EADp tr\xE0n
      \xE1nh ho\xE0ng h\xF4n. Ch\xFAng ghi l\u1EA1i kho\u1EA3nh kh\u1EAFc n\xE0y
      b\u1EB1ng m\xE1y \u1EA3nh, l\u01B0u gi\u1EEF ni\u1EC1m h\u1EA1nh ph\xFAc c\u1EE7a
      m\xECnh. \u0110\xF3 l\xE0 m\u1ED9t ng\xE0y \u0111\u1EC3 t\u1EADn h\u01B0\u1EDFng
      tr\u1ECDn v\u1EB9n m\xF9a xu\xE2n ng\u1EAFn ng\u1EE7i nh\u01B0ng t\u01B0\u01A1i
      \u0111\u1EB9p."
    Hi: "\u0935\u0938\u0902\u0924 \u090B\u0924\u0941 \u0915\u0947 \u090F\u0915 \u0938\u0941\u0939\u093E\u0935\u0928\u0947
      \u0926\u093F\u0928, \u091C\u092C \u0917\u0941\u0932\u093E\u092C\u0940 \u091A\u0947\u0930\u0940
      \u0915\u0947 \u092B\u0942\u0932 \u0939\u0935\u093E \u092E\u0947\u0902 \u0932\u0939\u0930\u093E
      \u0930\u0939\u0947 \u0925\u0947, \u0924\u094B \u0909\u0928\u0915\u0947 \u092A\u094D\u092F\u093E\u0930\u0947
      \u091C\u093E\u0928\u0935\u0930 \u0938\u0942\u0930\u094D\u092F\u093E\u0938\u094D\u0924
      \u0915\u0947 \u092A\u094D\u0930\u0915\u093E\u0936 \u092E\u0947\u0902 \u0928\u0939\u093E\u090F
      \u090F\u0915 \u092A\u0939\u093E\u0921\u093C\u0940 \u092A\u0930 \u092A\u093F\u0915\u0928\u093F\u0915
      \u0915\u093E \u0906\u0928\u0902\u0926 \u0932\u0947 \u0930\u0939\u0947 \u0925\u0947\u0964
      \u0909\u0928\u094D\u0939\u094B\u0902\u0928\u0947 \u0907\u0938 \u092A\u0932
      \u0915\u094B \u0915\u0948\u092E\u0930\u0947 \u092E\u0947\u0902 \u0915\u0948\u0926
      \u0915\u093F\u092F\u093E, \u0905\u092A\u0928\u0940 \u0916\u0941\u0936\u0940
      \u0915\u094B \u0930\u093F\u0915\u0949\u0930\u094D\u0921 \u0915\u093F\u092F\u093E\u0964
      \u092F\u0939 \u0935\u0938\u0902\u0924 \u090B\u0924\u0941 \u0915\u0947 \u091B\u094B\u091F\u0947
      \u0932\u0947\u0915\u093F\u0928 \u0916\u0942\u092C\u0938\u0942\u0930\u0924 \u092E\u094C\u0938\u092E
      \u0915\u093E \u092D\u0930\u092A\u0942\u0930 \u0906\u0928\u0902\u0926 \u0932\u0947\u0928\u0947
      \u0915\u093E \u0926\u093F\u0928 \u0925\u093E\u0964"
    Ar: "\u0641\u064A \u064A\u0648\u0645 \u0631\u0628\u064A\u0639\u064A \u062A\u062A\u0631\u0627\u0642\u0635
      \u0641\u064A\u0647 \u0623\u0632\u0647\u0627\u0631 \u0627\u0644\u0643\u0631\u0632
      \u0627\u0644\u0648\u0631\u062F\u064A\u0629 \u0645\u0639 \u0627\u0644\u0646\u0633\u064A\u0645\u060C
      \u062A\u0633\u062A\u0645\u062A\u0639 \u0645\u062C\u0645\u0648\u0639\u0629 \u0645\u0646
      \u0627\u0644\u062D\u064A\u0648\u0627\u0646\u0627\u062A \u0628\u0646\u0632\u0647\u0629
      \u0639\u0644\u0649 \u062A\u0644\u0629 \u062A\u063A\u0645\u0631\u0647\u0627
      \u0623\u0634\u0639\u0629 \u0627\u0644\u0634\u0645\u0633 \u0639\u0646\u062F
      \u0627\u0644\u063A\u0631\u0648\u0628. \u064A\u0648\u062B\u0642\u0648\u0646
      \u0647\u0630\u0647 \u0627\u0644\u0644\u062D\u0638\u0629 \u0628\u0639\u062F\u0633\u0629
      \u0643\u0627\u0645\u064A\u0631\u0627\u062A\u0647\u0645\u060C \u0645\u0633\u062C\u0644\u064A\u0646
      \u0633\u0639\u0627\u062F\u062A\u0647\u0645. \u0625\u0646\u0647 \u064A\u0648\u0645
      \u0645\u062B\u0627\u0644\u064A \u0644\u0644\u0627\u0633\u062A\u0645\u062A\u0627\u0639
      \u0627\u0644\u0643\u0627\u0645\u0644 \u0628\u062C\u0645\u0627\u0644 \u0627\u0644\u0631\u0628\u064A\u0639
      \u0627\u0644\u0642\u0635\u064A\u0631."
  - Key: 200117
    En: Against the backdrop of a magnificent mountain range, friends energetically
      climb the mountain. Leaning on hiking sticks, they advance toward the summit
      one step at a time. Together, even a steep path becomes an enjoyable adventure.
    Ko: "\uC6C5\uC7A5\uD55C \uC0B0\uB9E5\uC744 \uBC30\uACBD\uC73C\uB85C \uCE5C\uAD6C\uB4E4\uC774
      \uD798\uCC28\uAC8C \uC0B0\uC744 \uC624\uB985\uB2C8\uB2E4. \uB4F1\uC0B0 \uC2A4\uD2F1\uC744
      \uC9DA\uACE0 \uD55C \uAC78\uC74C\uC529 \uC815\uC0C1\uC744 \uD5A5\uD574 \uB098\uC544\uAC11\uB2C8\uB2E4.
      \uD568\uAED8\uB77C\uBA74 \uAC00\uD30C\uB978 \uAE38\uB3C4 \uC990\uAC70\uC6B4
      \uBAA8\uD5D8\uC774 \uB429\uB2C8\uB2E4."
    Ja: "\u58EE\u5927\u306A\u5C71\u8108\u3092\u80CC\u666F\u306B\u3001\u53CB\u9054\u304C\u529B\u5F37\u304F\u5C71\u3092\u767B\u308A\u307E\u3059\u3002\u767B\u5C71\u30B9\u30C6\u30A3\u30C3\u30AF\u3092\u3064\u304B\u307F\u3001\u4E00\u6B69\u305A\u3064\u9802\u4E0A\u306B\u9032\u307F\u307E\u3059\u3002\u4E00\u7DD2\u306A\u3089\u6025\u306A\u9053\u3082\u697D\u3057\u3044\u5192\u967A\u306B\u306A\u308A\u307E\u3059\u3002"
    Zh: "\u5728\u96C4\u4F1F\u5C71\u8109\u7684\u6620\u886C\u4E0B\uFF0C\u670B\u53CB\u4EEC\u7CBE\u795E\u6296\u64DE\u5730\u6500\u767B\u7740\u5C71\u5CF0\u3002\u4ED6\u4EEC\u62C4\u7740\u767B\u5C71\u6756\uFF0C\u4E00\u6B65\u4E00\u4E2A\u811A\u5370\u5730\u5411\u5C71\u9876\u8FDB\u53D1\u3002\u5728\u4E00\u8D77\uFF0C\u5373\u4F7F\u662F\u9661\u5CED\u7684\u5C71\u8DEF\u4E5F\u53D8\u6210\u4E86\u4E00\u6B21\u6109\u5FEB\u7684\u5192\u9669\u3002"
    Vi: "Tr\u01B0\u1EDBc khung c\u1EA3nh h\xF9ng v\u0129 c\u1EE7a d\xE3y n\xFAi,
      nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n h\u0103ng h\xE1i leo n\xFAi. D\u1EF1a v\xE0o
      g\u1EADy leo n\xFAi, h\u1ECD ti\u1EBFn t\u1EEBng b\u01B0\u1EDBc m\u1ED9t v\u1EC1
      ph\xEDa \u0111\u1EC9nh n\xFAi. C\xF9ng nhau, ngay c\u1EA3 con \u0111\u01B0\u1EDDng
      d\u1ED1c c\u0169ng tr\u1EDF th\xE0nh m\u1ED9t cu\u1ED9c phi\xEAu l\u01B0u th\xFA
      v\u1ECB."
    Hi: "\u092D\u0935\u094D\u092F \u092A\u0930\u094D\u0935\u0924 \u0936\u094D\u0930\u0943\u0902\u0916\u0932\u093E
      \u0915\u0940 \u092A\u0943\u0937\u094D\u0920\u092D\u0942\u092E\u093F \u092E\u0947\u0902,
      \u0926\u094B\u0938\u094D\u0924 \u091C\u094B\u0936 \u0938\u0947 \u092A\u0939\u093E\u0921\u093C
      \u092A\u0930 \u091A\u0922\u093C\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u094D\u091F\u093F\u0915
      \u0915\u093E \u0938\u0939\u093E\u0930\u093E \u0932\u0947\u0924\u0947 \u0939\u0941\u090F,
      \u0935\u0947 \u090F\u0915-\u090F\u0915 \u0915\u0926\u092E \u092C\u0922\u093C\u093E\u0924\u0947
      \u0939\u0941\u090F \u0936\u093F\u0916\u0930 \u0915\u0940 \u0913\u0930 \u092C\u0922\u093C\u0924\u0947
      \u0939\u0948\u0902\u0964 \u0938\u093E\u0925 \u092E\u093F\u0932\u0915\u0930,
      \u090F\u0915 \u0915\u0920\u093F\u0928 \u0930\u093E\u0938\u094D\u0924\u093E
      \u092D\u0940 \u090F\u0915 \u0906\u0928\u0902\u0926\u0926\u093E\u092F\u0915
      \u0930\u094B\u092E\u093E\u0902\u091A \u092C\u0928 \u091C\u093E\u0924\u093E
      \u0939\u0948\u0964"
    Ar: "\u0639\u0644\u0649 \u062E\u0644\u0641\u064A\u0629 \u0633\u0644\u0633\u0644\u0629
      \u062C\u0628\u0627\u0644 \u0645\u0647\u064A\u0628\u0629\u060C \u064A\u062A\u0633\u0644\u0642
      \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621 \u0627\u0644\u062C\u0628\u0644
      \u0628\u062D\u0645\u0627\u0633. \u0645\u062A\u0643\u0626\u064A\u0646 \u0639\u0644\u0649
      \u0639\u0635\u064A \u0627\u0644\u0645\u0634\u064A\u060C \u064A\u062A\u0642\u062F\u0645\u0648\u0646
      \u0646\u062D\u0648 \u0627\u0644\u0642\u0645\u0629 \u062E\u0637\u0648\u0629
      \u0628\u062E\u0637\u0648\u0629. \u0645\u0639\u064B\u0627\u060C \u062D\u062A\u0649
      \u0627\u0644\u0645\u0633\u0627\u0631 \u0634\u062F\u064A\u062F \u0627\u0644\u0627\u0646\u062D\u062F\u0627\u0631
      \u064A\u062A\u062D\u0648\u0644 \u0625\u0644\u0649 \u0645\u063A\u0627\u0645\u0631\u0629
      \u0645\u0645\u062A\u0639\u0629."
  - Key: 200118
    En: On a sweltering summer day, I take a bite of a cool watermelon while enjoying
      the breeze from a fan. With just one bite of the red, sweet watermelon, the
      heat vanishes completely. It is a simple yet most summery moment of happiness.
    Ko: "\uBB34\uB354\uC6B4 \uC5EC\uB984, \uC120\uD48D\uAE30 \uBC14\uB78C\uC744 \uC42C\uBA70
      \uC2DC\uC6D0\uD55C \uC218\uBC15\uC744 \uBCA0\uC5B4 \uBB45\uB2C8\uB2E4. \uBE68\uAC1B\uACE0
      \uB2EC\uCF64\uD55C \uC218\uBC15 \uD55C \uC785\uC5D0 \uB354\uC704\uAC00 \uC2F9
      \uAC00\uC2ED\uB2C8\uB2E4. \uC18C\uBC15\uD558\uC9C0\uB9CC \uAC00\uC7A5 \uC5EC\uB984\uB2E4\uC6B4
      \uD589\uBCF5\uC758 \uC21C\uAC04\uC785\uB2C8\uB2E4."
    Ja: "\u6691\u3044\u590F\u3001\u6247\u98A8\u6A5F\u306E\u98A8\u3092\u6D74\u3073\u3066\u6DBC\u3057\u3044\u30B9\u30A4\u30AB\u3092\u65AC\u308A\u307E\u3059\u3002\u8D64\u304F\u3066\u7518\u3044\u30B9\u30A4\u30AB\u306E\u53E3\u306B\u71B1\u304C\u82BD\u751F\u3048\u3066\u3044\u307E\u3059\u3002\u7D20\u6734\u3067\u3059\u304C\u3001\u6700\u3082\u590F\u3089\u3057\u3044\u5E78\u798F\u306E\u77AC\u9593\u3067\u3059\u3002"
    Zh: "\u5728\u4E00\u4E2A\u9177\u70ED\u7684\u590F\u65E5\uFF0C\u6211\u4E00\u8FB9\u4EAB\u53D7\u7740\u98CE\u6247\u5439\u6765\u7684\u5FAE\u98CE\uFF0C\u4E00\u8FB9\u54AC\u4E86\u4E00\u53E3\u6E05\u51C9\u7684\u897F\u74DC\u3002\u4E00\u53E3\u54AC\u4E0B\u53BB\uFF0C\u7EA2\u5F64\u5F64\u3001\u9999\u751C\u53EF\u53E3\u7684\u897F\u74DC\u77AC\u95F4\u9A71\u6563\u4E86\u6240\u6709\u7684\u6691\u6C14\u3002\u8FD9\u662F\u6700\u7B80\u5355\u5374\u4E5F\u6700\u80FD\u4EE3\u8868\u590F\u65E5\u5E78\u798F\u7684\u65F6\u523B\u3002"
    Vi: "V\xE0o m\u1ED9t ng\xE0y h\xE8 oi b\u1EE9c, t\xF4i c\u1EAFn m\u1ED9t mi\u1EBFng
      d\u01B0a h\u1EA5u m\xE1t l\u1EA1nh trong khi t\u1EADn h\u01B0\u1EDFng l\xE0n
      gi\xF3 m\xE1t t\u1EEB chi\u1EBFc qu\u1EA1t. Ch\u1EC9 c\u1EA7n m\u1ED9t mi\u1EBFng
      d\u01B0a h\u1EA5u \u0111\u1ECF ng\u1ECDt ng\xE0o, c\xE1i n\xF3ng d\u01B0\u1EDDng
      nh\u01B0 tan bi\u1EBFn ho\xE0n to\xE0n. \u0110\xF3 l\xE0 m\u1ED9t kho\u1EA3nh
      kh\u1EAFc h\u1EA1nh ph\xFAc gi\u1EA3n d\u1ECB nh\u01B0ng \u0111\u1EADm ch\u1EA5t
      m\xF9a h\xE8."
    Hi: "\u0917\u0930\u094D\u092E\u0940 \u0915\u0947 \u0909\u092E\u0938 \u092D\u0930\u0947
      \u0926\u093F\u0928 \u092E\u0947\u0902, \u092E\u0948\u0902 \u092A\u0902\u0916\u0947
      \u0915\u0940 \u0920\u0902\u0921\u0940 \u0939\u0935\u093E \u0915\u093E \u0906\u0928\u0902\u0926
      \u0932\u0947\u0924\u0947 \u0939\u0941\u090F \u0920\u0902\u0921\u0947 \u0924\u0930\u092C\u0942\u091C
      \u0915\u093E \u090F\u0915 \u091F\u0941\u0915\u0921\u093C\u093E \u0916\u093E\u0924\u0940
      \u0939\u0942\u0901\u0964 \u0932\u093E\u0932, \u092E\u0940\u0920\u0947 \u0924\u0930\u092C\u0942\u091C
      \u0915\u093E \u090F\u0915 \u091F\u0941\u0915\u0921\u093C\u093E \u0916\u093E\u0924\u0947
      \u0939\u0940 \u0917\u0930\u094D\u092E\u0940 \u092A\u0942\u0930\u0940 \u0924\u0930\u0939
      \u0917\u093E\u092F\u092C \u0939\u094B \u091C\u093E\u0924\u0940 \u0939\u0948\u0964
      \u092F\u0939 \u090F\u0915 \u0938\u0930\u0932 \u0932\u0947\u0915\u093F\u0928
      \u0917\u0930\u094D\u092E\u093F\u092F\u094B\u0902 \u0915\u093E \u0938\u092C\u0938\u0947
      \u0938\u0941\u0916\u0926 \u092A\u0932 \u0939\u0948\u0964"
    Ar: "\u0641\u064A \u064A\u0648\u0645 \u0635\u064A\u0641\u064A \u0642\u0627\u0626\u0638\u060C
      \u0623\u062A\u0646\u0627\u0648\u0644 \u0642\u0636\u0645\u0629 \u0645\u0646
      \u0628\u0637\u064A\u062E\u0629 \u0628\u0627\u0631\u062F\u0629 \u0628\u064A\u0646\u0645\u0627
      \u0623\u0633\u062A\u0645\u062A\u0639 \u0628\u0646\u0633\u064A\u0645 \u0627\u0644\u0645\u0631\u0648\u062D\u0629.
      \u0628\u0645\u062C\u0631\u062F \u0642\u0636\u0645\u0629 \u0648\u0627\u062D\u062F\u0629
      \u0645\u0646 \u0627\u0644\u0628\u0637\u064A\u062E\u0629 \u0627\u0644\u062D\u0645\u0631\u0627\u0621
      \u0627\u0644\u062D\u0644\u0648\u0629\u060C \u064A\u062E\u062A\u0641\u064A \u0627\u0644\u062D\u0631
      \u062A\u0645\u0627\u0645\u064B\u0627. \u0625\u0646\u0647\u0627 \u0644\u062D\u0638\u0629
      \u0628\u0633\u064A\u0637\u0629 \u0644\u0643\u0646\u0647\u0627 \u0641\u064A
      \u063A\u0627\u064A\u0629 \u0627\u0644\u0633\u0639\u0627\u062F\u0629\u060C \u062A\u064F\u062C\u0633\u0651\u062F
      \u0631\u0648\u062D \u0627\u0644\u0635\u064A\u0641."
  - Key: 200119
    En: On a night when stars are falling, friends have gathered around a bonfire.
      Twinkling lights and the blazing flames create a warm atmosphere. As the night
      deepens, their quiet conversations continue endlessly.
    Ko: "\uBCC4\uC774 \uC3DF\uC544\uC9C0\uB294 \uBC24, \uCE5C\uAD6C\uB4E4\uC774 \uBAA8\uB2E5\uBD88
      \uC8FC\uC704\uC5D0 \uBAA8\uC5EC \uC549\uC558\uC2B5\uB2C8\uB2E4. \uBC18\uC9DD\uC774\uB294
      \uC804\uAD6C \uC7A5\uC2DD\uACFC \uD0C0\uC624\uB974\uB294 \uBD88\uAF43\uC774
      \uB530\uB73B\uD55C \uBD84\uC704\uAE30\uB97C \uC790\uC544\uB0C5\uB2C8\uB2E4.
      \uAE4A\uC5B4\uAC00\uB294 \uBC24, \uB3C4\uB780\uB3C4\uB780 \uB098\uB204\uB294
      \uC774\uC57C\uAE30\uAC00 \uB05D\uC5C6\uC774 \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
    Ja: "\u661F\u304C\u964D\u308A\u6CE8\u3050\u591C\u3001\u53CB\u9054\u304C\u711A\u304D\u706B\u306E\u5468\u308A\u306B\u96C6\u307E\u3063\u3066\u5EA7\u308A\u307E\u3057\u305F\u3002\u8F1D\u304F\u96FB\u7403\u306E\u88C5\u98FE\u3068\u71C3\u3048\u308B\u708E\u304C\u6696\u304B\u3044\u96F0\u56F2\u6C17\u3092\u91B8\u3057\u51FA\u3057\u307E\u3059\u3002\u6DF1\u304F\u884C\u304F\u591C\u3001\u30C9\u30E9\u30F3\u30C9\u30E9\u30F3\u3068\u5206\u304B\u3061\u5408\u3046\u7269\u8A9E\u304C\u7121\u9650\u306B\u7D9A\u304D\u307E\u3059\u3002"
    Zh: "\u5728\u4E00\u4E2A\u7E41\u661F\u98D8\u843D\u7684\u591C\u665A\uFF0C\u670B\u53CB\u4EEC\u56F4\u5750\u5728\u7BDD\u706B\u65C1\u3002\u95EA\u70C1\u7684\u706F\u5149\u548C\u718A\u718A\u71C3\u70E7\u7684\u706B\u7130\u8425\u9020\u51FA\u6E29\u99A8\u7684\u6C1B\u56F4\u3002\u591C\u8272\u6E10\u6DF1\uFF0C\u4ED6\u4EEC\u7684\u8F7B\u58F0\u4EA4\u8C08\u6301\u7EED\u4E0D\u65AD\u3002"
    Vi: "V\xE0o m\u1ED9t \u0111\xEAm sao b\u0103ng, b\u1EA1n b\xE8 qu\xE2y qu\u1EA7n
      b\xEAn \u0111\u1ED1ng l\u1EEDa. \xC1nh \u0111\xE8n l\u1EA5p l\xE1nh v\xE0 ng\u1ECDn
      l\u1EEDa b\u1EADp b\xF9ng t\u1EA1o n\xEAn m\u1ED9t b\u1EA7u kh\xF4ng kh\xED
      \u1EA5m \xE1p. Khi m\xE0n \u0111\xEAm bu\xF4ng xu\u1ED1ng, nh\u1EEFng cu\u1ED9c
      tr\xF2 chuy\u1EC7n nh\u1ECF nh\u1EB9 c\u1EE7a h\u1ECD c\u1EE9 th\u1EBF ti\u1EBFp
      di\u1EC5n kh\xF4ng d\u1EE9t."
    Hi: "\u090F\u0915 \u0910\u0938\u0940 \u0930\u093E\u0924 \u092E\u0947\u0902 \u091C\u092C
      \u0924\u093E\u0930\u0947 \u091F\u0942\u091F \u0930\u0939\u0947 \u0939\u0948\u0902,
      \u0926\u094B\u0938\u094D\u0924 \u0905\u0932\u093E\u0935 \u0915\u0947 \u091A\u093E\u0930\u094B\u0902
      \u0913\u0930 \u0907\u0915\u091F\u094D\u0920\u093E \u0939\u0941\u090F \u0939\u0948\u0902\u0964
      \u091F\u093F\u092E\u091F\u093F\u092E\u093E\u0924\u0940 \u0930\u094B\u0936\u0928\u0940
      \u0914\u0930 \u0927\u0927\u0915\u0924\u0940 \u0932\u092A\u091F\u0947\u0902
      \u090F\u0915 \u0916\u0941\u0936\u0928\u0941\u092E\u093E \u092E\u093E\u0939\u094C\u0932
      \u092C\u0928\u093E \u0930\u0939\u0940 \u0939\u0948\u0902\u0964 \u091C\u0948\u0938\u0947-\u091C\u0948\u0938\u0947
      \u0930\u093E\u0924 \u0917\u0939\u0930\u0940 \u0939\u094B\u0924\u0940 \u091C\u093E\u0924\u0940
      \u0939\u0948, \u0909\u0928\u0915\u0940 \u0936\u093E\u0902\u0924 \u092C\u093E\u0924\u091A\u0940\u0924
      \u0932\u0917\u093E\u0924\u093E\u0930 \u091A\u0932\u0924\u0940 \u0930\u0939\u0924\u0940
      \u0939\u0948\u0964"
    Ar: "\u0641\u064A \u0644\u064A\u0644\u0629 \u062A\u062A\u0633\u0627\u0642\u0637
      \u0641\u064A\u0647\u0627 \u0627\u0644\u0646\u062C\u0648\u0645\u060C \u0627\u062C\u062A\u0645\u0639
      \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621 \u062D\u0648\u0644 \u0646\u0627\u0631
      \u0627\u0644\u0645\u062E\u064A\u0645. \u062A\u062E\u0644\u0642 \u0627\u0644\u0623\u0636\u0648\u0627\u0621
      \u0627\u0644\u0645\u062A\u0644\u0623\u0644\u0626\u0629 \u0648\u0627\u0644\u0644\u0647\u0628
      \u0627\u0644\u0645\u062A\u0623\u062C\u062C \u062C\u0648\u0627\u064B \u062F\u0627\u0641\u0626\u0627\u064B.
      \u0648\u0645\u0639 \u062D\u0644\u0648\u0644 \u0627\u0644\u0644\u064A\u0644\u060C
      \u062A\u0633\u062A\u0645\u0631 \u0623\u062D\u0627\u062F\u064A\u062B\u0647\u0645
      \u0627\u0644\u0647\u0627\u062F\u0626\u0629 \u0628\u0644\u0627 \u0627\u0646\u0642\u0637\u0627\u0639."
  - Key: 200120
    En: I shoulder an oxygen tank and set off on a scuba dive into the deep sea.
      Amidst the colorful fish, I discovered a sparkling treasure chest. It is a
      thrilling adventure presented by the unknown world of the ocean.
    Ko: "\uC0B0\uC18C\uD1B5\uC744 \uBA54\uACE0 \uAE4A\uC740 \uBC14\uB2F7\uC18D\uC73C\uB85C
      \uC2A4\uCFE0\uBC84 \uB2E4\uC774\uBE59\uC744 \uB5A0\uB0A9\uB2C8\uB2E4. \uC54C\uB85D\uB2EC\uB85D\uD55C
      \uBB3C\uACE0\uAE30\uB4E4 \uC0AC\uC774\uB85C \uBC18\uC9DD\uC774\uB294 \uBCF4\uBB3C
      \uC0C1\uC790\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4. \uBBF8\uC9C0\uC758
      \uBC14\uB2E4 \uC138\uACC4\uAC00 \uC120\uC0AC\uD558\uB294 \uC9DC\uB9BF\uD55C
      \uBAA8\uD5D8\uC785\uB2C8\uB2E4."
    Ja: "\u9178\u7D20\u306E\u901A\u3057\u3092\u6DF1\u304F\u6D77\u306E\u4E2D\u306B\u30B9\u30AD\u30E5\u30FC\u30D0\u30C0\u30A4\u30D3\u30F3\u30B0\u3092\u6B8B\u3057\u307E\u3059\u3002\u3068\u3066\u3082\u7518\u3044\u9B5A\u306E\u9593\u3067\u8F1D\u304F\u5B9D\u7BB1\u3092\u898B\u3064\u3051\u307E\u3057\u305F\u3002\u672A\u77E5\u306E\u6D77\u306E\u4E16\u754C\u304C\u30D7\u30EC\u30BC\u30F3\u30C8\u3059\u308B\u723D\u3084\u304B\u306A\u5192\u967A\u3067\u3059\u3002"
    Zh: "\u6211\u80CC\u7740\u6C27\u6C14\u74F6\uFF0C\u6F5C\u5165\u6DF1\u6D77\u3002\u5728\u4E94\u5F69\u6591\u6593\u7684\u9C7C\u7FA4\u4E2D\uFF0C\u6211\u53D1\u73B0\u4E86\u4E00\u4E2A\u95EA\u95EA\u53D1\u5149\u7684\u5B9D\u7BB1\u3002\u8FD9\u662F\u4E00\u573A\u7531\u672A\u77E5\u7684\u6D77\u6D0B\u4E16\u754C\u5E26\u6765\u7684\u60CA\u9669\u523A\u6FC0\u7684\u5192\u9669\u3002"
    Vi: "T\xF4i \u0111eo b\xECnh d\u01B0\u1EE1ng kh\xED v\xE0 b\u1EAFt \u0111\u1EA7u
      l\u1EB7n xu\u1ED1ng bi\u1EC3n s\xE2u. Gi\u1EEFa nh\u1EEFng \u0111\xE0n c\xE1
      \u0111\u1EA7y m\xE0u s\u1EAFc, t\xF4i ph\xE1t hi\u1EC7n ra m\u1ED9t r\u01B0\u01A1ng
      kho b\xE1u l\u1EA5p l\xE1nh. \u0110\xF3 l\xE0 m\u1ED9t cu\u1ED9c phi\xEAu l\u01B0u
      ly k\u1EF3 do th\u1EBF gi\u1EDBi b\xED \u1EA9n c\u1EE7a \u0111\u1EA1i d\u01B0\u01A1ng
      mang l\u1EA1i."
    Hi: "\u092E\u0948\u0902\u0928\u0947 \u0911\u0915\u094D\u0938\u0940\u091C\u0928
      \u091F\u0948\u0902\u0915 \u0915\u0902\u0927\u0947 \u092A\u0930 \u0909\u0920\u093E\u092F\u093E
      \u0914\u0930 \u0917\u0939\u0930\u0947 \u0938\u092E\u0941\u0926\u094D\u0930
      \u092E\u0947\u0902 \u0938\u094D\u0915\u0942\u092C\u093E \u0921\u093E\u0907\u0935\u093F\u0902\u0917
      \u0915\u0947 \u0932\u093F\u090F \u0928\u093F\u0915\u0932 \u092A\u0921\u093C\u093E\u0964
      \u0930\u0902\u0917-\u092C\u093F\u0930\u0902\u0917\u0940 \u092E\u091B\u0932\u093F\u092F\u094B\u0902
      \u0915\u0947 \u092C\u0940\u091A \u092E\u0941\u091D\u0947 \u090F\u0915 \u091A\u092E\u0915\u0924\u093E
      \u0939\u0941\u0906 \u0916\u091C\u093E\u0928\u093E \u092E\u093F\u0932\u093E\u0964
      \u092F\u0939 \u0938\u092E\u0941\u0926\u094D\u0930 \u0915\u0940 \u0905\u091C\u094D\u091E\u093E\u0924
      \u0926\u0941\u0928\u093F\u092F\u093E \u0926\u094D\u0935\u093E\u0930\u093E \u092A\u094D\u0930\u0938\u094D\u0924\u0941\u0924
      \u090F\u0915 \u0930\u094B\u092E\u093E\u0902\u091A\u0915\u093E\u0930\u0940 \u0938\u093E\u0939\u0938\u093F\u0915
      \u092F\u093E\u0924\u094D\u0930\u093E \u0939\u0948\u0964"
    Ar: "\u0623\u062D\u0645\u0644 \u0623\u0633\u0637\u0648\u0627\u0646\u0629 \u0627\u0644\u0623\u0643\u0633\u062C\u064A\u0646
      \u0639\u0644\u0649 \u0643\u062A\u0641\u064A \u0648\u0623\u0628\u062F\u0623
      \u063A\u0648\u0635\u064B\u0627 \u0641\u064A \u0623\u0639\u0645\u0627\u0642
      \u0627\u0644\u0628\u062D\u0631. \u0648\u0633\u0637 \u0627\u0644\u0623\u0633\u0645\u0627\u0643
      \u0627\u0644\u0645\u0644\u0648\u0646\u0629\u060C \u0639\u062B\u0631\u062A \u0639\u0644\u0649
      \u0635\u0646\u062F\u0648\u0642 \u0643\u0646\u0632 \u0645\u062A\u0644\u0623\u0644\u0626.
      \u0625\u0646\u0647\u0627 \u0645\u063A\u0627\u0645\u0631\u0629 \u0645\u062B\u064A\u0631\u0629
      \u064A\u0642\u062F\u0645\u0647\u0627 \u0639\u0627\u0644\u0645 \u0627\u0644\u0645\u062D\u064A\u0637
      \u0627\u0644\u0645\u062C\u0647\u0648\u0644."
  - Key: 200121
    En: Friends wearing chef hats gather in the kitchen to bake cookies. They roll
      out the dough and cut out shapes, carefully preparing the snacks. Homemade
      cookies are sweeter and warmer than anything else.
    Ko: "\uC694\uB9AC\uC0AC \uBAA8\uC790\uB97C \uC4F4 \uCE5C\uAD6C\uB4E4\uC774 \uC8FC\uBC29\uC5D0
      \uBAA8\uC5EC \uCFE0\uD0A4\uB97C \uAD7D\uC2B5\uB2C8\uB2E4. \uBC18\uC8FD\uC744
      \uBC00\uACE0 \uBAA8\uC591\uC744 \uCC0D\uC73C\uBA70 \uC815\uC131\uAECF \uAC04\uC2DD\uC744
      \uB9CC\uB4ED\uB2C8\uB2E4. \uC9C1\uC811 \uB9CC\uB4E0 \uCFE0\uD0A4\uB294 \uADF8
      \uC5B4\uB5A4 \uAC83\uBCF4\uB2E4 \uB2EC\uCF64\uD558\uACE0 \uB530\uB73B\uD569\uB2C8\uB2E4."
    Ja: "\u30B7\u30A7\u30D5\u306E\u5E3D\u5B50\u3092\u304B\u3076\u3063\u305F\u53CB\u4EBA\u304C\u30AD\u30C3\u30C1\u30F3\u306B\u96C6\u307E\u308A\u3001\u30AF\u30C3\u30AD\u30FC\u3092\u713C\u304D\u307E\u3059\u3002\u751F\u5730\u3092\u62BC\u3057\u3066\u5F62\u3092\u3068\u308A\u3001\u4E01\u5BE7\u306B\u304A\u3084\u3064\u3092\u4F5C\u308A\u307E\u3059\u3002\u81EA\u5206\u3067\u4F5C\u3063\u305F\u30AF\u30C3\u30AD\u30FC\u306F\u3069\u3093\u306A\u3082\u306E\u3088\u308A\u3082\u7518\u304F\u3066\u6696\u304B\u3044\u3067\u3059\u3002"
    Zh: "\u670B\u53CB\u4EEC\u6234\u7740\u53A8\u5E08\u5E3D\uFF0C\u805A\u96C6\u5728\u53A8\u623F\u91CC\u70E4\u997C\u5E72\u3002\u4ED6\u4EEC\u64C0\u9762\u56E2\uFF0C\u5207\u51FA\u5404\u79CD\u5F62\u72B6\uFF0C\u7CBE\u5FC3\u51C6\u5907\u7740\u8FD9\u4E9B\u7F8E\u5473\u7684\u70B9\u5FC3\u3002\u81EA\u5236\u997C\u5E72\u6BD4\u5176\u4ED6\u4EFB\u4F55\u4E1C\u897F\u90FD\u66F4\u9999\u751C\u3001\u66F4\u6E29\u6696\u3002"
    Vi: "Nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n \u0111\u1ED9i m\u0169 \u0111\u1EA7u
      b\u1EBFp t\u1EE5 t\u1EADp trong b\u1EBFp \u0111\u1EC3 n\u01B0\u1EDBng b\xE1nh
      quy. H\u1ECD c\xE1n b\u1ED9t v\xE0 c\u1EAFt th\xE0nh c\xE1c h\xECnh d\u1EA1ng,
      c\u1EA9n th\u1EADn chu\u1EA9n b\u1ECB nh\u1EEFng m\xF3n \u0103n v\u1EB7t. B\xE1nh
      quy nh\xE0 l\xE0m ng\u1ECDt ng\xE0o v\xE0 \u1EA5m \xE1p h\u01A1n b\u1EA5t c\u1EE9
      th\u1EE9 g\xEC kh\xE1c."
    Hi: "\u0936\u0947\u092B \u0915\u0940 \u091F\u094B\u092A\u0940 \u092A\u0939\u0928\u0947
      \u0926\u094B\u0938\u094D\u0924 \u0930\u0938\u094B\u0908 \u092E\u0947\u0902
      \u0915\u0941\u0915\u0940\u091C\u093C \u092C\u0928\u093E\u0928\u0947 \u0915\u0947
      \u0932\u093F\u090F \u0907\u0915\u091F\u094D\u0920\u093E \u0939\u094B\u0924\u0947
      \u0939\u0948\u0902\u0964 \u0935\u0947 \u0906\u091F\u0947 \u0915\u094B \u092C\u0947\u0932\u0924\u0947
      \u0939\u0948\u0902 \u0914\u0930 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0906\u0915\u093E\u0930
      \u0915\u093E\u091F\u0924\u0947 \u0939\u0948\u0902, \u092C\u0921\u093C\u0940
      \u0938\u093E\u0935\u0927\u093E\u0928\u0940 \u0938\u0947 \u0907\u0928 \u0915\u0941\u0915\u0940\u091C\u093C
      \u0915\u094B \u0924\u0948\u092F\u093E\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964
      \u0918\u0930 \u0915\u0940 \u092C\u0928\u0940 \u0915\u0941\u0915\u0940\u091C\u093C
      \u0915\u093F\u0938\u0940 \u092D\u0940 \u0926\u0942\u0938\u0930\u0940 \u091A\u0940\u091C\u093C
      \u0938\u0947 \u091C\u093C\u094D\u092F\u093E\u0926\u093E \u092E\u0940\u0920\u0940
      \u0914\u0930 \u0938\u094D\u0935\u093E\u0926\u093F\u0937\u094D\u091F \u0939\u094B\u0924\u0940
      \u0939\u0948\u0902\u0964"
    Ar: "\u064A\u062A\u062C\u0645\u0639 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621\u060C
      \u0648\u0647\u0645 \u064A\u0631\u062A\u062F\u0648\u0646 \u0642\u0628\u0639\u0627\u062A
      \u0627\u0644\u0637\u0647\u0627\u0629\u060C \u0641\u064A \u0627\u0644\u0645\u0637\u0628\u062E
      \u0644\u062E\u0628\u0632 \u0627\u0644\u0628\u0633\u0643\u0648\u064A\u062A.
      \u064A\u0641\u0631\u062F\u0648\u0646 \u0627\u0644\u0639\u062C\u064A\u0646 \u0648\u064A\u0642\u0637\u0639\u0648\u0646\u0647
      \u0625\u0644\u0649 \u0623\u0634\u0643\u0627\u0644\u060C \u0648\u064A\u062C\u0647\u0632\u0648\u0646
      \u0647\u0630\u0647 \u0627\u0644\u0648\u062C\u0628\u0627\u062A \u0627\u0644\u062E\u0641\u064A\u0641\u0629
      \u0628\u0639\u0646\u0627\u064A\u0629. \u0627\u0644\u0628\u0633\u0643\u0648\u064A\u062A
      \u0627\u0644\u0645\u0646\u0632\u0644\u064A \u0623\u0644\u0630 \u0648\u0623\u0634\u0647\u0649
      \u0645\u0646 \u0623\u064A \u0634\u064A\u0621 \u0622\u062E\u0631."
  - Key: 200122
    En: Friends dance joyfully in a space with a vintage atmosphere. Dressed in stylish
      clothes, they surrender their bodies to the rhythm. With music, anyone can
      become the best dancer.
    Ko: "\uBE48\uD2F0\uC9C0\uD55C \uBD84\uC704\uAE30\uC758 \uACF5\uAC04\uC5D0\uC11C
      \uCE5C\uAD6C\uB4E4\uC774 \uD765\uACB9\uAC8C \uCDA4\uC744 \uCDA5\uB2C8\uB2E4.
      \uBA4B\uC9C4 \uC637\uC744 \uCC28\uB824\uC785\uACE0 \uB9AC\uB4EC\uC5D0 \uBAB8\uC744
      \uB9E1\uAE41\uB2C8\uB2E4. \uC74C\uC545\uACFC \uD568\uAED8\uB77C\uBA74 \uB204\uAD6C\uB098
      \uCD5C\uACE0\uC758 \uB304\uC11C\uAC00 \uB429\uB2C8\uB2E4."
    Ja: "\u30D3\u30F3\u30C6\u30FC\u30B8\u306A\u96F0\u56F2\u6C17\u306E\u7A7A\u9593\u3067\u3001\u53CB\u9054\u304C\u9762\u767D\u304F\u8E0A\u308A\u307E\u3059\u3002\u7D20\u6575\u306A\u670D\u3092\u7740\u3066\u30EA\u30BA\u30E0\u306B\u8EAB\u3092\u4EFB\u305B\u307E\u3059\u3002\u97F3\u697D\u3068\u4E00\u7DD2\u306A\u3089\u8AB0\u3067\u3082\u6700\u9AD8\u306E\u30C0\u30F3\u30B5\u30FC\u306B\u306A\u308A\u307E\u3059\u3002"
    Zh: "\u670B\u53CB\u4EEC\u5728\u4E00\u4E2A\u5145\u6EE1\u590D\u53E4\u6C14\u606F\u7684\u7A7A\u95F4\u91CC\u6B22\u5FEB\u5730\u8DF3\u821E\u3002\u4ED6\u4EEC\u8EAB\u7740\u65F6\u5C1A\u670D\u9970\uFF0C\u968F\u7740\u8282\u594F\u5C3D\u60C5\u821E\u52A8\u3002\u6709\u4E86\u97F3\u4E50\uFF0C\u4EBA\u4EBA\u90FD\u80FD\u6210\u4E3A\u6700\u68D2\u7684\u821E\u8005\u3002"
    Vi: "Nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n vui v\u1EBB nh\u1EA3y m\xFAa trong m\u1ED9t
      kh\xF4ng gian mang \u0111\u1EADm phong c\xE1ch c\u1ED5 \u0111i\u1EC3n. Di\u1EC7n
      nh\u1EEFng b\u1ED9 trang ph\u1EE5c s\xE0nh \u0111i\u1EC7u, h\u1ECD th\u1EA3
      l\u1ECFng c\u01A1 th\u1EC3 theo \u0111i\u1EC7u nh\u1EA1c. V\u1EDBi \xE2m nh\u1EA1c,
      b\u1EA5t c\u1EE9 ai c\u0169ng c\xF3 th\u1EC3 tr\u1EDF th\xE0nh v\u0169 c\xF4ng
      gi\u1ECFi nh\u1EA5t."
    Hi: "\u092A\u0941\u0930\u093E\u0928\u0947 \u092E\u093E\u0939\u094C\u0932 \u0935\u093E\u0932\u0947
      \u090F\u0915 \u0938\u094D\u0925\u093E\u0928 \u092A\u0930 \u0926\u094B\u0938\u094D\u0924
      \u0916\u0941\u0936\u0940 \u0938\u0947 \u0928\u093E\u091A \u0930\u0939\u0947
      \u0939\u0948\u0902\u0964 \u0938\u094D\u091F\u093E\u0907\u0932\u093F\u0936 \u0915\u092A\u0921\u093C\u094B\u0902
      \u092E\u0947\u0902 \u0938\u091C\u0947-\u0927\u091C\u0947 \u0935\u0947 \u0938\u0902\u0917\u0940\u0924
      \u0915\u0940 \u0927\u0941\u0928 \u092A\u0930 \u091D\u0942\u092E \u0930\u0939\u0947
      \u0939\u0948\u0902\u0964 \u0938\u0902\u0917\u0940\u0924 \u0915\u0947 \u0938\u093E\u0925
      \u0915\u094B\u0908 \u092D\u0940 \u092C\u0947\u0939\u0924\u0930\u0940\u0928
      \u0928\u0930\u094D\u0924\u0915 \u092C\u0928 \u0938\u0915\u0924\u093E \u0939\u0948\u0964"
    Ar: "\u064A\u0631\u0642\u0635 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0628\u0641\u0631\u062D \u0641\u064A \u0645\u0643\u0627\u0646 \u0630\u064A
      \u0637\u0627\u0628\u0639 \u0643\u0644\u0627\u0633\u064A\u0643\u064A. \u064A\u0631\u062A\u062F\u0648\u0646
      \u0645\u0644\u0627\u0628\u0633 \u0623\u0646\u064A\u0642\u0629\u060C \u0648\u064A\u0633\u062A\u0633\u0644\u0645\u0648\u0646
      \u0644\u0625\u064A\u0642\u0627\u0639 \u0627\u0644\u0645\u0648\u0633\u064A\u0642\u0649.
      \u0645\u0639 \u0627\u0644\u0645\u0648\u0633\u064A\u0642\u0649\u060C \u064A\u0645\u0643\u0646
      \u0644\u0623\u064A \u0634\u062E\u0635 \u0623\u0646 \u064A\u0635\u0628\u062D
      \u0623\u0641\u0636\u0644 \u0631\u0627\u0642\u0635."
  - Key: 200123
    En: Friends pedal their bicycles alongside a clear lake and green mountains.
      They race excitedly along the trail, cutting through the cool breeze. This
      refreshing ride through nature breathes vitality into their bodies.
    Ko: "\uB9D1\uC740 \uD638\uC218\uC640 \uD478\uB978 \uC0B0\uC744 \uB07C\uACE0 \uCE5C\uAD6C\uB4E4\uC774
      \uC790\uC804\uAC70 \uD398\uB2EC\uC744 \uBC1F\uC2B5\uB2C8\uB2E4. \uC2DC\uC6D0\uD55C
      \uBC14\uB78C\uC744 \uAC00\uB974\uBA70 \uD2B8\uB808\uC77C\uC744 \uC2E0\uB098\uAC8C
      \uB2EC\uB9BD\uB2C8\uB2E4. \uC790\uC5F0 \uC18D\uC744 \uB204\uBE44\uB294 \uC0C1\uCF8C\uD55C
      \uB77C\uC774\uB529\uC774 \uD65C\uB825\uC744 \uBD88\uC5B4\uB123\uC2B5\uB2C8\uB2E4."
    Ja: "\u6F84\u3093\u3060\u6E56\u3068\u9752\u3044\u5C71\u3092\u631F\u3093\u3067\u3001\u53CB\u9054\u304C\u81EA\u8EE2\u8ECA\u30DA\u30C0\u30EB\u3092\u8E0F\u307F\u307E\u3059\u3002\u6DBC\u3057\u3044\u98A8\u3092\u5207\u308A\u3001\u30C8\u30EC\u30A4\u30EB\u3092\u697D\u3057\u304F\u8D70\u308A\u307E\u3059\u3002\u81EA\u7136\u306E\u4E2D\u3092\u6B69\u304F\u723D\u3084\u304B\u306A\u30E9\u30A4\u30C7\u30A3\u30F3\u30B0\u304C\u6D3B\u529B\u3092\u5439\u304D\u8FBC\u307F\u307E\u3059\u3002"
    Zh: "\u670B\u53CB\u4EEC\u9A91\u7740\u81EA\u884C\u8F66\uFF0C\u6CBF\u7740\u6E05\u6F88\u7684\u6E56\u6CCA\u548C\u9752\u5C71\u73AF\u7ED5\u7684\u5C0F\u5F84\u98DE\u9A70\u3002\u4ED6\u4EEC\u5174\u594B\u5730\u6CBF\u7740\u5C0F\u5F84\u98DE\u5954\uFF0C\u8FCE\u7740\u51C9\u723D\u7684\u5FAE\u98CE\u3002\u8FD9\u8D9F\u6E05\u65B0\u7684\u81EA\u7136\u4E4B\u65C5\u8BA9\u4ED6\u4EEC\u7CBE\u795E\u7115\u53D1\u3002"
    Vi: "Nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n \u0111\u1EA1p xe d\u1ECDc theo m\u1ED9t
      h\u1ED3 n\u01B0\u1EDBc trong v\u1EAFt v\xE0 nh\u1EEFng ng\u1ECDn n\xFAi xanh
      m\u01B0\u1EDBt. H\u1ECD h\xE0o h\u1EE9ng ph\xF3ng xe tr\xEAn con \u0111\u01B0\u1EDDng
      m\xF2n, x\xE9 to\u1EA1c l\xE0n gi\xF3 m\xE1t. Chuy\u1EBFn \u0111i s\u1EA3ng
      kho\xE1i gi\u1EEFa thi\xEAn nhi\xEAn n\xE0y ti\u1EBFp th\xEAm sinh l\u1EF1c
      cho c\u01A1 th\u1EC3 h\u1ECD."
    Hi: "\u0926\u094B\u0938\u094D\u0924 \u090F\u0915 \u0938\u093E\u092B \u091D\u0940\u0932
      \u0914\u0930 \u0939\u0930\u0947-\u092D\u0930\u0947 \u092A\u0939\u093E\u0921\u093C\u094B\u0902
      \u0915\u0947 \u0915\u093F\u0928\u093E\u0930\u0947 \u0938\u093E\u0907\u0915\u093F\u0932
      \u091A\u0932\u093E \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0935\u0947
      \u0920\u0902\u0921\u0940 \u0939\u0935\u093E \u0915\u093E \u0906\u0928\u0902\u0926
      \u0932\u0947\u0924\u0947 \u0939\u0941\u090F \u0909\u0924\u094D\u0938\u093E\u0939
      \u0938\u0947 \u092A\u0917\u0921\u0902\u0921\u0940 \u092A\u0930 \u0926\u094C\u0921\u093C
      \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u092A\u094D\u0930\u0915\u0943\u0924\u093F
      \u0915\u0947 \u092C\u0940\u091A \u0915\u0940 \u092F\u0939 \u0924\u093E\u091C\u0917\u0940
      \u092D\u0930\u0940 \u0938\u0935\u093E\u0930\u0940 \u0909\u0928\u0915\u0947
      \u0936\u0930\u0940\u0930 \u092E\u0947\u0902 \u0938\u094D\u092B\u0942\u0930\u094D\u0924\u093F
      \u092D\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"
    Ar: "\u064A\u0631\u0643\u0628 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u062F\u0631\u0627\u062C\u0627\u062A\u0647\u0645 \u0627\u0644\u0647\u0648\u0627\u0626\u064A\u0629
      \u0639\u0644\u0649 \u0637\u0648\u0644 \u0628\u062D\u064A\u0631\u0629 \u0635\u0627\u0641\u064A\u0629
      \u0648\u062C\u0628\u0627\u0644 \u062E\u0636\u0631\u0627\u0621. \u064A\u062A\u0633\u0627\u0628\u0642\u0648\u0646
      \u0628\u062D\u0645\u0627\u0633 \u0639\u0644\u0649 \u0637\u0648\u0644 \u0627\u0644\u0645\u0633\u0627\u0631\u060C
      \u0645\u062E\u062A\u0631\u0642\u064A\u0646 \u0627\u0644\u0646\u0633\u064A\u0645
      \u0627\u0644\u0639\u0644\u064A\u0644. \u0647\u0630\u0647 \u0627\u0644\u0631\u062D\u0644\u0629
      \u0627\u0644\u0645\u0646\u0639\u0634\u0629 \u0639\u0628\u0631 \u0627\u0644\u0637\u0628\u064A\u0639\u0629
      \u062A\u0645\u0646\u062D\u0647\u0645 \u0627\u0644\u062D\u064A\u0648\u064A\u0629
      \u0648\u0627\u0644\u0646\u0634\u0627\u0637."
  - Key: 200124
    En: Friends travel to the romantic city of Paris with the Eiffel Tower in the
      background. Wearing berets, they capture wonderful moments with their cameras.
      The heartwarming memories of this overseas trip linger in the heart for a long
      time.
    Ko: "\uC5D0\uD3A0\uD0D1\uC744 \uBC30\uACBD\uC73C\uB85C \uCE5C\uAD6C\uB4E4\uC774
      \uB0AD\uB9CC\uC758 \uB3C4\uC2DC \uD30C\uB9AC\uB97C \uC5EC\uD589\uD569\uB2C8\uB2E4.
      \uBCA0\uB808\uBAA8\uB97C \uC4F0\uACE0 \uCE74\uBA54\uB77C\uB85C \uBA4B\uC9C4
      \uC21C\uAC04\uB4E4\uC744 \uB2F4\uC2B5\uB2C8\uB2E4. \uC124\uB808\uB294 \uD574\uC678\uC5EC\uD589\uC758
      \uCD94\uC5B5\uC774 \uC624\uB798\uB3C4\uB85D \uB9C8\uC74C\uC5D0 \uB0A8\uC2B5\uB2C8\uB2E4."
    Ja: "\u30A8\u30C3\u30D5\u30A7\u30EB\u5854\u3092\u80CC\u666F\u306B\u3001\u53CB\u9054\u304C\u30ED\u30DE\u30F3\u30C1\u30C3\u30AF\u306A\u90FD\u5E02\u30D1\u30EA\u3092\u65C5\u3057\u307E\u3059\u3002\u30D9\u30EC\u30FC\u5E3D\u3092\u304B\u3076\u308A\u3001\u30AB\u30E1\u30E9\u3067\u7D20\u6575\u306A\u77AC\u9593\u3092\u76DB\u308A\u8FBC\u307F\u307E\u3059\u3002\u3068\u304D\u3081\u304D\u306F\u6D77\u5916\u65C5\u884C\u306E\u601D\u3044\u51FA\u304C\u9577\u304F\u306A\u308B\u3088\u3046\u306B\u5FC3\u306B\u6B8B\u308A\u307E\u3059\u3002"
    Zh: "\u670B\u53CB\u4EEC\u524D\u5F80\u6D6A\u6F2B\u4E4B\u90FD\u5DF4\u9ECE\uFF0C\u4EE5\u57C3\u83F2\u5C14\u94C1\u5854\u4E3A\u80CC\u666F\uFF0C\u6234\u7740\u8D1D\u96F7\u5E3D\uFF0C\u7528\u76F8\u673A\u8BB0\u5F55\u4E0B\u8FD9\u4E9B\u7F8E\u597D\u77AC\u95F4\u3002\u8FD9\u6B21\u6D77\u5916\u65C5\u884C\u7684\u6E29\u99A8\u56DE\u5FC6\uFF0C\u957F\u4E45\u5730\u7559\u5728\u4E86\u4ED6\u4EEC\u7684\u5FC3\u4E2D\u3002"
    Vi: "M\u1ED9t nh\xF3m b\u1EA1n c\xF9ng nhau du l\u1ECBch \u0111\u1EBFn th\xE0nh
      ph\u1ED1 Paris l\xE3ng m\u1EA1n v\u1EDBi th\xE1p Eiffel l\xE0m n\u1EC1n. \u0110\u1ED9i
      m\u0169 beret, h\u1ECD ghi l\u1EA1i nh\u1EEFng kho\u1EA3nh kh\u1EAFc tuy\u1EC7t
      v\u1EDDi b\u1EB1ng m\xE1y \u1EA3nh. Nh\u1EEFng k\u1EF7 ni\u1EC7m \u1EA5m \xE1p
      v\u1EC1 chuy\u1EBFn \u0111i n\u01B0\u1EDBc ngo\xE0i n\xE0y s\u1EBD c\xF2n \u0111\u1ECDng
      l\u1EA1i trong l\xF2ng h\u1ECD r\u1EA5t l\xE2u."
    Hi: "\u0926\u094B\u0938\u094D\u0924\u094B\u0902 \u0928\u0947 \u090F\u092B\u093F\u0932
      \u091F\u0949\u0935\u0930 \u0915\u0940 \u092A\u0943\u0937\u094D\u0920\u092D\u0942\u092E\u093F
      \u092E\u0947\u0902 \u092C\u0938\u0947 \u0930\u094B\u092E\u093E\u0902\u091F\u093F\u0915
      \u0936\u0939\u0930 \u092A\u0947\u0930\u093F\u0938 \u0915\u0940 \u092F\u093E\u0924\u094D\u0930\u093E
      \u0915\u0940\u0964 \u091F\u094B\u092A\u0940 \u092A\u0939\u0928\u0947 \u0939\u0941\u090F,
      \u0909\u0928\u094D\u0939\u094B\u0902\u0928\u0947 \u0905\u092A\u0928\u0947 \u0915\u0948\u092E\u0930\u094B\u0902
      \u0938\u0947 \u0916\u0942\u092C\u0938\u0942\u0930\u0924 \u092A\u0932\u094B\u0902
      \u0915\u094B \u0915\u0948\u0926 \u0915\u093F\u092F\u093E\u0964 \u0907\u0938
      \u0935\u093F\u0926\u0947\u0936 \u092F\u093E\u0924\u094D\u0930\u093E \u0915\u0940
      \u0926\u093F\u0932 \u0915\u094B \u091B\u0942 \u0932\u0947\u0928\u0947 \u0935\u093E\u0932\u0940
      \u092F\u093E\u0926\u0947\u0902 \u0932\u0902\u092C\u0947 \u0938\u092E\u092F
      \u0924\u0915 \u0909\u0928\u0915\u0947 \u0926\u093F\u0932\u094B\u0902 \u092E\u0947\u0902
      \u092C\u0938\u0940 \u0930\u0939\u0940\u0902\u0964"
    Ar: "\u064A\u0633\u0627\u0641\u0631 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0625\u0644\u0649 \u0645\u062F\u064A\u0646\u0629 \u0628\u0627\u0631\u064A\u0633
      \u0627\u0644\u0631\u0648\u0645\u0627\u0646\u0633\u064A\u0629\u060C \u0648\u062E\u0644\u0641\u0647\u0645
      \u0628\u0631\u062C \u0625\u064A\u0641\u0644 \u0627\u0644\u0634\u0647\u064A\u0631.
      \u064A\u0631\u062A\u062F\u0648\u0646 \u0642\u0628\u0639\u0627\u062A \u0627\u0644\u0628\u064A\u0631\u064A\u0647\u060C
      \u0648\u064A\u0644\u062A\u0642\u0637\u0648\u0646 \u0644\u062D\u0638\u0627\u062A
      \u0631\u0627\u0626\u0639\u0629 \u0628\u0639\u062F\u0633\u0627\u062A \u0643\u0627\u0645\u064A\u0631\u0627\u062A\u0647\u0645.
      \u062A\u0628\u0642\u0649 \u0630\u0643\u0631\u064A\u0627\u062A \u0647\u0630\u0647
      \u0627\u0644\u0631\u062D\u0644\u0629 \u0627\u0644\u062E\u0627\u0631\u062C\u064A\u0629
      \u0627\u0644\u062F\u0627\u0641\u0626\u0629 \u0639\u0627\u0644\u0642\u0629 \u0641\u064A
      \u0627\u0644\u0642\u0644\u0648\u0628 \u0644\u0641\u062A\u0631\u0629 \u0637\u0648\u064A\u0644\u0629."
  - Key: 200125
    En: Friends are excitedly sliding down the pure white snowfield on sleds. Laughter
      never ceases, even in the cold air. It is the most thrilling game that winter
      offers.
    Ko: "\uC0C8\uD558\uC580 \uB208\uBC2D \uC704\uB97C \uCE5C\uAD6C\uB4E4\uC774 \uC370\uB9E4\uB97C
      \uD0C0\uACE0 \uC2E0\uB098\uAC8C \uBBF8\uB044\uB7EC\uC838 \uB0B4\uB824\uAC11\uB2C8\uB2E4.
      \uCC28\uAC00\uC6B4 \uACF5\uAE30 \uC18D\uC5D0\uC11C\uB3C4 \uC6C3\uC74C\uC18C\uB9AC\uAC00
      \uB04A\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uACA8\uC6B8\uC774 \uC120\uBB3C\uD558\uB294
      \uAC00\uC7A5 \uC9DC\uB9BF\uD55C \uB180\uC774\uC785\uB2C8\uB2E4."
    Ja: "\u771F\u3063\u767D\u306A\u96EA\u539F\u306E\u4E0A\u3092\u53CB\u9054\u304C\u305D\u308A\u306B\u4E57\u3063\u3066\u697D\u3057\u304F\u6ED1\u308A\u843D\u3061\u3066\u3044\u304D\u307E\u3059\u3002\u51B7\u305F\u3044\u7A7A\u6C17\u306E\u4E2D\u3067\u3082\u7B11\u3044\u58F0\u304C\u7D76\u3048\u307E\u305B\u3093\u3002\u51AC\u304C\u30D7\u30EC\u30BC\u30F3\u30C8\u3059\u308B\u6700\u3082\u723D\u3084\u304B\u306A\u904A\u3073\u3067\u3059\u3002"
    Zh: "\u670B\u53CB\u4EEC\u5174\u594B\u5730\u5750\u5728\u96EA\u6A47\u4E0A\uFF0C\u4ECE\u7EAF\u767D\u7684\u96EA\u539F\u4E0A\u6ED1\u4E0B\u6765\u3002\u5373\u4F7F\u5728\u5BD2\u51B7\u7684\u7A7A\u6C14\u4E2D\uFF0C\u7B11\u58F0\u4E5F\u4ECE\u672A\u505C\u6B62\u3002\u8FD9\u662F\u51AC\u5929\u6700\u523A\u6FC0\u7684\u6E38\u620F\u3002"
    Vi: "B\u1EA1n b\xE8 h\xE0o h\u1EE9ng tr\u01B0\u1EE3t xu\u1ED1ng c\xE1nh \u0111\u1ED3ng
      tuy\u1EBFt tr\u1EAFng tinh kh\xF4i tr\xEAn nh\u1EEFng chi\u1EBFc xe tr\u01B0\u1EE3t
      tuy\u1EBFt. Ti\u1EBFng c\u01B0\u1EDDi kh\xF4ng bao gi\u1EDD d\u1EE9t, ngay
      c\u1EA3 trong kh\xF4ng kh\xED l\u1EA1nh gi\xE1. \u0110\xF3 l\xE0 tr\xF2 ch\u01A1i
      th\xFA v\u1ECB nh\u1EA5t m\xE0 m\xF9a \u0111\xF4ng mang l\u1EA1i."
    Hi: "\u0926\u094B\u0938\u094D\u0924 \u0909\u0924\u094D\u0938\u093E\u0939 \u0938\u0947
      \u092C\u0930\u094D\u092B \u0938\u0947 \u0922\u0915\u0947 \u092E\u0948\u0926\u093E\u0928
      \u092A\u0930 \u0938\u094D\u0932\u0947\u091C \u092A\u0930 \u092B\u093F\u0938\u0932
      \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0915\u0921\u093C\u093E\u0915\u0947
      \u0915\u0940 \u0920\u0902\u0921 \u092E\u0947\u0902 \u092D\u0940 \u0939\u0902\u0938\u0940
      \u0915\u093E \u0938\u093F\u0932\u0938\u093F\u0932\u093E \u091C\u093E\u0930\u0940
      \u0939\u0948\u0964 \u092F\u0939 \u0938\u0930\u094D\u0926\u093F\u092F\u094B\u0902
      \u0915\u093E \u0938\u092C\u0938\u0947 \u0930\u094B\u092E\u093E\u0902\u091A\u0915
      \u0916\u0947\u0932 \u0939\u0948\u0964"
    Ar: "\u064A\u062A\u0632\u0644\u062C \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0628\u062D\u0645\u0627\u0633 \u0639\u0644\u0649 \u0645\u0646\u062D\u062F\u0631\u0627\u062A
      \u0627\u0644\u062B\u0644\u062C \u0627\u0644\u0623\u0628\u064A\u0636 \u0627\u0644\u0646\u0627\u0635\u0639.
      \u0644\u0627 \u062A\u062A\u0648\u0642\u0641 \u0627\u0644\u0636\u062D\u0643\u0627\u062A\u060C
      \u062D\u062A\u0649 \u0641\u064A \u0647\u0630\u0627 \u0627\u0644\u0647\u0648\u0627\u0621
      \u0627\u0644\u0628\u0627\u0631\u062F. \u0625\u0646\u0647\u0627 \u0623\u0643\u062B\u0631
      \u0627\u0644\u0623\u0644\u0639\u0627\u0628 \u0625\u062B\u0627\u0631\u0629 \u0627\u0644\u062A\u064A
      \u064A\u0642\u062F\u0645\u0647\u0627 \u0627\u0644\u0634\u062A\u0627\u0621."
  - Key: 200126
    En: Friends build sandcastles on a beach where blue waves crash. Some surf, others
      ride tubes, fully enjoying the summer sea. It is a perfect day spent on a sun-drenched
      beach.
    Ko: "\uD478\uB978 \uD30C\uB3C4\uAC00 \uB118\uC2E4\uB300\uB294 \uD574\uBCC0\uC5D0\uC11C
      \uCE5C\uAD6C\uB4E4\uC774 \uBAA8\uB798\uC131\uC744 \uC313\uC2B5\uB2C8\uB2E4.
      \uB204\uAD6C\uB294 \uC11C\uD551\uC744, \uB204\uAD6C\uB294 \uD29C\uBE0C\uB97C
      \uD0C0\uBA70 \uC5EC\uB984 \uBC14\uB2E4\uB97C \uB9CC\uB07D\uD569\uB2C8\uB2E4.
      \uD587\uC0B4 \uAC00\uB4DD\uD55C \uD574\uBCC0\uC5D0\uC11C \uBCF4\uB0B4\uB294
      \uC644\uBCBD\uD55C \uD558\uB8E8\uC785\uB2C8\uB2E4."
    Ja: "\u9752\u3044\u6CE2\u304C\u3044\u3063\u3071\u3044\u306E\u30D3\u30FC\u30C1\u3067\u53CB\u9054\u304C\u7802\u306E\u57CE\u3092\u7BC9\u304D\u307E\u3059\u3002\u8AB0\u304C\u30B5\u30FC\u30D5\u30A3\u30F3\u3092\u3001\u8AB0\u304C\u30C1\u30E5\u30FC\u30D6\u306B\u4E57\u3063\u3066\u590F\u306E\u6D77\u3092\u6E80\u55AB\u3057\u307E\u3059\u3002\u65E5\u5F53\u305F\u308A\u306E\u826F\u3044\u30D3\u30FC\u30C1\u3067\u904E\u3054\u3059\u306E\u306B\u6700\u9069\u306A\u4E00\u65E5\u3002"
    Zh: "\u670B\u53CB\u4EEC\u5728\u78A7\u6CE2\u8361\u6F3E\u7684\u6C99\u6EE9\u4E0A\u5806\u780C\u6C99\u5821\u3002\u6709\u7684\u51B2\u6D6A\uFF0C\u6709\u7684\u73A9\u6C34\u4E0A\u6ED1\u677F\uFF0C\u5C3D\u60C5\u4EAB\u53D7\u7740\u590F\u65E5\u7684\u5927\u6D77\u3002\u8FD9\u662F\u5728\u9633\u5149\u666E\u7167\u7684\u6C99\u6EE9\u4E0A\u5EA6\u8FC7\u7684\u5B8C\u7F8E\u4E00\u5929\u3002"
    Vi: "B\u1EA1n b\xE8 c\xF9ng nhau x\xE2y l\xE2u \u0111\xE0i c\xE1t tr\xEAn b\xE3i
      bi\u1EC3n n\u01A1i nh\u1EEFng con s\xF3ng xanh v\u1ED7 r\xEC r\xE0o. M\u1ED9t
      s\u1ED1 ng\u01B0\u1EDDi l\u01B0\u1EDBt s\xF3ng, s\u1ED1 kh\xE1c th\xEC ch\u01A1i
      tr\xF2 l\u01B0\u1EDBt s\xF3ng trong \u1ED1ng s\xF3ng, t\u1EADn h\u01B0\u1EDFng
      tr\u1ECDn v\u1EB9n m\xF9a h\xE8 tr\xEAn bi\u1EC3n. \u0110\xF3 l\xE0 m\u1ED9t
      ng\xE0y ho\xE0n h\u1EA3o tr\xEAn b\xE3i bi\u1EC3n ng\u1EADp tr\xE0n \xE1nh
      n\u1EAFng."
    Hi: "\u0928\u0940\u0932\u0940 \u0932\u0939\u0930\u094B\u0902 \u0938\u0947 \u0918\u093F\u0930\u0947
      \u0938\u092E\u0941\u0926\u094D\u0930 \u0924\u091F \u092A\u0930 \u0926\u094B\u0938\u094D\u0924
      \u0930\u0947\u0924 \u0915\u0947 \u092E\u0939\u0932 \u092C\u0928\u093E \u0930\u0939\u0947
      \u0939\u0948\u0902\u0964 \u0915\u0941\u091B \u0938\u0930\u094D\u092B\u093F\u0902\u0917
      \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0924\u094B \u0915\u0941\u091B
      \u091F\u094D\u092F\u0942\u092C \u0930\u093E\u0907\u0921 \u0915\u093E \u0932\u0941\u0924\u094D\u092B\u093C
      \u0909\u0920\u093E \u0930\u0939\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0917\u0930\u094D\u092E\u093F\u092F\u094B\u0902
      \u0915\u0947 \u0907\u0938 \u0916\u0942\u092C\u0938\u0942\u0930\u0924 \u0938\u092E\u0941\u0926\u094D\u0930
      \u0915\u093E \u092A\u0942\u0930\u093E \u0906\u0928\u0902\u0926 \u0932\u0947
      \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0927\u0942\u092A \u0938\u0947
      \u0938\u0930\u093E\u092C\u094B\u0930 \u0938\u092E\u0941\u0926\u094D\u0930 \u0924\u091F
      \u092A\u0930 \u092C\u093F\u0924\u093E\u092F\u093E \u0917\u092F\u093E \u092F\u0939
      \u090F\u0915 \u0906\u0926\u0930\u094D\u0936 \u0926\u093F\u0928 \u0939\u0948\u0964"
    Ar: "\u064A\u0628\u0646\u064A \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0642\u0644\u0627\u0639\u064B\u0627 \u0631\u0645\u0644\u064A\u0629 \u0639\u0644\u0649
      \u0634\u0627\u0637\u0626 \u062A\u062A\u0644\u0627\u0637\u0645 \u0639\u0644\u064A\u0647
      \u0627\u0644\u0623\u0645\u0648\u0627\u062C \u0627\u0644\u0632\u0631\u0642\u0627\u0621.
      \u064A\u0645\u0627\u0631\u0633 \u0627\u0644\u0628\u0639\u0636 \u0631\u064A\u0627\u0636\u0629
      \u0631\u0643\u0648\u0628 \u0627\u0644\u0623\u0645\u0648\u0627\u062C\u060C \u0628\u064A\u0646\u0645\u0627
      \u064A\u0631\u0643\u0628 \u0622\u062E\u0631\u0648\u0646 \u0627\u0644\u0623\u0646\u0627\u0628\u064A\u0628
      \u0627\u0644\u0645\u0637\u0627\u0637\u064A\u0629\u060C \u0645\u0633\u062A\u0645\u062A\u0639\u064A\u0646
      \u062A\u0645\u0627\u0645\u064B\u0627 \u0628\u0628\u062D\u0631 \u0627\u0644\u0635\u064A\u0641.
      \u0625\u0646\u0647 \u064A\u0648\u0645 \u0645\u062B\u0627\u0644\u064A \u064A\u064F\u0642\u0636\u0649
      \u0639\u0644\u0649 \u0634\u0627\u0637\u0626 \u0645\u0634\u0645\u0633."
  - Key: 200127
    En: Friends in pajamas are having a pillow fight on the bed. Fluffy pillows fly
      around, and the room is filled with laughter. It is a fun pajama party that
      continues late into the night.
    Ko: "\uC7A0\uC637\uC744 \uC785\uC740 \uCE5C\uAD6C\uB4E4\uC774 \uCE68\uB300 \uC704\uC5D0\uC11C
      \uBCA0\uAC1C \uC2F8\uC6C0\uC744 \uBC8C\uC785\uB2C8\uB2E4. \uD3ED\uC2E0\uD55C
      \uBCA0\uAC1C\uAC00 \uB0A0\uC544\uB2E4\uB2C8\uACE0 \uBC29 \uC548\uC740 \uC6C3\uC74C\uC73C\uB85C
      \uAC00\uB4DD\uD569\uB2C8\uB2E4. \uBC24\uB2A6\uB3C4\uB85D \uC774\uC5B4\uC9C0\uB294
      \uC990\uAC70\uC6B4 \uD30C\uC790\uB9C8 \uD30C\uD2F0\uC785\uB2C8\uB2E4."
    Ja: "\u30D1\u30B8\u30E3\u30DE\u3092\u7740\u305F\u53CB\u4EBA\u304C\u30D9\u30C3\u30C9\u306E\u4E0A\u3067\u6795\u306E\u6226\u3044\u3092\u884C\u3044\u307E\u3059\u3002\u3075\u308F\u3075\u308F\u306E\u6795\u304C\u98DB\u3073\u56DE\u308A\u3001\u90E8\u5C4B\u306E\u4E2D\u306F\u7B11\u3044\u304C\u3044\u3063\u3071\u3044\u3067\u3059\u3002\u591C\u9045\u304F\u307E\u3067\u7D9A\u304F\u697D\u3057\u3044\u30D1\u30B8\u30E3\u30DE\u30D1\u30FC\u30C6\u30A3\u30FC\u3067\u3059\u3002"
    Zh: "\u51E0\u4E2A\u670B\u53CB\u7A7F\u7740\u7761\u8863\u5728\u5E8A\u4E0A\u6253\u6795\u5934\u4ED7\u3002\u84EC\u677E\u7684\u6795\u5934\u56DB\u5904\u98DE\u821E\uFF0C\u623F\u95F4\u91CC\u5145\u6EE1\u4E86\u6B22\u58F0\u7B11\u8BED\u3002\u8FD9\u662F\u4E00\u573A\u70ED\u95F9\u7684\u7761\u8863\u6D3E\u5BF9\uFF0C\u4E00\u76F4\u6301\u7EED\u5230\u6DF1\u591C\u3002"
    Vi: "Nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n m\u1EB7c \u0111\u1ED3 ng\u1EE7 \u0111ang
      ch\u01A1i tr\xF2 n\xE9m g\u1ED1i tr\xEAn gi\u01B0\u1EDDng. Nh\u1EEFng chi\u1EBFc
      g\u1ED1i b\xF4ng m\u1EC1m m\u1EA1i bay t\u1EE9 tung, v\xE0 c\u0103n ph\xF2ng
      tr\xE0n ng\u1EADp ti\u1EBFng c\u01B0\u1EDDi. \u0110\xF3 l\xE0 m\u1ED9t b\u1EEFa
      ti\u1EC7c ng\u1EE7 vui v\u1EBB k\xE9o d\xE0i \u0111\u1EBFn t\u1EADn khuya."
    Hi: "\u092A\u091C\u093E\u092E\u093E \u092A\u0939\u0928\u0947 \u0926\u094B\u0938\u094D\u0924
      \u092C\u093F\u0938\u094D\u0924\u0930 \u092A\u0930 \u0924\u0915\u093F\u090F
      \u0938\u0947 \u0916\u0947\u0932 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964
      \u092E\u0941\u0932\u093E\u092F\u092E \u0924\u0915\u093F\u090F \u0907\u0927\u0930-\u0909\u0927\u0930
      \u0909\u0921\u093C \u0930\u0939\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0915\u092E\u0930\u093E
      \u0939\u0902\u0938\u0940 \u0938\u0947 \u0917\u0942\u0902\u091C \u0930\u0939\u093E
      \u0939\u0948\u0964 \u092F\u0939 \u090F\u0915 \u092E\u091C\u0947\u0926\u093E\u0930
      \u092A\u091C\u093E\u092E\u093E \u092A\u093E\u0930\u094D\u091F\u0940 \u0939\u0948
      \u091C\u094B \u0926\u0947\u0930 \u0930\u093E\u0924 \u0924\u0915 \u091A\u0932\u0924\u0940
      \u0930\u0939\u0924\u0940 \u0939\u0948\u0964"
    Ar: "\u0623\u0635\u062F\u0642\u0627\u0621 \u064A\u0631\u062A\u062F\u0648\u0646
      \u0628\u064A\u062C\u0627\u0645\u0627\u062A\u0647\u0645 \u064A\u062E\u0648\u0636\u0648\u0646
      \u0645\u0639\u0631\u0643\u0629 \u0628\u0627\u0644\u0648\u0633\u0627\u0626\u062F
      \u0639\u0644\u0649 \u0627\u0644\u0633\u0631\u064A\u0631. \u062A\u062A\u0637\u0627\u064A\u0631
      \u0627\u0644\u0648\u0633\u0627\u0626\u062F \u0627\u0644\u0646\u0627\u0639\u0645\u0629
      \u0641\u064A \u0643\u0644 \u0645\u0643\u0627\u0646\u060C \u0648\u062A\u0645\u0644\u0623
      \u0627\u0644\u0636\u062D\u0643\u0627\u062A \u0623\u0631\u062C\u0627\u0621 \u0627\u0644\u063A\u0631\u0641\u0629.
      \u0625\u0646\u0647\u0627 \u062D\u0641\u0644\u0629 \u0628\u064A\u062C\u0627\u0645\u0627\u062A
      \u0645\u0645\u062A\u0639\u0629 \u062A\u0633\u062A\u0645\u0631 \u062D\u062A\u0649
      \u0648\u0642\u062A \u0645\u062A\u0623\u062E\u0631 \u0645\u0646 \u0627\u0644\u0644\u064A\u0644."
  - Key: 200128
    En: Friends dressed as explorers explore the massive pyramids and the Sphinx.
      They unfold maps and take photos as they confront the mysteries of ancient
      civilizations. It is an exciting grand adventure unfolding on the sandy desert.
    Ko: "\uD0D0\uD5D8\uAC00 \uBCF5\uC7A5\uC744 \uAC16\uCD98 \uCE5C\uAD6C\uB4E4\uC774
      \uAC70\uB300\uD55C \uD53C\uB77C\uBBF8\uB4DC\uC640 \uC2A4\uD551\uD06C\uC2A4\uB97C
      \uD0D0\uD5D8\uD569\uB2C8\uB2E4. \uC9C0\uB3C4\uB97C \uD3BC\uCE58\uACE0 \uC0AC\uC9C4\uC744
      \uCC0D\uC73C\uBA70 \uACE0\uB300 \uBB38\uBA85\uC758 \uC2E0\uBE44\uB97C \uB9C8\uC8FC\uD569\uB2C8\uB2E4.
      \uBAA8\uB798\uC0AC\uB9C9 \uC704\uC5D0\uC11C \uD3BC\uCCD0\uC9C0\uB294 \uD765\uBBF8\uC9C4\uC9C4\uD55C
      \uB300\uBAA8\uD5D8\uC785\uB2C8\uB2E4."
    Ja: "\u63A2\u691C\u5BB6\u306E\u8863\u88C5\u3092\u6301\u3064\u53CB\u4EBA\u306F\u3001\u5DE8\u5927\u306A\u30D4\u30E9\u30DF\u30C3\u30C9\u3068\u30B9\u30D5\u30A3\u30F3\u30AF\u30B9\u3092\u63A2\u691C\u3057\u307E\u3059\u3002\u5730\u56F3\u3092\u5E83\u3052\u3066\u5199\u771F\u3092\u64AE\u308A\u3001\u53E4\u4EE3\u6587\u660E\u306E\u8B0E\u306B\u76F4\u9762\u3057\u307E\u3059\u3002\u7802\u7802\u6F20\u306E\u4E0A\u3067\u7E70\u308A\u5E83\u3052\u3089\u308C\u308B\u30A8\u30AD\u30B5\u30A4\u30C6\u30A3\u30F3\u30B0\u306A\u5927\u5192\u967A\u3067\u3059\u3002"
    Zh: "\u4E00\u7FA4\u88C5\u626E\u6210\u63A2\u9669\u5BB6\u7684\u670B\u53CB\u63A2\u7D22\u7740\u96C4\u4F1F\u7684\u91D1\u5B57\u5854\u548C\u72EE\u8EAB\u4EBA\u9762\u50CF\u3002\u4ED6\u4EEC\u5C55\u5F00\u5730\u56FE\uFF0C\u62CD\u7167\u7559\u5FF5\uFF0C\u8BD5\u56FE\u63ED\u5F00\u53E4\u4EE3\u6587\u660E\u7684\u795E\u79D8\u9762\u7EB1\u3002\u8FD9\u662F\u4E00\u573A\u5728\u6C99\u6F20\u4E2D\u5C55\u5F00\u7684\u6FC0\u52A8\u4EBA\u5FC3\u7684\u5192\u9669\u4E4B\u65C5\u3002"
    Vi: "M\u1ED9t nh\xF3m b\u1EA1n trong trang ph\u1EE5c nh\xE0 th\xE1m hi\u1EC3m
      c\xF9ng nhau kh\xE1m ph\xE1 nh\u1EEFng kim t\u1EF1 th\xE1p \u0111\u1ED3 s\u1ED9
      v\xE0 t\u01B0\u1EE3ng Sphinx. H\u1ECD tr\u1EA3i b\u1EA3n \u0111\u1ED3 v\xE0
      ch\u1EE5p \u1EA3nh khi \u0111\u1ED1i m\u1EB7t v\u1EDBi nh\u1EEFng b\xED \u1EA9n
      c\u1EE7a c\xE1c n\u1EC1n v\u0103n minh c\u1ED5 \u0111\u1EA1i. \u0110\xF3 l\xE0
      m\u1ED9t cu\u1ED9c phi\xEAu l\u01B0u v\u0129 \u0111\u1EA1i \u0111\u1EA7y th\xFA
      v\u1ECB di\u1EC5n ra tr\xEAn sa m\u1EA1c c\xE1t."
    Hi: "\u0916\u094B\u091C\u0915\u0930\u094D\u0924\u093E\u0913\u0902 \u0915\u0947
      \u0935\u0947\u0936 \u092E\u0947\u0902 \u0926\u094B\u0938\u094D\u0924 \u0935\u093F\u0936\u093E\u0932
      \u092A\u093F\u0930\u093E\u092E\u093F\u0921\u094B\u0902 \u0914\u0930 \u0938\u094D\u092B\u093F\u0902\u0915\u094D\u0938
      \u0915\u0940 \u0916\u094B\u091C \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964
      \u0935\u0947 \u0928\u0915\u094D\u0936\u0947 \u0916\u094B\u0932\u0924\u0947
      \u0939\u0948\u0902 \u0914\u0930 \u092A\u094D\u0930\u093E\u091A\u0940\u0928
      \u0938\u092D\u094D\u092F\u0924\u093E\u0913\u0902 \u0915\u0947 \u0930\u0939\u0938\u094D\u092F\u094B\u0902
      \u0915\u093E \u0938\u093E\u092E\u0928\u093E \u0915\u0930\u0924\u0947 \u0939\u0941\u090F
      \u0924\u0938\u094D\u0935\u0940\u0930\u0947\u0902 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964
      \u092F\u0939 \u0930\u0947\u0924\u0940\u0932\u0947 \u0930\u0947\u0917\u093F\u0938\u094D\u0924\u093E\u0928
      \u092E\u0947\u0902 \u0918\u091F\u093F\u0924 \u0939\u094B \u0930\u0939\u093E
      \u090F\u0915 \u0930\u094B\u092E\u093E\u0902\u091A\u0915 \u0938\u093E\u0939\u0938\u093F\u0915
      \u0915\u093E\u0930\u094D\u092F \u0939\u0948\u0964"
    Ar: "\u0623\u0635\u062F\u0642\u0627\u0621 \u064A\u0631\u062A\u062F\u0648\u0646
      \u0632\u064A \u0627\u0644\u0645\u0633\u062A\u0643\u0634\u0641\u064A\u0646 \u064A\u0633\u062A\u0643\u0634\u0641\u0648\u0646
      \u0627\u0644\u0623\u0647\u0631\u0627\u0645\u0627\u062A \u0627\u0644\u0636\u062E\u0645\u0629
      \u0648\u0623\u0628\u0648 \u0627\u0644\u0647\u0648\u0644. \u064A\u0641\u0631\u062F\u0648\u0646
      \u0627\u0644\u062E\u0631\u0627\u0626\u0637 \u0648\u064A\u0644\u062A\u0642\u0637\u0648\u0646
      \u0627\u0644\u0635\u0648\u0631 \u0628\u064A\u0646\u0645\u0627 \u064A\u0648\u0627\u062C\u0647\u0648\u0646
      \u0623\u0633\u0631\u0627\u0631 \u0627\u0644\u062D\u0636\u0627\u0631\u0627\u062A
      \u0627\u0644\u0642\u062F\u064A\u0645\u0629. \u0625\u0646\u0647\u0627 \u0645\u063A\u0627\u0645\u0631\u0629
      \u0631\u0627\u0626\u0639\u0629 \u0648\u0645\u062B\u064A\u0631\u0629 \u062A\u062A\u0643\u0634\u0641
      \u0641\u064A \u0627\u0644\u0635\u062D\u0631\u0627\u0621 \u0627\u0644\u0631\u0645\u0644\u064A\u0629."
