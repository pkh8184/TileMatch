    Zh: "8\u7EA7\u5F00\u653E"
    Vi: "T\u1EA7ng 8 M\u1EDF c\u1EEDa"
    Hi: "\u0938\u094D\u0924\u0930 8 \u0916\u0941\u0932\u093E \u0939\u0948"
    Ar: "\u0627\u0644\u0645\u0633\u062A\u0648\u0649 8 \u0645\u0641\u062A\u0648\u062D"
  - Key: 1003
