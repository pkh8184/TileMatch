    Zh: "\u6B22\u4E50\u821E\u8E48\u65F6\u95F4"
    Vi: "Gi\u1EDD khi\xEAu v\u0169 s\xF4i \u0111\u1ED9ng"
    Hi: "\u092E\u091C\u093C\u0947\u0926\u093E\u0930 \u0921\u093E\u0902\u0938 \u091F\u093E\u0907\u092E"
    Ar: "\u0648\u0642\u062A \u0627\u0644\u0631\u0642\u0635 \u0627\u0644\u0645\u0645\u062A\u0639"
  - Key: 200115
    En: Lakeside Bike Ride
    Ko: "\uD638\uC22B\uAC00 \uC790\uC804\uAC70 \uB77C\uC774\uB529"
    Ja: "\u6E56\u7554\u30B5\u30A4\u30AF\u30EA\u30F3\u30B0"
    Zh: "\u6E56\u7554\u9A91\u884C"
    Vi: "\u0110\u1EA1p xe b\xEAn h\u1ED3"
    Hi: "\u091D\u0940\u0932 \u0915\u093F\u0928\u093E\u0930\u0947 \u0938\u093E\u0907\u0915\u093F\u0932
      \u0915\u0940 \u0938\u0935\u093E\u0930\u0940"
    Ar: "\u062C\u0648\u0644\u0629 \u0628\u0627\u0644\u062F\u0631\u0627\u062C\u0627\u062A
      \u0639\u0644\u0649 \u0636\u0641\u0629 \u0627\u0644\u0628\u062D\u064A\u0631\u0629"
  - Key: 200116
    En: Trip to the Eiffel Tower in Paris
    Ko: "\uD30C\uB9AC \uC5D0\uD3A0\uD0D1 \uC5EC\uD589"
    Ja: "\u30D1\u30EA\u30FB\u30A8\u30C3\u30D5\u30A7\u30EB\u5854\u306E\u65C5"
    Zh: "\u5DF4\u9ECE\u57C3\u83F2\u5C14\u94C1\u5854\u4E4B\u65C5"
    Vi: "Du l\u1ECBch th\xE1p Eiffel Paris"
    Hi: "\u092A\u0947\u0930\u093F\u0938 \u090F\u092B\u093F\u0932 \u091F\u0949\u0935\u0930
      \u0915\u0940 \u092F\u093E\u0924\u094D\u0930\u093E"
    Ar: "\u0631\u062D\u0644\u0629 \u0625\u0644\u0649 \u0628\u0631\u062C \u0625\u064A\u0641\u0644
      \u0641\u064A \u0628\u0627\u0631\u064A\u0633"
  - Key: 200117
    En: Winter Sled Dash
    Ko: "\uACA8\uC6B8 \uB208\uC370\uB9E4 \uC9C8\uC8FC"
    Ja: "\u51AC\u306E\u305D\u308A\u6ED1\u308A"
    Zh: "\u51AC\u65E5\u96EA\u6A47\u98DE\u9A70"
    Vi: "Tr\u01B0\u1EE3t tuy\u1EBFt m\xF9a \u0111\xF4ng"
    Hi: "\u0938\u0930\u094D\u0926\u093F\u092F\u094B\u0902 \u0915\u0940 \u0938\u094D\u0932\u0947\u091C
      \u0926\u094C\u0921\u093C"
    Ar: "\u0627\u0646\u0637\u0644\u0627\u0642 \u0627\u0644\u0632\u0644\u0627\u062C\u0629
      \u0627\u0644\u0634\u062A\u0648\u064A\u0629"
  - Key: 200118
    En: Building Sandcastles at the Beach
    Ko: "\uD574\uBCC0\uC5D0\uC11C \uBAA8\uB798\uC131 \uC313\uAE30"
    Ja: "\u30D3\u30FC\u30C1\u3067\u7802\u306E\u304A\u57CE\u3065\u304F\u308A"
    Zh: "\u5728\u6D77\u6EE9\u5806\u6C99\u5821"
    Vi: "X\xE2y l\xE2u \u0111\xE0i c\xE1t tr\xEAn b\xE3i bi\u1EC3n"
    Hi: "\u0938\u092E\u0941\u0926\u094D\u0930 \u0924\u091F \u092A\u0930 \u0930\u0947\u0924
      \u0915\u093E \u092E\u0939\u0932"
    Ar: "\u0628\u0646\u0627\u0621 \u0642\u0644\u0627\u0639 \u0627\u0644\u0631\u0645\u0644
      \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0637\u0626"
  - Key: 200119
    En: Fun Pajama Pillow Fight
    Ko: "\uC2E0\uB098\uB294 \uD30C\uC790\uB9C8 \uBCA0\uAC1C \uC2F8\uC6C0"
    Ja: "\u697D\u3057\u3044\u30D1\u30B8\u30E3\u30DE\u6795\u6295\u3052"
    Zh: "\u6B22\u4E50\u7761\u8863\u6795\u5934\u5927\u6218"
    Vi: "Tr\u1EADn chi\u1EBFn g\u1ED1i vui nh\u1ED9n trong b\u1ED9 pyjama"
    Hi: "\u092E\u091C\u093C\u0947\u0926\u093E\u0930 \u092A\u091C\u093E\u092E\u093E
      \u0924\u0915\u093F\u092F\u093E \u0932\u0921\u093C\u093E\u0908"
    Ar: "\u0645\u0639\u0631\u0643\u0629 \u0648\u0633\u0627\u0626\u062F \u0645\u0645\u062A\u0639\u0629
      \u0628\u0627\u0644\u0628\u064A\u062C\u0627\u0645\u0629"
  - Key: 200120
    En: Exploring the Egyptian Pyramids
    Ko: "\uC774\uC9D1\uD2B8 \uD53C\uB77C\uBBF8\uB4DC \uD0D0\uD5D8"
    Ja: "\u30A8\u30B8\u30D7\u30C8\u306E\u30D4\u30E9\u30DF\u30C3\u30C9\u63A2\u691C"
    Zh: "\u57C3\u53CA\u91D1\u5B57\u5854\u63A2\u9669"
    Vi: "Kh\xE1m ph\xE1 kim t\u1EF1 th\xE1p Ai C\u1EADp"
    Hi: "\u092E\u093F\u0938\u094D\u0930 \u0915\u0947 \u092A\u093F\u0930\u093E\u092E\u093F\u0921\u094B\u0902
      \u0915\u0940 \u0916\u094B\u091C"
    Ar: "\u0627\u0633\u062A\u0643\u0634\u0627\u0641 \u0623\u0647\u0631\u0627\u0645\u0627\u062A
      \u0645\u0635\u0631"
  - Key: 200121
    En: Cute animal friends are enjoying a camping trip in the forest. Gathered around
      a warm campfire, they roast marshmallows, sip cocoa, and share plenty of laughter.
      Maybe moments of rest like this are exactly what we need to get through life.
    Ko: "\uADC0\uC5EC\uC6B4 \uB3D9\uBB3C \uCE5C\uAD6C\uB4E4\uC774 \uC232\uC18D\uC5D0\uC11C
      \uCEA0\uD551\uC744 \uC990\uAE30\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uB530\uB73B\uD55C
      \uBAA8\uB2E5\uBD88 \uC55E\uC5D0 \uB458\uB7EC\uC549\uC544 \uB9C8\uC2DC\uBA5C\uB85C\uB97C
      \uAD7D\uACE0 \uCF54\uCF54\uC544\uB97C \uB9C8\uC2DC\uBA70 \uC6C3\uC74C\uAF43\uC744
      \uD53C\uC6C1\uB2C8\uB2E4. \uAC00\uB054\uC740 \uC774\uB807\uAC8C \uD734\uC2DD\uC744
      \uCDE8\uD558\uB294 \uAC83\uB3C4 \uC0B6\uC744 \uC0B4\uC544\uAC00\uB294 \uB370
      \uAF2D \uD544\uC694\uD55C \uC21C\uAC04\uC774 \uC544\uB2D0\uAE4C\uC694?"
    Ja: "\u304B\u308F\u3044\u3044\u52D5\u7269\u306E\u4EF2\u9593\u305F\u3061\u304C\u68EE\u3067\u30AD\u30E3\u30F3\u30D7\u3092\u697D\u3057\u3093\u3067\u3044\u307E\u3059\u3002\u6696\u304B\u3044\u711A\u304D\u706B\u3092\u56F2\u3093\u3067\u30DE\u30B7\u30E5\u30DE\u30ED\u3092\u713C\u304D\u3001\u30B3\u30B3\u30A2\u3092\u98F2\u307F\u306A\u304C\u3089\u7B11\u3044\u58F0\u304C\u7D76\u3048\u307E\u305B\u3093\u3002\u305F\u307E\u306B\u306F\u3053\u3046\u3057\u3066\u4F11\u3080\u3053\u3068\u3082\u3001\u751F\u304D\u3066\u3044\u304F\u3046\u3048\u3067\u5FC5\u8981\u306A\u77AC\u9593\u3067\u306F\u306A\u3044\u3067\u3057\u3087\u3046\u304B\u3002"
    Zh: "\u53EF\u7231\u7684\u52A8\u7269\u670B\u53CB\u4EEC\u6B63\u5728\u68EE\u6797\u91CC\u4EAB\u53D7\u9732\u8425\u3002\u5927\u5BB6\u56F4\u5750\u5728\u6E29\u6696\u7684\u7BDD\u706B\u65C1\uFF0C\u70E4\u7740\u68C9\u82B1\u7CD6\u3001\u559D\u7740\u53EF\u53EF\uFF0C\u7B11\u58F0\u4E0D\u65AD\u3002\u5076\u5C14\u50CF\u8FD9\u6837\u4F11\u606F\u4E00\u4E0B\uFF0C\u6216\u8BB8\u6B63\u662F\u751F\u6D3B\u4E2D\u4E0D\u53EF\u6216\u7F3A\u7684\u65F6\u523B\u5427\uFF1F"
    Vi: "Nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n \u0111\u1ED9ng v\u1EADt \u0111\xE1ng
      y\xEAu \u0111ang t\u1EADn h\u01B0\u1EDFng chuy\u1EBFn c\u1EAFm tr\u1EA1i trong
      r\u1EEBng. Qu\xE2y qu\u1EA7n b\xEAn \u0111\u1ED1ng l\u1EEDa \u1EA5m \xE1p,
      h\u1ECD n\u01B0\u1EDBng k\u1EB9o d\u1EBBo, nh\u1EA5m nh\xE1p ca cao v\xE0 c\u01B0\u1EDDi
      n\xF3i r\u1ED9n r\xE0ng. \u0110\xF4i khi, nh\u1EEFng ph\xFAt ngh\u1EC9 ng\u01A1i
      nh\u01B0 th\u1EBF n\xE0y ch\xEDnh l\xE0 \u0111i\u1EC1u ta c\u1EA7n trong cu\u1ED9c
      s\u1ED1ng, ph\u1EA3i kh\xF4ng?"
    Hi: "\u092A\u094D\u092F\u093E\u0930\u0947 \u091C\u093E\u0928\u0935\u0930 \u0926\u094B\u0938\u094D\u0924
      \u091C\u0902\u0917\u0932 \u092E\u0947\u0902 \u0915\u0948\u0902\u092A\u093F\u0902\u0917
      \u0915\u093E \u092E\u091C\u093C\u093E \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964
      \u0917\u0930\u094D\u092E \u0905\u0932\u093E\u0935 \u0915\u0947 \u091A\u093E\u0930\u094B\u0902
      \u0913\u0930 \u092C\u0948\u0920\u0915\u0930 \u0935\u0947 \u092E\u093E\u0930\u094D\u0936\u092E\u0948\u0932\u094B
      \u0938\u0947\u0902\u0915\u0924\u0947 \u0939\u0948\u0902, \u0915\u094B\u0915\u094B
      \u092A\u0940\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0916\u0942\u092C
      \u0939\u0901\u0938\u0940-\u0920\u093F\u0920\u094B\u0932\u0940 \u0915\u0930\u0924\u0947
      \u0939\u0948\u0902\u0964 \u0915\u092D\u0940-\u0915\u092D\u0940 \u0907\u0938
      \u0924\u0930\u0939 \u0906\u0930\u093E\u092E \u0915\u0930\u0928\u093E \u092D\u0940
      \u091C\u093C\u093F\u0902\u0926\u0917\u0940 \u091C\u0940\u0928\u0947 \u0915\u0947
      \u0932\u093F\u090F \u091C\u093C\u0930\u0942\u0930\u0940 \u092A\u0932 \u0939\u0948,
      \u0939\u0948 \u0928\u093E?"
    Ar: "\u0623\u0635\u062F\u0642\u0627\u0621 \u0627\u0644\u062D\u064A\u0648\u0627\u0646\u0627\u062A
      \u0627\u0644\u0644\u0637\u0641\u0627\u0621 \u064A\u0633\u062A\u0645\u062A\u0639\u0648\u0646
      \u0628\u0627\u0644\u062A\u062E\u064A\u064A\u0645 \u0641\u064A \u0627\u0644\u063A\u0627\u0628\u0629.
      \u064A\u062C\u0644\u0633\u0648\u0646 \u062D\u0648\u0644 \u0646\u0627\u0631
      \u0627\u0644\u0645\u062E\u064A\u0645 \u0627\u0644\u062F\u0627\u0641\u0626\u0629
      \u064A\u0634\u0648\u0648\u0646 \u062D\u0644\u0648\u0649 \u0627\u0644\u0645\u0627\u0631\u0634\u0645\u064A\u0644\u0648
      \u0648\u064A\u062D\u062A\u0633\u0648\u0646 \u0627\u0644\u0643\u0627\u0643\u0627\u0648
      \u0648\u0633\u0637 \u0627\u0644\u0636\u062D\u0643\u0627\u062A. \u0623\u0644\u0627
      \u062A\u0643\u0648\u0646 \u0644\u062D\u0638\u0627\u062A \u0627\u0644\u0631\u0627\u062D\u0629
      \u0643\u0647\u0630\u0647 \u0623\u062D\u064A\u0627\u0646\u064B\u0627 \u0645\u0627
      \u0646\u062D\u062A\u0627\u062C\u0647 \u0641\u0639\u0644\u064B\u0627 \u0641\u064A
      \u0627\u0644\u062D\u064A\u0627\u0629\u061F"
  - Key: 200122
    En: Friends have gathered in a cafe filled with the aroma of fresh coffee. They
      share cappuccinos and sweet cake while chatting away. With good friends around,
      even an ordinary afternoon becomes a special memory.
    Ko: "\uD5A5\uAE0B\uD55C \uCEE4\uD53C \uB0C4\uC0C8\uAC00 \uAC00\uB4DD\uD55C \uCE74\uD398\uC5D0
      \uCE5C\uAD6C\uB4E4\uC774 \uBAA8\uC600\uC2B5\uB2C8\uB2E4. \uCE74\uD478\uCE58\uB178\uC640
      \uB2EC\uCF64\uD55C \uCF00\uC774\uD06C\uB97C \uB098\uB204\uBA70 \uB3C4\uB780\uB3C4\uB780
      \uC774\uC57C\uAE30\uB97C \uB098\uB215\uB2C8\uB2E4. \uC88B\uC740 \uCE5C\uAD6C\uC640
      \uD568\uAED8\uB77C\uBA74 \uD3C9\uBC94\uD55C \uC624\uD6C4\uB3C4 \uD2B9\uBCC4\uD55C
      \uCD94\uC5B5\uC774 \uB429\uB2C8\uB2E4."
    Ja: "\u9999\u308A\u9AD8\u3044\u30B3\u30FC\u30D2\u30FC\u306E\u5302\u3044\u306B\u5305\u307E\u308C\u305F\u30AB\u30D5\u30A7\u306B\u53CB\u3060\u3061\u304C\u96C6\u307E\u308A\u307E\u3057\u305F\u3002\u30AB\u30D7\u30C1\u30FC\u30CE\u3068\u7518\u3044\u30B1\u30FC\u30AD\u3092\u5206\u3051\u5408\u3044\u306A\u304C\u3089\u3001\u304A\u3057\u3083\u3079\u308A\u306B\u82B1\u304C\u54B2\u304D\u307E\u3059\u3002\u826F\u3044\u53CB\u3060\u3061\u3068\u4E00\u7DD2\u306A\u3089\u3001\u3042\u308A\u3075\u308C\u305F\u5348\u5F8C\u3082\u7279\u5225\u306A\u601D\u3044\u51FA\u306B\u306A\u308A\u307E\u3059\u3002"
    Zh: "\u670B\u53CB\u4EEC\u76F8\u805A\u5728\u98D8\u6EE1\u5496\u5561\u9999\u6C14\u7684\u5496\u5561\u9986\u91CC\u3002\u5206\u4EAB\u7740\u5361\u5E03\u5947\u8BFA\u548C\u751C\u751C\u7684\u86CB\u7CD5\uFF0C\u4F60\u4E00\u8A00\u6211\u4E00\u8BED\u5730\u804A\u7740\u5929\u3002\u6709\u597D\u670B\u53CB\u76F8\u4F34\uFF0C\u5E73\u51E1\u7684\u5348\u540E\u4E5F\u80FD\u6210\u4E3A\u7279\u522B\u7684\u56DE\u5FC6\u3002"
    Vi: "Nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n t\u1EE5 h\u1ECDp trong qu\xE1n c\xE0
      ph\xEA th\u01A1m l\u1EEBng. H\u1ECD c\xF9ng nhau th\u01B0\u1EDFng th\u1EE9c
      cappuccino v\xE0 b\xE1nh ng\u1ECDt, r\xF4m r\u1EA3 chuy\u1EC7n tr\xF2. C\xF3
      b\u1EA1n t\u1ED1t b\xEAn c\u1EA1nh, m\u1ED9t bu\u1ED5i chi\u1EC1u b\xECnh th\u01B0\u1EDDng
      c\u0169ng h\xF3a th\xE0nh k\u1EF7 ni\u1EC7m \u0111\u1EB7c bi\u1EC7t."
    Hi: "\u0924\u093E\u091C\u093C\u0940 \u0915\u0949\u092B\u093C\u0940 \u0915\u0940
      \u0916\u0941\u0936\u092C\u0942 \u0938\u0947 \u092D\u0930\u0947 \u0915\u0948\u092B\u093C\u0947
      \u092E\u0947\u0902 \u0926\u094B\u0938\u094D\u0924 \u0907\u0915\u091F\u094D\u0920\u093E
      \u0939\u0941\u090F \u0939\u0948\u0902\u0964 \u0915\u0948\u092A\u0941\u091A\u0940\u0928\u094B
      \u0914\u0930 \u092E\u0940\u0920\u093E \u0915\u0947\u0915 \u092C\u093E\u0901\u091F\u0924\u0947
      \u0939\u0941\u090F \u0935\u0947 \u0916\u0942\u092C \u092C\u093E\u0924\u0947\u0902
      \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u091A\u094D\u091B\u0947
      \u0926\u094B\u0938\u094D\u0924\u094B\u0902 \u0915\u0947 \u0938\u093E\u0925
      \u0939\u094B \u0924\u094B \u0906\u092E \u0926\u094B\u092A\u0939\u0930 \u092D\u0940
      \u0916\u093E\u0938 \u092F\u093E\u0926 \u092C\u0928 \u091C\u093E\u0924\u0940
      \u0939\u0948\u0964"
    Ar: "\u0627\u062C\u062A\u0645\u0639 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0641\u064A \u0645\u0642\u0647\u0649 \u064A\u0641\u0648\u062D \u0628\u0639\u0628\u064A\u0631
      \u0627\u0644\u0642\u0647\u0648\u0629. \u064A\u062A\u0634\u0627\u0631\u0643\u0648\u0646
      \u0627\u0644\u0643\u0627\u0628\u062A\u0634\u064A\u0646\u0648 \u0648\u0627\u0644\u0643\u0639\u0643
      \u0627\u0644\u062D\u0644\u0648 \u0648\u064A\u062A\u0628\u0627\u062F\u0644\u0648\u0646
      \u0627\u0644\u0623\u062D\u0627\u062F\u064A\u062B \u0628\u0645\u0631\u062D.
      \u0645\u0639 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621 \u0627\u0644\u0637\u064A\u0628\u064A\u0646\u060C
      \u064A\u062A\u062D\u0648\u0644 \u062D\u062A\u0649 \u0627\u0644\u0638\u0647\u0631
      \u0627\u0644\u0639\u0627\u062F\u064A \u0625\u0644\u0649 \u0630\u0643\u0631\u0649
      \u0645\u0645\u064A\u0632\u0629."
  - Key: 200123
    En: On a spring day with pink cherry blossoms drifting through the air, the animal
      friends enjoy a picnic on a sunset-lit hill. They capture the moment with a
      camera, recording their happiness. It's a day of savoring a spring that is
      short but beautiful.
    Ko: "\uBD84\uD64D\uBE5B \uBC9A\uAF43\uC774 \uD769\uB0A0\uB9AC\uB294 \uBD04\uB0A0,
      \uB3D9\uBB3C \uCE5C\uAD6C\uB4E4\uC774 \uB178\uC744 \uC9C4 \uC5B8\uB355\uC5D0\uC11C
      \uD53C\uD06C\uB2C9\uC744 \uC990\uAE41\uB2C8\uB2E4. \uCE74\uBA54\uB77C\uB85C
      \uC774 \uC21C\uAC04\uC744 \uB2F4\uC73C\uBA70 \uD589\uBCF5\uC744 \uAE30\uB85D\uD569\uB2C8\uB2E4.
      \uC9E7\uC9C0\uB9CC \uC544\uB984\uB2E4\uC6B4 \uBD04\uC744 \uB9C8\uC74C\uAECF
      \uB9CC\uB07D\uD558\uB294 \uD558\uB8E8\uC785\uB2C8\uB2E4."
    Ja: "\u30D4\u30F3\u30AF\u306E\u685C\u304C\u821E\u3046\u6625\u306E\u65E5\u3001\u52D5\u7269\u306E\u4EF2\u9593\u305F\u3061\u306F\u5915\u713C\u3051\u306B\u67D3\u307E\u308B\u4E18\u3067\u30D4\u30AF\u30CB\u30C3\u30AF\u3092\u697D\u3057\u307F\u307E\u3059\u3002\u30AB\u30E1\u30E9\u3067\u3053\u306E\u77AC\u9593\u3092\u53CE\u3081\u3001\u5E78\u305B\u3092\u8A18\u9332\u3057\u307E\u3059\u3002\u77ED\u304F\u3082\u7F8E\u3057\u3044\u6625\u3092\u601D\u3044\u304D\u308A\u6E80\u55AB\u3059\u308B\u4E00\u65E5\u3067\u3059\u3002"
    Zh: "\u7C89\u8272\u6A31\u82B1\u98DE\u821E\u7684\u6625\u65E5\uFF0C\u52A8\u7269\u670B\u53CB\u4EEC\u5728\u67D3\u4E0A\u665A\u971E\u7684\u5C71\u4E18\u4E0A\u91CE\u9910\u3002\u4ED6\u4EEC\u7528\u76F8\u673A\u8BB0\u5F55\u4E0B\u8FD9\u4E00\u523B\u7684\u5E78\u798F\u3002\u8FD9\u662F\u5C3D\u60C5\u4EAB\u53D7\u77ED\u6682\u800C\u7F8E\u4E3D\u6625\u5929\u7684\u4E00\u5929\u3002"
    Vi: "V\xE0o ng\xE0y xu\xE2n hoa anh \u0111\xE0o h\u1ED3ng bay l\u1EA3 t\u1EA3,
      nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n \u0111\u1ED9ng v\u1EADt c\xF9ng d\xE3 ngo\u1EA1i
      tr\xEAn ng\u1ECDn \u0111\u1ED3i nhu\u1ED1m \xE1nh ho\xE0ng h\xF4n. H\u1ECD
      ghi l\u1EA1i kho\u1EA3nh kh\u1EAFc n\xE0y b\u1EB1ng m\xE1y \u1EA3nh, l\u01B0u
      gi\u1EEF ni\u1EC1m h\u1EA1nh ph\xFAc. \u0110\xF3 l\xE0 m\u1ED9t ng\xE0y t\u1EADn
      h\u01B0\u1EDFng tr\u1ECDn v\u1EB9n m\xF9a xu\xE2n ng\u1EAFn ng\u1EE7i m\xE0
      t\u01B0\u01A1i \u0111\u1EB9p."
    Hi: "\u0917\u0941\u0932\u093E\u092C\u0940 \u091A\u0947\u0930\u0940 \u092C\u094D\u0932\u0949\u0938\u092E
      \u092C\u093F\u0916\u0930\u0924\u0947 \u0935\u0938\u0902\u0924 \u0915\u0947
      \u0926\u093F\u0928, \u091C\u093E\u0928\u0935\u0930 \u0926\u094B\u0938\u094D\u0924
      \u0922\u0932\u0924\u0940 \u0927\u0942\u092A \u0935\u093E\u0932\u0940 \u092A\u0939\u093E\u0921\u093C\u0940
      \u092A\u0930 \u092A\u093F\u0915\u0928\u093F\u0915 \u0915\u093E \u0906\u0928\u0902\u0926
      \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u0948\u092E\u0930\u0947
      \u0938\u0947 \u0907\u0938 \u092A\u0932 \u0915\u094B \u0915\u0948\u0926 \u0915\u0930\u0915\u0947
      \u0935\u0947 \u0905\u092A\u0928\u0940 \u0916\u0941\u0936\u0940 \u0926\u0930\u094D\u091C
      \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092F\u0939 \u091B\u094B\u091F\u0947
      \u092E\u0917\u0930 \u0916\u0942\u092C\u0938\u0942\u0930\u0924 \u0935\u0938\u0902\u0924
      \u0915\u094B \u092D\u0930\u092A\u0942\u0930 \u091C\u0940\u0928\u0947 \u0915\u093E
      \u0926\u093F\u0928 \u0939\u0948\u0964"
    Ar: "\u0641\u064A \u064A\u0648\u0645 \u0631\u0628\u064A\u0639\u064A \u062A\u062A\u0637\u0627\u064A\u0631
      \u0641\u064A\u0647 \u0623\u0632\u0647\u0627\u0631 \u0627\u0644\u0643\u0631\u0632
      \u0627\u0644\u0648\u0631\u062F\u064A\u0629\u060C \u064A\u0633\u062A\u0645\u062A\u0639
      \u0623\u0635\u062F\u0642\u0627\u0621 \u0627\u0644\u062D\u064A\u0648\u0627\u0646\u0627\u062A
      \u0628\u0646\u0632\u0647\u0629 \u0639\u0644\u0649 \u062A\u0644\u0629 \u064A\u063A\u0645\u0631\u0647\u0627
      \u0636\u0648\u0621 \u0627\u0644\u063A\u0631\u0648\u0628. \u064A\u0644\u062A\u0642\u0637\u0648\u0646
      \u0647\u0630\u0647 \u0627\u0644\u0644\u062D\u0638\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u064A\u0631\u0627
      \u0648\u064A\u0648\u062B\u0642\u0648\u0646 \u0633\u0639\u0627\u062F\u062A\u0647\u0645.
      \u0625\u0646\u0647 \u064A\u0648\u0645 \u0644\u0644\u0627\u0633\u062A\u0645\u062A\u0627\u0639
      \u0628\u0631\u0628\u064A\u0639 \u0642\u0635\u064A\u0631 \u0644\u0643\u0646\u0647
      \u0628\u062F\u064A\u0639."
  - Key: 200124
    En: Against a backdrop of majestic mountains, the friends climb with all their
      strength. Leaning on their trekking poles, they push toward the summit one
      step at a time. Together, even a steep trail becomes a joyful adventure.
    Ko: "\uC6C5\uC7A5\uD55C \uC0B0\uB9E5\uC744 \uBC30\uACBD\uC73C\uB85C \uCE5C\uAD6C\uB4E4\uC774
      \uD798\uCC28\uAC8C \uC0B0\uC744 \uC624\uB985\uB2C8\uB2E4. \uB4F1\uC0B0 \uC2A4\uD2F1\uC744
      \uC9DA\uACE0 \uD55C \uAC78\uC74C\uC529 \uC815\uC0C1\uC744 \uD5A5\uD574 \uB098\uC544\uAC11\uB2C8\uB2E4.
      \uD568\uAED8\uB77C\uBA74 \uAC00\uD30C\uB978 \uAE38\uB3C4 \uC990\uAC70\uC6B4
      \uBAA8\uD5D8\uC774 \uB429\uB2C8\uB2E4."
    Ja: "\u96C4\u5927\u306A\u5C71\u4E26\u307F\u3092\u80CC\u306B\u3001\u4EF2\u9593\u305F\u3061\u306F\u529B\u5F37\u304F\u5C71\u3092\u767B\u308A\u307E\u3059\u3002\u30C8\u30EC\u30C3\u30AD\u30F3\u30B0\u30DD\u30FC\u30EB\u3092\u3064\u304D\u306A\u304C\u3089\u3001\u4E00\u6B69\u305A\u3064\u9802\u4E0A\u3092\u76EE\u6307\u3057\u307E\u3059\u3002\u4E00\u7DD2\u306A\u3089\u967A\u3057\u3044\u9053\u3082\u697D\u3057\u3044\u5192\u967A\u306B\u306A\u308A\u307E\u3059\u3002"
    Zh: "\u4EE5\u96C4\u4F1F\u7684\u5C71\u8109\u4E3A\u80CC\u666F\uFF0C\u670B\u53CB\u4EEC\u594B\u529B\u5411\u4E0A\u6500\u767B\u3002\u4ED6\u4EEC\u62C4\u7740\u767B\u5C71\u6756\uFF0C\u4E00\u6B65\u4E00\u6B65\u8D70\u5411\u5C71\u9876\u3002\u53EA\u8981\u5728\u4E00\u8D77\uFF0C\u9661\u5CED\u7684\u5C71\u8DEF\u4E5F\u4F1A\u53D8\u6210\u5FEB\u4E50\u7684\u5192\u9669\u3002"
    Vi: "Tr\xEAn n\u1EC1n d\xE3y n\xFAi h\xF9ng v\u0129, nh\u1EEFng ng\u01B0\u1EDDi
      b\u1EA1n h\u0103ng h\xE1i leo l\xEAn. Ch\u1ED1ng g\u1EADy leo n\xFAi, h\u1ECD
      t\u1EEBng b\u01B0\u1EDBc ti\u1EBFn v\u1EC1 ph\xEDa \u0111\u1EC9nh. C\xF3 nhau,
      con \u0111\u01B0\u1EDDng d\u1ED1c c\u0169ng tr\u1EDF th\xE0nh cu\u1ED9c phi\xEAu
      l\u01B0u th\xFA v\u1ECB."
    Hi: "\u092D\u0935\u094D\u092F \u092A\u0930\u094D\u0935\u0924 \u0936\u094D\u0930\u0943\u0902\u0916\u0932\u093E\u0913\u0902
      \u0915\u0940 \u092A\u0943\u0937\u094D\u0920\u092D\u0942\u092E\u093F \u092E\u0947\u0902
      \u0926\u094B\u0938\u094D\u0924 \u092A\u0942\u0930\u0947 \u091C\u094B\u0936
      \u0938\u0947 \u092A\u0939\u093E\u0921\u093C \u091A\u0922\u093C\u0924\u0947
      \u0939\u0948\u0902\u0964 \u091F\u094D\u0930\u0947\u0915\u093F\u0902\u0917 \u0938\u094D\u091F\u093F\u0915
      \u0915\u0947 \u0938\u0939\u093E\u0930\u0947 \u0935\u0947 \u0915\u0926\u092E-\u0926\u0930-\u0915\u0926\u092E
      \u0936\u093F\u0916\u0930 \u0915\u0940 \u0913\u0930 \u092C\u0922\u093C\u0924\u0947
      \u0939\u0948\u0902\u0964 \u0938\u093E\u0925 \u0939\u094B\u0902 \u0924\u094B
      \u091A\u0922\u093C\u093E\u0908 \u092D\u0930\u093E \u0930\u093E\u0938\u094D\u0924\u093E
      \u092D\u0940 \u092E\u091C\u093C\u0947\u0926\u093E\u0930 \u0930\u094B\u092E\u093E\u0902\u091A
      \u092C\u0928 \u091C\u093E\u0924\u093E \u0939\u0948\u0964"
    Ar: "\u0639\u0644\u0649 \u062E\u0644\u0641\u064A\u0629 \u062C\u0628\u0627\u0644
      \u0634\u0627\u0645\u062E\u0629\u060C \u064A\u062A\u0633\u0644\u0642 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0628\u0643\u0644 \u0639\u0632\u064A\u0645\u0629. \u064A\u0633\u062A\u0646\u062F\u0648\u0646
      \u0625\u0644\u0649 \u0639\u0635\u064A \u0627\u0644\u062A\u0633\u0644\u0642
      \u0648\u064A\u062A\u0642\u062F\u0645\u0648\u0646 \u062E\u0637\u0648\u0629 \u0628\u062E\u0637\u0648\u0629
      \u0646\u062D\u0648 \u0627\u0644\u0642\u0645\u0629. \u0645\u0639\u064B\u0627\u060C
      \u064A\u062A\u062D\u0648\u0644 \u062D\u062A\u0649 \u0627\u0644\u0637\u0631\u064A\u0642
      \u0627\u0644\u0648\u0639\u0631 \u0625\u0644\u0649 \u0645\u063A\u0627\u0645\u0631\u0629
      \u0645\u0645\u062A\u0639\u0629."
  - Key: 200125
    En: In the sweltering summer heat, they sit in the breeze of a fan and bite into
      cool watermelon. One mouthful of the red, sweet fruit chases the heat right
      away. It's a simple yet perfectly summery moment of happiness.
    Ko: "\uBB34\uB354\uC6B4 \uC5EC\uB984, \uC120\uD48D\uAE30 \uBC14\uB78C\uC744 \uC42C\uBA70
      \uC2DC\uC6D0\uD55C \uC218\uBC15\uC744 \uBCA0\uC5B4 \uBB45\uB2C8\uB2E4. \uBE68\uAC1B\uACE0
      \uB2EC\uCF64\uD55C \uC218\uBC15 \uD55C \uC785\uC5D0 \uB354\uC704\uAC00 \uC2F9
      \uAC00\uC2ED\uB2C8\uB2E4. \uC18C\uBC15\uD558\uC9C0\uB9CC \uAC00\uC7A5 \uC5EC\uB984\uB2E4\uC6B4
      \uD589\uBCF5\uC758 \uC21C\uAC04\uC785\uB2C8\uB2E4."
    Ja: "\u84B8\u3057\u6691\u3044\u590F\u3001\u6247\u98A8\u6A5F\u306E\u98A8\u306B\u3042\u305F\u308A\u306A\u304C\u3089\u51B7\u305F\u3044\u30B9\u30A4\u30AB\u306B\u304B\u3076\u308A\u3064\u304D\u307E\u3059\u3002\u8D64\u304F\u3066\u7518\u3044\u30B9\u30A4\u30AB\u3092\u3072\u3068\u53E3\u98DF\u3079\u308C\u3070\u3001\u6691\u3055\u3082\u3059\u3063\u304D\u308A\u5439\u304D\u98DB\u3073\u307E\u3059\u3002\u7D20\u6734\u3060\u3051\u308C\u3069\u3001\u6700\u3082\u590F\u3089\u3057\u3044\u5E78\u305B\u306E\u77AC\u9593\u3067\u3059\u3002"
    Zh: "\u708E\u708E\u590F\u65E5\uFF0C\u5439\u7740\u98CE\u6247\u54AC\u4E0A\u4E00\u53E3\u51B0\u51C9\u7684\u897F\u74DC\u3002\u7EA2\u6DA6\u9999\u751C\u7684\u897F\u74DC\u4E00\u5165\u53E3\uFF0C\u6691\u6C14\u77AC\u95F4\u6D88\u6563\u3002\u8FD9\u662F\u6734\u7D20\u5374\u6700\u6709\u590F\u5929\u5473\u9053\u7684\u5E78\u798F\u65F6\u523B\u3002"
    Vi: "Gi\u1EEFa m\xF9a h\xE8 oi \u1EA3, h\u1ECD ng\u1ED3i h\xF3ng qu\u1EA1t v\xE0
      c\u1EAFn m\u1ED9t mi\u1EBFng d\u01B0a h\u1EA5u m\xE1t l\u1EA1nh. Ch\u1EC9 m\u1ED9t
      mi\u1EBFng d\u01B0a \u0111\u1ECF ng\u1ECDt l\u1ECBm c\u0169ng \u0111\u1EE7
      xua tan c\xE1i n\xF3ng. \u0110\xF3 l\xE0 kho\u1EA3nh kh\u1EAFc h\u1EA1nh ph\xFAc
      gi\u1EA3n d\u1ECB nh\u01B0ng \u0111\u1EADm ch\u1EA5t m\xF9a h\xE8 nh\u1EA5t."
    Hi: "\u0924\u092A\u0924\u0940 \u0917\u0930\u094D\u092E\u0940 \u092E\u0947\u0902
      \u092A\u0902\u0916\u0947 \u0915\u0940 \u0939\u0935\u093E \u0932\u0947\u0924\u0947
      \u0939\u0941\u090F \u0935\u0947 \u0920\u0902\u0921\u093E \u0924\u0930\u092C\u0942\u091C\u093C
      \u0915\u093E\u091F\u0915\u0930 \u0916\u093E\u0924\u0947 \u0939\u0948\u0902\u0964
      \u0932\u093E\u0932 \u0914\u0930 \u092E\u0940\u0920\u0947 \u0924\u0930\u092C\u0942\u091C\u093C
      \u0915\u093E \u090F\u0915 \u091F\u0941\u0915\u0921\u093C\u093E \u0939\u0940
      \u0917\u0930\u094D\u092E\u0940 \u092D\u0917\u093E \u0926\u0947\u0924\u093E
      \u0939\u0948\u0964 \u092F\u0939 \u0938\u093E\u0926\u093E \u092E\u0917\u0930
      \u0938\u092C\u0938\u0947 \u0917\u0930\u094D\u092E\u093F\u092F\u094B\u0902 \u091C\u0948\u0938\u093E
      \u0916\u0941\u0936\u0940 \u0915\u093E \u092A\u0932 \u0939\u0948\u0964"
    Ar: "\u0641\u064A \u062D\u0631\u0651 \u0627\u0644\u0635\u064A\u0641 \u0627\u0644\u0634\u062F\u064A\u062F\u060C
      \u064A\u062C\u0644\u0633\u0648\u0646 \u0623\u0645\u0627\u0645 \u0627\u0644\u0645\u0631\u0648\u062D\u0629
      \u0648\u064A\u0642\u0636\u0645\u0648\u0646 \u0628\u0637\u064A\u062E\u064B\u0627
      \u0628\u0627\u0631\u062F\u064B\u0627. \u0642\u0636\u0645\u0629 \u0648\u0627\u062D\u062F\u0629
      \u0645\u0646 \u0627\u0644\u0628\u0637\u064A\u062E \u0627\u0644\u0623\u062D\u0645\u0631
      \u0627\u0644\u062D\u0644\u0648 \u062A\u064F\u0630\u0647\u0628 \u0627\u0644\u062D\u0631\u0651
      \u062A\u0645\u0627\u0645\u064B\u0627. \u0644\u062D\u0638\u0629 \u0633\u0639\u0627\u062F\u0629
      \u0628\u0633\u064A\u0637\u0629 \u0644\u0643\u0646\u0647\u0627 \u0623\u0643\u062B\u0631
      \u0645\u0627 \u064A\u0634\u0628\u0647 \u0627\u0644\u0635\u064A\u0641."
  - Key: 200126
    En: Under a sky pouring with stars, the friends gather around the campfire. Twinkling
      string lights and dancing flames create a warm atmosphere. As the night deepens,
      their cozy conversation goes on and on.
    Ko: "\uBCC4\uC774 \uC3DF\uC544\uC9C0\uB294 \uBC24, \uCE5C\uAD6C\uB4E4\uC774 \uBAA8\uB2E5\uBD88
      \uC8FC\uC704\uC5D0 \uBAA8\uC5EC \uC549\uC558\uC2B5\uB2C8\uB2E4. \uBC18\uC9DD\uC774\uB294
      \uC804\uAD6C \uC7A5\uC2DD\uACFC \uD0C0\uC624\uB974\uB294 \uBD88\uAF43\uC774
      \uB530\uB73B\uD55C \uBD84\uC704\uAE30\uB97C \uC790\uC544\uB0C5\uB2C8\uB2E4.
      \uAE4A\uC5B4\uAC00\uB294 \uBC24, \uB3C4\uB780\uB3C4\uB780 \uB098\uB204\uB294
      \uC774\uC57C\uAE30\uAC00 \uB05D\uC5C6\uC774 \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
    Ja: "\u661F\u304C\u964D\u308A\u6CE8\u3050\u591C\u3001\u4EF2\u9593\u305F\u3061\u306F\u711A\u304D\u706B\u306E\u307E\u308F\u308A\u306B\u96C6\u307E\u308A\u307E\u3057\u305F\u3002\u304D\u3089\u3081\u304F\u96FB\u98FE\u3068\u71C3\u3048\u308B\u708E\u304C\u6E29\u304B\u306A\u96F0\u56F2\u6C17\u3092\u4F5C\u308A\u51FA\u3057\u307E\u3059\u3002\u591C\u304C\u66F4\u3051\u3066\u3082\u3001\u8A9E\u308A\u5408\u3046\u8A71\u306F\u5C3D\u304D\u307E\u305B\u3093\u3002"
    Zh: "\u7E41\u661F\u6D12\u843D\u7684\u591C\u665A\uFF0C\u670B\u53CB\u4EEC\u56F4\u5750\u5728\u7BDD\u706B\u65C1\u3002\u95EA\u70C1\u7684\u706F\u4E32\u548C\u8DF3\u52A8\u7684\u706B\u7130\u8425\u9020\u51FA\u6E29\u6696\u7684\u6C1B\u56F4\u3002\u591C\u8272\u6E10\u6DF1\uFF0C\u8F7B\u58F0\u7EC6\u8BED\u7684\u8BDD\u9898\u5374\u7EF5\u5EF6\u4E0D\u65AD\u3002"
    Vi: "Trong \u0111\xEAm \u0111\u1EA7y sao, nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n
      qu\xE2y qu\u1EA7n b\xEAn \u0111\u1ED1ng l\u1EEDa tr\u1EA1i. D\xE2y \u0111\xE8n
      l\u1EA5p l\xE1nh v\xE0 ng\u1ECDn l\u1EEDa b\u1EADp b\xF9ng t\u1EA1o n\xEAn
      b\u1EA7u kh\xF4ng kh\xED \u1EA5m \xE1p. \u0110\xEAm c\xE0ng khuya, nh\u1EEFng
      c\xE2u chuy\u1EC7n th\u1EE7 th\u1EC9 c\xE0ng k\xE9o d\xE0i m\xE3i."
    Hi: "\u0924\u093E\u0930\u094B\u0902 \u0938\u0947 \u092D\u0930\u0940 \u0930\u093E\u0924
      \u092E\u0947\u0902 \u0926\u094B\u0938\u094D\u0924 \u0905\u0932\u093E\u0935
      \u0915\u0947 \u091A\u093E\u0930\u094B\u0902 \u0913\u0930 \u092C\u0948\u0920\u0947
      \u0939\u0948\u0902\u0964 \u091D\u093F\u0932\u092E\u093F\u0932\u093E\u0924\u0940
      \u0932\u0921\u093C\u093F\u092F\u093E\u0901 \u0914\u0930 \u0932\u092A\u0915\u0924\u0940
      \u0932\u092A\u091F\u0947\u0902 \u0917\u0930\u094D\u092E\u091C\u094B\u0936\u0940
      \u092D\u0930\u093E \u092E\u093E\u0939\u094C\u0932 \u092C\u0928\u093E\u0924\u0940
      \u0939\u0948\u0902\u0964 \u0930\u093E\u0924 \u0917\u0939\u0930\u093E\u0924\u0940
      \u091C\u093E\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0909\u0928\u0915\u0940
      \u092C\u093E\u0924\u0947\u0902 \u0916\u0924\u094D\u092E \u0939\u0940 \u0928\u0939\u0940\u0902
      \u0939\u094B\u0924\u0940\u0902\u0964"
    Ar: "\u0641\u064A \u0644\u064A\u0644\u0629 \u062A\u062A\u0633\u0627\u0642\u0637
      \u0641\u064A\u0647\u0627 \u0627\u0644\u0646\u062C\u0648\u0645\u060C \u064A\u062C\u062A\u0645\u0639
      \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621 \u062D\u0648\u0644 \u0646\u0627\u0631
      \u0627\u0644\u0645\u062E\u064A\u0645. \u0627\u0644\u0623\u0636\u0648\u0627\u0621
      \u0627\u0644\u0645\u062A\u0644\u0623\u0644\u0626\u0629 \u0648\u0627\u0644\u0644\u0647\u0628
      \u0627\u0644\u0645\u062A\u0631\u0627\u0642\u0635 \u064A\u0635\u0646\u0639\u0627\u0646
      \u0623\u062C\u0648\u0627\u0621 \u062F\u0627\u0641\u0626\u0629. \u0648\u0645\u0639
      \u062A\u0639\u0645\u0651\u0642 \u0627\u0644\u0644\u064A\u0644\u060C \u062A\u062A\u0648\u0627\u0635\u0644
      \u0623\u062D\u0627\u062F\u064A\u062B\u0647\u0645 \u0627\u0644\u0647\u0627\u062F\u0626\u0629
      \u0628\u0644\u0627 \u0646\u0647\u0627\u064A\u0629."
  - Key: 200127
    En: With oxygen tanks on their backs, they set off scuba diving into the deep
      sea. Among the colorful fish, they spot a glittering treasure chest. It's a
      thrilling adventure offered by the unknown world beneath the waves.
    Ko: "\uC0B0\uC18C\uD1B5\uC744 \uBA54\uACE0 \uAE4A\uC740 \uBC14\uB2F7\uC18D\uC73C\uB85C
      \uC2A4\uCFE0\uBC84 \uB2E4\uC774\uBE59\uC744 \uB5A0\uB0A9\uB2C8\uB2E4. \uC54C\uB85D\uB2EC\uB85D\uD55C
      \uBB3C\uACE0\uAE30\uB4E4 \uC0AC\uC774\uB85C \uBC18\uC9DD\uC774\uB294 \uBCF4\uBB3C
      \uC0C1\uC790\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4. \uBBF8\uC9C0\uC758
      \uBC14\uB2E4 \uC138\uACC4\uAC00 \uC120\uC0AC\uD558\uB294 \uC9DC\uB9BF\uD55C
      \uBAA8\uD5D8\uC785\uB2C8\uB2E4."
    Ja: "\u9178\u7D20\u30DC\u30F3\u30D9\u3092\u80CC\u8CA0\u3063\u3066\u6DF1\u3044\u6D77\u3078\u30B9\u30AD\u30E5\u30FC\u30D0\u30C0\u30A4\u30D3\u30F3\u30B0\u306B\u51FA\u304B\u3051\u307E\u3059\u3002\u8272\u3068\u308A\u3069\u308A\u306E\u9B5A\u305F\u3061\u306E\u9593\u3067\u3001\u304D\u3089\u3081\u304F\u5B9D\u7BB1\u3092\u898B\u3064\u3051\u307E\u3057\u305F\u3002\u672A\u77E5\u306E\u6D77\u306E\u4E16\u754C\u304C\u8D08\u308B\u30B9\u30EA\u30EB\u6E80\u70B9\u306E\u5192\u967A\u3067\u3059\u3002"
    Zh: "\u80CC\u4E0A\u6C27\u6C14\u74F6\uFF0C\u6F5C\u5165\u6DF1\u6DF1\u7684\u6D77\u5E95\u5C55\u5F00\u6C34\u80BA\u6F5C\u6C34\u3002\u5728\u4E94\u5F69\u6591\u6593\u7684\u9C7C\u7FA4\u4E4B\u95F4\uFF0C\u53D1\u73B0\u4E86\u95EA\u95EA\u53D1\u5149\u7684\u5B9D\u7BB1\u3002\u8FD9\u662F\u672A\u77E5\u6D77\u6D0B\u4E16\u754C\u5E26\u6765\u7684\u523A\u6FC0\u5192\u9669\u3002"
    Vi: "\u0110eo b\xECnh d\u01B0\u1EE1ng kh\xED, h\u1ECD l\u1EB7n xu\u1ED1ng l\xF2ng
      \u0111\u1EA1i d\u01B0\u01A1ng s\xE2u th\u1EB3m. Gi\u1EEFa \u0111\xE0n c\xE1
      \u0111\u1EE7 s\u1EAFc m\xE0u, h\u1ECD ph\xE1t hi\u1EC7n m\u1ED9t r\u01B0\u01A1ng
      b\xE1u l\u1EA5p l\xE1nh. \u0110\xF3 l\xE0 cu\u1ED9c phi\xEAu l\u01B0u \u0111\u1EA7y
      ph\u1EA5n kh\xEDch m\xE0 th\u1EBF gi\u1EDBi \u0111\u1EA1i d\u01B0\u01A1ng b\xED
      \u1EA9n mang l\u1EA1i."
    Hi: "\u0911\u0915\u094D\u0938\u0940\u091C\u0928 \u091F\u0948\u0902\u0915 \u092A\u0940\u0920
      \u092A\u0930 \u0932\u093E\u0926\u0915\u0930 \u0935\u0947 \u0917\u0939\u0930\u0947
      \u0938\u092E\u0941\u0926\u094D\u0930 \u092E\u0947\u0902 \u0938\u094D\u0915\u0942\u092C\u093E
      \u0921\u093E\u0907\u0935\u093F\u0902\u0917 \u092A\u0930 \u0928\u093F\u0915\u0932\u0924\u0947
      \u0939\u0948\u0902\u0964 \u0930\u0902\u0917-\u092C\u093F\u0930\u0902\u0917\u0940
      \u092E\u091B\u0932\u093F\u092F\u094B\u0902 \u0915\u0947 \u092C\u0940\u091A
      \u0909\u0928\u094D\u0939\u0947\u0902 \u091A\u092E\u0915\u0924\u093E \u0916\u091C\u093C\u093E\u0928\u0947
      \u0915\u093E \u0938\u0902\u0926\u0942\u0915 \u092E\u093F\u0932 \u091C\u093E\u0924\u093E
      \u0939\u0948\u0964 \u092F\u0939 \u0905\u0928\u091C\u093E\u0928\u0947 \u0938\u092E\u0941\u0926\u094D\u0930\u0940
      \u0938\u0902\u0938\u093E\u0930 \u0915\u093E \u0930\u094B\u092E\u093E\u0902\u091A\u0915
      \u0938\u093E\u0939\u0938\u093F\u0915 \u0938\u092B\u093C\u0930 \u0939\u0948\u0964"
    Ar: "\u064A\u062D\u0645\u0644\u0648\u0646 \u0623\u0633\u0637\u0648\u0627\u0646\u0627\u062A
      \u0627\u0644\u0623\u0643\u0633\u062C\u064A\u0646 \u0648\u064A\u0646\u0637\u0644\u0642\u0648\u0646
      \u0644\u0644\u063A\u0648\u0635 \u0641\u064A \u0623\u0639\u0645\u0627\u0642
      \u0627\u0644\u0628\u062D\u0631. \u0648\u0628\u064A\u0646 \u0627\u0644\u0623\u0633\u0645\u0627\u0643
      \u0627\u0644\u0645\u0644\u0648\u0651\u0646\u0629\u060C \u0639\u062B\u0631\u0648\u0627
      \u0639\u0644\u0649 \u0635\u0646\u062F\u0648\u0642 \u0643\u0646\u0632 \u064A\u062A\u0644\u0623\u0644\u0623.
      \u0625\u0646\u0647\u0627 \u0645\u063A\u0627\u0645\u0631\u0629 \u0645\u062B\u064A\u0631\u0629
      \u064A\u0647\u062F\u064A\u0647\u0627 \u0639\u0627\u0644\u0645 \u0627\u0644\u0628\u062D\u0631
      \u0627\u0644\u0645\u062C\u0647\u0648\u0644."
  - Key: 200128
    En: Wearing chef's hats, the friends gather in the kitchen to bake cookies. They
      roll out the dough and press out shapes, making treats with care. Cookies made
      by hand are sweeter and warmer than anything else.
    Ko: "\uC694\uB9AC\uC0AC \uBAA8\uC790\uB97C \uC4F4 \uCE5C\uAD6C\uB4E4\uC774 \uC8FC\uBC29\uC5D0
      \uBAA8\uC5EC \uCFE0\uD0A4\uB97C \uAD7D\uC2B5\uB2C8\uB2E4. \uBC18\uC8FD\uC744
      \uBC00\uACE0 \uBAA8\uC591\uC744 \uCC0D\uC73C\uBA70 \uC815\uC131\uAECF \uAC04\uC2DD\uC744
      \uB9CC\uB4ED\uB2C8\uB2E4. \uC9C1\uC811 \uB9CC\uB4E0 \uCFE0\uD0A4\uB294 \uADF8
      \uC5B4\uB5A4 \uAC83\uBCF4\uB2E4 \uB2EC\uCF64\uD558\uACE0 \uB530\uB73B\uD569\uB2C8\uB2E4."
    Ja: "\u30B3\u30C3\u30AF\u5E3D\u3092\u304B\u3076\u3063\u305F\u4EF2\u9593\u305F\u3061\u304C\u30AD\u30C3\u30C1\u30F3\u306B\u96C6\u307E\u3063\u3066\u30AF\u30C3\u30AD\u30FC\u3092\u713C\u304D\u307E\u3059\u3002\u751F\u5730\u3092\u306E\u3070\u3057\u3066\u578B\u3092\u629C\u304D\u3001\u5FC3\u3092\u8FBC\u3081\u3066\u304A\u3084\u3064\u3092\u4F5C\u308A\u307E\u3059\u3002\u624B\u4F5C\u308A\u306E\u30AF\u30C3\u30AD\u30FC\u306F\u4F55\u3088\u308A\u3082\u7518\u304F\u3066\u6E29\u304B\u3044\u3067\u3059\u3002"
    Zh: "\u6234\u7740\u53A8\u5E08\u5E3D\u7684\u670B\u53CB\u4EEC\u805A\u5728\u53A8\u623F\u91CC\u70E4\u997C\u5E72\u3002\u4ED6\u4EEC\u64C0\u5F00\u9762\u56E2\u3001\u538B\u51FA\u5F62\u72B6\uFF0C\u7528\u5FC3\u5236\u4F5C\u70B9\u5FC3\u3002\u4EB2\u624B\u505A\u7684\u997C\u5E72\uFF0C\u6BD4\u4EC0\u4E48\u90FD\u9999\u751C\u6E29\u6696\u3002"
    Vi: "\u0110\u1ED9i m\u0169 \u0111\u1EA7u b\u1EBFp, nh\u1EEFng ng\u01B0\u1EDDi
      b\u1EA1n t\u1EE5 h\u1ECDp trong b\u1EBFp \u0111\u1EC3 n\u01B0\u1EDBng b\xE1nh
      quy. H\u1ECD c\xE1n b\u1ED9t, c\u1EAFt h\xECnh v\xE0 t\u1EC9 m\u1EC9 l\xE0m
      ra m\xF3n \u0103n v\u1EB7t. B\xE1nh quy t\u1EF1 tay l\xE0m bao gi\u1EDD c\u0169ng
      ng\u1ECDt ng\xE0o v\xE0 \u1EA5m \xE1p h\u01A1n t\u1EA5t th\u1EA3y."
    Hi: "\u0936\u0947\u092B \u0915\u0940 \u091F\u094B\u092A\u0940 \u092A\u0939\u0928\u0947
      \u0926\u094B\u0938\u094D\u0924 \u0930\u0938\u094B\u0908 \u092E\u0947\u0902
      \u091C\u092E\u093E \u0939\u094B\u0915\u0930 \u0915\u0941\u0915\u0940\u091C\u093C
      \u092C\u0928\u093E\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u091F\u093E
      \u092C\u0947\u0932\u0915\u0930 \u0914\u0930 \u0906\u0915\u093E\u0930 \u0915\u093E\u091F\u0915\u0930
      \u0935\u0947 \u092C\u0921\u093C\u0947 \u091C\u0924\u0928 \u0938\u0947 \u0928\u093E\u0936\u094D\u0924\u093E
      \u0924\u0948\u092F\u093E\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964
      \u0905\u092A\u0928\u0947 \u0939\u093E\u0925\u094B\u0902 \u0938\u0947 \u092C\u0928\u0940
      \u0915\u0941\u0915\u0940\u091C\u093C \u0939\u0930 \u091A\u0940\u091C\u093C
      \u0938\u0947 \u091C\u093C\u094D\u092F\u093E\u0926\u093E \u092E\u0940\u0920\u0940
      \u0914\u0930 \u0917\u0930\u094D\u092E\u091C\u094B\u0936\u0940 \u092D\u0930\u0940
      \u0939\u094B\u0924\u0940 \u0939\u0948\u0902\u0964"
    Ar: "\u064A\u0631\u062A\u062F\u0648\u0646 \u0642\u0628\u0639\u0627\u062A \u0627\u0644\u0637\u0647\u0627\u0629
      \u0648\u064A\u062C\u062A\u0645\u0639\u0648\u0646 \u0641\u064A \u0627\u0644\u0645\u0637\u0628\u062E
      \u0644\u062E\u0628\u0632 \u0627\u0644\u0643\u0648\u0643\u064A\u0632. \u064A\u0641\u0631\u062F\u0648\u0646
      \u0627\u0644\u0639\u062C\u064A\u0646 \u0648\u064A\u0642\u0637\u0639\u0648\u0646\u0647
      \u0628\u0623\u0634\u0643\u0627\u0644\u060C \u0648\u064A\u0635\u0646\u0639\u0648\u0646
      \u0627\u0644\u062D\u0644\u0648\u0649 \u0628\u0639\u0646\u0627\u064A\u0629.
      \u0627\u0644\u0643\u0648\u0643\u064A\u0632 \u0627\u0644\u0645\u0635\u0646\u0648\u0639
      \u0628\u0627\u0644\u064A\u062F \u0623\u062D\u0644\u0649 \u0648\u0623\u062F\u0641\u0623
      \u0645\u0646 \u0623\u064A \u0634\u064A\u0621 \u0622\u062E\u0631."
  - Key: 200129
    En: In a room with a vintage vibe, the friends dance to their hearts' content.
      Dressed in their finest, they let the rhythm carry them away. With music playing,
      anyone can be the best dancer in the room.
    Ko: "\uBE48\uD2F0\uC9C0\uD55C \uBD84\uC704\uAE30\uC758 \uACF5\uAC04\uC5D0\uC11C
      \uCE5C\uAD6C\uB4E4\uC774 \uD765\uACB9\uAC8C \uCDA4\uC744 \uCDA5\uB2C8\uB2E4.
      \uBA4B\uC9C4 \uC637\uC744 \uCC28\uB824\uC785\uACE0 \uB9AC\uB4EC\uC5D0 \uBAB8\uC744
      \uB9E1\uAE41\uB2C8\uB2E4. \uC74C\uC545\uACFC \uD568\uAED8\uB77C\uBA74 \uB204\uAD6C\uB098
      \uCD5C\uACE0\uC758 \uB304\uC11C\uAC00 \uB429\uB2C8\uB2E4."
    Ja: "\u30D3\u30F3\u30C6\u30FC\u30B8\u306A\u96F0\u56F2\u6C17\u306E\u7A7A\u9593\u3067\u3001\u4EF2\u9593\u305F\u3061\u306F\u697D\u3057\u305D\u3046\u306B\u8E0A\u308A\u307E\u3059\u3002\u304A\u3057\u3083\u308C\u306A\u670D\u3092\u7740\u3066\u3001\u30EA\u30BA\u30E0\u306B\u8EAB\u3092\u3086\u3060\u306D\u307E\u3059\u3002\u97F3\u697D\u3055\u3048\u3042\u308C\u3070\u3001\u8AB0\u3060\u3063\u3066\u6700\u9AD8\u306E\u30C0\u30F3\u30B5\u30FC\u306B\u306A\u308C\u307E\u3059\u3002"
    Zh: "\u5728\u5145\u6EE1\u590D\u53E4\u6C14\u606F\u7684\u7A7A\u95F4\u91CC\uFF0C\u670B\u53CB\u4EEC\u5C3D\u60C5\u8D77\u821E\u3002\u4ED6\u4EEC\u7A7F\u4E0A\u6F02\u4EAE\u7684\u8863\u88F3\uFF0C\u968F\u7740\u8282\u594F\u6446\u52A8\u8EAB\u4F53\u3002\u53EA\u8981\u6709\u97F3\u4E50\u76F8\u4F34\uFF0C\u8C01\u90FD\u80FD\u6210\u4E3A\u6700\u68D2\u7684\u821E\u8005\u3002"
    Vi: "Trong kh\xF4ng gian mang h\u01A1i h\u01B0\u1EDBng vintage, nh\u1EEFng ng\u01B0\u1EDDi
      b\u1EA1n nh\u1EA3y m\xFAa h\u1EBFt m\xECnh. Di\u1EC7n trang ph\u1EE5c th\u1EADt
      \u0111\u1EB9p, h\u1ECD th\u1EA3 m\xECnh theo nh\u1ECBp \u0111i\u1EC7u. Ch\u1EC9
      c\u1EA7n c\xF3 \xE2m nh\u1EA1c, ai c\u0169ng c\xF3 th\u1EC3 tr\u1EDF th\xE0nh
      v\u0169 c\xF4ng c\u1EEB nh\u1EA5t."
    Hi: "\u0935\u093F\u0902\u091F\u0947\u091C \u092E\u093E\u0939\u094C\u0932 \u0935\u093E\u0932\u0940
      \u091C\u0917\u0939 \u092E\u0947\u0902 \u0926\u094B\u0938\u094D\u0924 \u092E\u0938\u094D\u0924\u0940
      \u0938\u0947 \u0928\u093E\u091A\u0924\u0947 \u0939\u0948\u0902\u0964 \u092C\u0922\u093C\u093F\u092F\u093E
      \u0915\u092A\u0921\u093C\u0947 \u092A\u0939\u0928\u0915\u0930 \u0935\u0947
      \u0924\u093E\u0932 \u092A\u0930 \u0916\u0941\u0926 \u0915\u094B \u091B\u094B\u0921\u093C
      \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0902\u0917\u0940\u0924
      \u0938\u093E\u0925 \u0939\u094B \u0924\u094B \u0915\u094B\u0908 \u092D\u0940
      \u0938\u092C\u0938\u0947 \u092C\u0947\u0939\u0924\u0930\u0940\u0928 \u0921\u093E\u0902\u0938\u0930
      \u092C\u0928 \u091C\u093E\u0924\u093E \u0939\u0948\u0964"
    Ar: "\u0641\u064A \u0645\u0643\u0627\u0646 \u0628\u0623\u062C\u0648\u0627\u0621
      \u0639\u062A\u064A\u0642\u0629\u060C \u064A\u0631\u0642\u0635 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0628\u0645\u0631\u062D. \u064A\u0631\u062A\u062F\u0648\u0646 \u0623\u062C\u0645\u0644
      \u0645\u0644\u0627\u0628\u0633\u0647\u0645 \u0648\u064A\u0633\u062A\u0633\u0644\u0645\u0648\u0646
      \u0644\u0644\u0625\u064A\u0642\u0627\u0639. \u0645\u0639 \u0627\u0644\u0645\u0648\u0633\u064A\u0642\u0649\u060C
      \u064A\u0635\u0628\u062D \u0627\u0644\u062C\u0645\u064A\u0639 \u0623\u0641\u0636\u0644
      \u0631\u0627\u0642\u0635."
  - Key: 200130
    En: Alongside a clear lake and green mountains, the friends pedal their bikes.
      They race down the trail, cutting through the cool breeze. A refreshing ride
      through nature fills them with new energy.
    Ko: "\uB9D1\uC740 \uD638\uC218\uC640 \uD478\uB978 \uC0B0\uC744 \uB07C\uACE0 \uCE5C\uAD6C\uB4E4\uC774
      \uC790\uC804\uAC70 \uD398\uB2EC\uC744 \uBC1F\uC2B5\uB2C8\uB2E4. \uC2DC\uC6D0\uD55C
      \uBC14\uB78C\uC744 \uAC00\uB974\uBA70 \uD2B8\uB808\uC77C\uC744 \uC2E0\uB098\uAC8C
      \uB2EC\uB9BD\uB2C8\uB2E4. \uC790\uC5F0 \uC18D\uC744 \uB204\uBE44\uB294 \uC0C1\uCF8C\uD55C
      \uB77C\uC774\uB529\uC774 \uD65C\uB825\uC744 \uBD88\uC5B4\uB123\uC2B5\uB2C8\uB2E4."
    Ja: "\u6F84\u3093\u3060\u6E56\u3068\u9752\u3044\u5C71\u3092\u773A\u3081\u306A\u304C\u3089\u3001\u4EF2\u9593\u305F\u3061\u306F\u81EA\u8EE2\u8ECA\u306E\u30DA\u30C0\u30EB\u3092\u3053\u304E\u307E\u3059\u3002\u6DBC\u3057\u3044\u98A8\u3092\u5207\u3063\u3066\u30C8\u30EC\u30A4\u30EB\u3092\u6C17\u6301\u3061\u3088\u304F\u8D70\u308A\u307E\u3059\u3002\u81EA\u7136\u306E\u4E2D\u3092\u99C6\u3051\u629C\u3051\u308B\u723D\u5FEB\u306A\u30E9\u30A4\u30C9\u304C\u5143\u6C17\u3092\u304F\u308C\u307E\u3059\u3002"
    Zh: "\u4F34\u7740\u6E05\u6F88\u7684\u6E56\u6C34\u4E0E\u9752\u7FE0\u7684\u5C71\u5CE6\uFF0C\u670B\u53CB\u4EEC\u8E29\u7740\u81EA\u884C\u8F66\u8E0F\u677F\u3002\u4ED6\u4EEC\u8FCE\u7740\u51C9\u723D\u7684\u98CE\uFF0C\u5728\u5C0F\u5F84\u4E0A\u7545\u5FEB\u98DE\u9A70\u3002\u7A7F\u884C\u4E8E\u81EA\u7136\u4E4B\u4E2D\u7684\u6E05\u723D\u9A91\u884C\uFF0C\u8BA9\u4EBA\u6D3B\u529B\u6EE1\u6EE1\u3002"
    Vi: "B\xEAn h\u1ED3 n\u01B0\u1EDBc trong v\xE0 n\xFAi non xanh bi\u1EBFc, nh\u1EEFng
      ng\u01B0\u1EDDi b\u1EA1n \u0111\u1EA1p xe b\u0103ng b\u0103ng. H\u1ECD r\u1EBD
      gi\xF3 m\xE1t l\u01B0\u1EDBt tr\xEAn cung \u0111\u01B0\u1EDDng m\xF2n \u0111\u1EA7y
      h\u1EE9ng kh\u1EDFi. Chuy\u1EBFn \u0111\u1EA1p xe s\u1EA3ng kho\xE1i gi\u1EEFa
      thi\xEAn nhi\xEAn ti\u1EBFp th\xEAm s\u1EE9c s\u1ED1ng."
    Hi: "\u0938\u093E\u092B\u093C \u091D\u0940\u0932 \u0914\u0930 \u0939\u0930\u0947-\u092D\u0930\u0947
      \u092A\u0939\u093E\u0921\u093C\u094B\u0902 \u0915\u0947 \u0915\u093F\u0928\u093E\u0930\u0947
      \u0926\u094B\u0938\u094D\u0924 \u0938\u093E\u0907\u0915\u093F\u0932 \u0915\u0947
      \u092A\u0948\u0921\u0932 \u092E\u093E\u0930\u0924\u0947 \u0939\u0948\u0902\u0964
      \u0920\u0902\u0921\u0940 \u0939\u0935\u093E \u0915\u094B \u091A\u0940\u0930\u0924\u0947
      \u0939\u0941\u090F \u0935\u0947 \u091F\u094D\u0930\u0947\u0932 \u092A\u0930
      \u092E\u0938\u094D\u0924\u0940 \u0938\u0947 \u0926\u094C\u0921\u093C\u0924\u0947
      \u0939\u0948\u0902\u0964 \u092A\u094D\u0930\u0915\u0943\u0924\u093F \u0915\u0947
      \u092C\u0940\u091A \u0915\u0940 \u092F\u0939 \u0924\u093E\u091C\u093C\u0917\u0940
      \u092D\u0930\u0940 \u0938\u0935\u093E\u0930\u0940 \u0928\u0908 \u090A\u0930\u094D\u091C\u093E
      \u092D\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"
    Ar: "\u0628\u0645\u062D\u0627\u0630\u0627\u0629 \u0628\u062D\u064A\u0631\u0629
      \u0635\u0627\u0641\u064A\u0629 \u0648\u062C\u0628\u0627\u0644 \u062E\u0636\u0631\u0627\u0621\u060C
      \u064A\u062F\u0648\u0633 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621 \u062F\u0648\u0627\u0633\u0627\u062A
      \u062F\u0631\u0627\u062C\u0627\u062A\u0647\u0645. \u064A\u0646\u0637\u0644\u0642\u0648\u0646
      \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0627\u0631 \u0648\u0633\u0637
      \u0646\u0633\u064A\u0645 \u0645\u0646\u0639\u0634. \u062C\u0648\u0644\u0629
      \u0645\u0646\u0639\u0634\u0629 \u0641\u064A \u0623\u062D\u0636\u0627\u0646
      \u0627\u0644\u0637\u0628\u064A\u0639\u0629 \u062A\u0645\u0646\u062D\u0647\u0645
      \u0637\u0627\u0642\u0629 \u0645\u062A\u062C\u062F\u062F\u0629."
  - Key: 200131
    En: With the Eiffel Tower behind them, the friends travel through Paris, the
      city of romance. Wearing berets, they capture beautiful moments with their
      cameras. The excitement of this trip abroad stays in their hearts for a long
      time.
    Ko: "\uC5D0\uD3A0\uD0D1\uC744 \uBC30\uACBD\uC73C\uB85C \uCE5C\uAD6C\uB4E4\uC774
      \uB0AD\uB9CC\uC758 \uB3C4\uC2DC \uD30C\uB9AC\uB97C \uC5EC\uD589\uD569\uB2C8\uB2E4.
      \uBCA0\uB808\uBAA8\uB97C \uC4F0\uACE0 \uCE74\uBA54\uB77C\uB85C \uBA4B\uC9C4
      \uC21C\uAC04\uB4E4\uC744 \uB2F4\uC2B5\uB2C8\uB2E4. \uC124\uB808\uB294 \uD574\uC678\uC5EC\uD589\uC758
      \uCD94\uC5B5\uC774 \uC624\uB798\uB3C4\uB85D \uB9C8\uC74C\uC5D0 \uB0A8\uC2B5\uB2C8\uB2E4."
    Ja: "\u30A8\u30C3\u30D5\u30A7\u30EB\u5854\u3092\u80CC\u666F\u306B\u3001\u4EF2\u9593\u305F\u3061\u306F\u30ED\u30DE\u30F3\u306E\u8857\u30D1\u30EA\u3092\u65C5\u3057\u307E\u3059\u3002\u30D9\u30EC\u30FC\u5E3D\u3092\u304B\u3076\u3063\u3066\u3001\u30AB\u30E1\u30E9\u3067\u7D20\u6575\u306A\u77AC\u9593\u3092\u5207\u308A\u53D6\u308A\u307E\u3059\u3002\u3068\u304D\u3081\u304F\u6D77\u5916\u65C5\u884C\u306E\u601D\u3044\u51FA\u306F\u3001\u3044\u3064\u307E\u3067\u3082\u5FC3\u306B\u6B8B\u308A\u307E\u3059\u3002"
    Zh: "\u4EE5\u57C3\u83F2\u5C14\u94C1\u5854\u4E3A\u80CC\u666F\uFF0C\u670B\u53CB\u4EEC\u7545\u6E38\u6D6A\u6F2B\u4E4B\u90FD\u5DF4\u9ECE\u3002\u4ED6\u4EEC\u6234\u7740\u8D1D\u96F7\u5E3D\uFF0C\u7528\u76F8\u673A\u8BB0\u5F55\u4E0B\u7F8E\u597D\u77AC\u95F4\u3002\u8FD9\u573A\u4EE4\u4EBA\u5FC3\u52A8\u7684\u6D77\u5916\u65C5\u884C\uFF0C\u4F1A\u957F\u4E45\u7559\u5728\u5FC3\u4E2D\u3002"
    Vi: "V\u1EDBi th\xE1p Eiffel l\xE0m n\u1EC1n, nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n
      d\u1EA1o ch\u01A1i kh\u1EAFp Paris - th\xE0nh ph\u1ED1 c\u1EE7a s\u1EF1 l\xE3ng
      m\u1EA1n. \u0110\u1ED9i m\u0169 n\u1ED3i, h\u1ECD ghi l\u1EA1i nh\u1EEFng kho\u1EA3nh
      kh\u1EAFc tuy\u1EC7t \u0111\u1EB9p b\u1EB1ng m\xE1y \u1EA3nh. K\u1EF7 ni\u1EC7m
      v\u1EC1 chuy\u1EBFn \u0111i n\u01B0\u1EDBc ngo\xE0i \u0111\u1EA7y h\xE1o h\u1EE9c
      s\u1EBD c\xF2n \u0111\u1ECDng m\xE3i trong tim."
    Hi: "\u090F\u092B\u093F\u0932 \u091F\u0949\u0935\u0930 \u0915\u0940 \u092A\u0943\u0937\u094D\u0920\u092D\u0942\u092E\u093F
      \u092E\u0947\u0902 \u0926\u094B\u0938\u094D\u0924 \u0930\u094B\u092E\u093E\u0902\u0938
      \u0915\u0947 \u0936\u0939\u0930 \u092A\u0947\u0930\u093F\u0938 \u0915\u0940
      \u0938\u0948\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092C\u0947\u0930\u0947
      \u092A\u0939\u0928\u0915\u0930 \u0935\u0947 \u0915\u0948\u092E\u0930\u0947
      \u0938\u0947 \u0916\u0942\u092C\u0938\u0942\u0930\u0924 \u092A\u0932 \u0915\u0948\u0926
      \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938 \u0930\u094B\u092E\u093E\u0902\u091A\u0915
      \u0935\u093F\u0926\u0947\u0936 \u092F\u093E\u0924\u094D\u0930\u093E \u0915\u0940
      \u092F\u093E\u0926\u0947\u0902 \u0932\u0902\u092C\u0947 \u0938\u092E\u092F
      \u0924\u0915 \u0926\u093F\u0932 \u092E\u0947\u0902 \u092C\u0938\u0940 \u0930\u0939\u0924\u0940
      \u0939\u0948\u0902\u0964"
    Ar: "\u0648\u0628\u0631\u062C \u0625\u064A\u0641\u0644 \u062E\u0644\u0641\u0647\u0645\u060C
      \u064A\u062A\u062C\u0648\u0644 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0641\u064A \u0628\u0627\u0631\u064A\u0633 \u0645\u062F\u064A\u0646\u0629
      \u0627\u0644\u0631\u0648\u0645\u0627\u0646\u0633\u064A\u0629. \u064A\u0631\u062A\u062F\u0648\u0646
      \u0642\u0628\u0639\u0627\u062A \u0627\u0644\u0628\u064A\u0631\u064A\u0647 \u0648\u064A\u0644\u062A\u0642\u0637\u0648\u0646
      \u0623\u062C\u0645\u0644 \u0627\u0644\u0644\u062D\u0638\u0627\u062A \u0628\u0643\u0627\u0645\u064A\u0631\u0627\u062A\u0647\u0645.
      \u062A\u0628\u0642\u0649 \u0630\u0643\u0631\u064A\u0627\u062A \u0647\u0630\u0647
      \u0627\u0644\u0631\u062D\u0644\u0629 \u0627\u0644\u0645\u062B\u064A\u0631\u0629
      \u0641\u064A \u0627\u0644\u0642\u0644\u0628 \u0637\u0648\u064A\u0644\u064B\u0627."
  - Key: 200132
    En: The friends slide joyfully down the pure white snow on their sleds. Even
      in the cold air, the laughter never stops. It's the most thrilling game winter
      has to offer.
    Ko: "\uC0C8\uD558\uC580 \uB208\uBC2D \uC704\uB97C \uCE5C\uAD6C\uB4E4\uC774 \uC370\uB9E4\uB97C
      \uD0C0\uACE0 \uC2E0\uB098\uAC8C \uBBF8\uB044\uB7EC\uC838 \uB0B4\uB824\uAC11\uB2C8\uB2E4.
      \uCC28\uAC00\uC6B4 \uACF5\uAE30 \uC18D\uC5D0\uC11C\uB3C4 \uC6C3\uC74C\uC18C\uB9AC\uAC00
      \uB04A\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uACA8\uC6B8\uC774 \uC120\uBB3C\uD558\uB294
      \uAC00\uC7A5 \uC9DC\uB9BF\uD55C \uB180\uC774\uC785\uB2C8\uB2E4."
    Ja: "\u771F\u3063\u767D\u306A\u96EA\u539F\u3092\u3001\u4EF2\u9593\u305F\u3061\u306F\u305D\u308A\u306B\u4E57\u3063\u3066\u697D\u3057\u305D\u3046\u306B\u6ED1\u308A\u964D\u308A\u307E\u3059\u3002\u51B7\u305F\u3044\u7A7A\u6C17\u306E\u4E2D\u3067\u3082\u7B11\u3044\u58F0\u304C\u7D76\u3048\u307E\u305B\u3093\u3002\u51AC\u304C\u8D08\u3063\u3066\u304F\u308C\u308B\u3001\u3044\u3061\u3070\u3093\u30B9\u30EA\u30EB\u306E\u3042\u308B\u904A\u3073\u3067\u3059\u3002"
    Zh: "\u5728\u96EA\u767D\u7684\u96EA\u5730\u4E0A\uFF0C\u670B\u53CB\u4EEC\u5750\u7740\u96EA\u6A47\u7545\u5FEB\u5730\u6ED1\u4E0B\u3002\u5373\u4F7F\u7A7A\u6C14\u51B0\u51B7\uFF0C\u7B11\u58F0\u4E5F\u4ECE\u672A\u505C\u6B47\u3002\u8FD9\u662F\u51AC\u5929\u9001\u6765\u7684\u6700\u523A\u6FC0\u7684\u6E38\u620F\u3002"
    Vi: "Tr\xEAn c\xE1nh \u0111\u1ED3ng tuy\u1EBFt tr\u1EAFng tinh, nh\u1EEFng ng\u01B0\u1EDDi
      b\u1EA1n h\xE0o h\u1EE9ng tr\u01B0\u1EE3t xu\u1ED1ng b\u1EB1ng xe tr\u01B0\u1EE3t.
      D\xF9 kh\xF4ng kh\xED l\u1EA1nh bu\u1ED1t, ti\u1EBFng c\u01B0\u1EDDi v\u1EABn
      kh\xF4ng ng\u1EDBt. \u0110\xF3 l\xE0 tr\xF2 ch\u01A1i ph\u1EA5n kh\xEDch nh\u1EA5t
      m\xE0 m\xF9a \u0111\xF4ng mang l\u1EA1i."
    Hi: "\u092C\u0930\u094D\u092B\u093C \u0915\u0940 \u0938\u092B\u093C\u0947\u0926
      \u091A\u093E\u0926\u0930 \u092A\u0930 \u0926\u094B\u0938\u094D\u0924 \u0938\u094D\u0932\u0947\u091C
      \u092A\u0930 \u092C\u0948\u0920\u0915\u0930 \u092E\u091C\u093C\u0947 \u0938\u0947
      \u092B\u093F\u0938\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u0920\u0902\u0921\u0940
      \u0939\u0935\u093E \u092E\u0947\u0902 \u092D\u0940 \u0939\u0901\u0938\u0940
      \u0925\u092E\u0924\u0940 \u0928\u0939\u0940\u0902\u0964 \u092F\u0939 \u0938\u0930\u094D\u0926\u093F\u092F\u094B\u0902
      \u0915\u093E \u0926\u093F\u092F\u093E \u0938\u092C\u0938\u0947 \u0930\u094B\u092E\u093E\u0902\u091A\u0915
      \u0916\u0947\u0932 \u0939\u0948\u0964"
    Ar: "\u064A\u0646\u0632\u0644\u0642 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0628\u0645\u0631\u062D \u0639\u0644\u0649 \u0627\u0644\u0632\u0644\u0627\u062C\u0627\u062A
      \u0641\u0648\u0642 \u0627\u0644\u062B\u0644\u062C \u0627\u0644\u0623\u0628\u064A\u0636
      \u0627\u0644\u0646\u0627\u0635\u0639. \u0648\u0631\u063A\u0645 \u0628\u0631\u0648\u062F\u0629
      \u0627\u0644\u0647\u0648\u0627\u0621\u060C \u0644\u0627 \u062A\u062A\u0648\u0642\u0641
      \u0627\u0644\u0636\u062D\u0643\u0627\u062A. \u0625\u0646\u0647\u0627 \u0623\u0643\u062B\u0631
      \u0623\u0644\u0639\u0627\u0628 \u0627\u0644\u0634\u062A\u0627\u0621 \u0625\u062B\u0627\u0631\u0629."
  - Key: 200133
    En: On a beach where blue waves roll in, the friends build sandcastles. Some
      surf, some float on tubes, all soaking up the summer sea. It's a perfect day
      spent on a sun-drenched shore.
    Ko: "\uD478\uB978 \uD30C\uB3C4\uAC00 \uB118\uC2E4\uB300\uB294 \uD574\uBCC0\uC5D0\uC11C
      \uCE5C\uAD6C\uB4E4\uC774 \uBAA8\uB798\uC131\uC744 \uC313\uC2B5\uB2C8\uB2E4.
      \uB204\uAD6C\uB294 \uC11C\uD551\uC744, \uB204\uAD6C\uB294 \uD29C\uBE0C\uB97C
      \uD0C0\uBA70 \uC5EC\uB984 \uBC14\uB2E4\uB97C \uB9CC\uB07D\uD569\uB2C8\uB2E4.
      \uD587\uC0B4 \uAC00\uB4DD\uD55C \uD574\uBCC0\uC5D0\uC11C \uBCF4\uB0B4\uB294
      \uC644\uBCBD\uD55C \uD558\uB8E8\uC785\uB2C8\uB2E4."
    Ja: "\u9752\u3044\u6CE2\u304C\u6253\u3061\u5BC4\u305B\u308B\u30D3\u30FC\u30C1\u3067\u3001\u4EF2\u9593\u305F\u3061\u306F\u7802\u306E\u304A\u57CE\u3092\u4F5C\u308A\u307E\u3059\u3002\u30B5\u30FC\u30D5\u30A3\u30F3\u3092\u3059\u308B\u5B50\u3082\u3001\u6D6E\u304D\u8F2A\u3067\u904A\u3076\u5B50\u3082\u3001\u590F\u306E\u6D77\u3092\u6E80\u55AB\u3057\u307E\u3059\u3002\u65E5\u5DEE\u3057\u3042\u3075\u308C\u308B\u30D3\u30FC\u30C1\u3067\u904E\u3054\u3059\u5B8C\u74A7\u306A\u4E00\u65E5\u3067\u3059\u3002"
    Zh: "\u5728\u84DD\u8272\u6D77\u6D6A\u7FFB\u6D8C\u7684\u6C99\u6EE9\u4E0A\uFF0C\u670B\u53CB\u4EEC\u5806\u8D77\u6C99\u5821\u3002\u6709\u4EBA\u51B2\u6D6A\uFF0C\u6709\u4EBA\u73A9\u6CF3\u5708\uFF0C\u5C3D\u60C5\u4EAB\u53D7\u590F\u65E5\u7684\u5927\u6D77\u3002\u8FD9\u662F\u5728\u9633\u5149\u707F\u70C2\u7684\u6D77\u6EE9\u4E0A\u5EA6\u8FC7\u7684\u5B8C\u7F8E\u4E00\u5929\u3002"
    Vi: "Tr\xEAn b\xE3i bi\u1EC3n v\u1EDBi nh\u1EEFng con s\xF3ng xanh r\xEC r\xE0o,
      nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n x\xE2y l\xE2u \u0111\xE0i c\xE1t. Ng\u01B0\u1EDDi
      th\xEC l\u01B0\u1EDBt s\xF3ng, ng\u01B0\u1EDDi th\xEC th\u1EA3 m\xECnh tr\xEAn
      phao, c\xF9ng t\u1EADn h\u01B0\u1EDFng bi\u1EC3n h\xE8. M\u1ED9t ng\xE0y ho\xE0n
      h\u1EA3o tr\xEAn b\u1EDD bi\u1EC3n ng\u1EADp n\u1EAFng."
    Hi: "\u0928\u0940\u0932\u0940 \u0932\u0939\u0930\u094B\u0902 \u0935\u093E\u0932\u0947
      \u0938\u092E\u0941\u0926\u094D\u0930 \u0924\u091F \u092A\u0930 \u0926\u094B\u0938\u094D\u0924
      \u0930\u0947\u0924 \u0915\u093E \u092E\u0939\u0932 \u092C\u0928\u093E\u0924\u0947
      \u0939\u0948\u0902\u0964 \u0915\u094B\u0908 \u0938\u0930\u094D\u092B\u093F\u0902\u0917
      \u0915\u0930\u0924\u093E \u0939\u0948 \u0924\u094B \u0915\u094B\u0908 \u091F\u094D\u092F\u0942\u092C
      \u092A\u0930 \u0924\u0948\u0930\u0924\u093E \u0939\u0948, \u0938\u092C \u0917\u0930\u094D\u092E\u093F\u092F\u094B\u0902
      \u0915\u0947 \u0938\u092E\u0941\u0926\u094D\u0930 \u0915\u093E \u092A\u0942\u0930\u093E
      \u092E\u091C\u093C\u093E \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964
      \u0927\u0942\u092A \u0938\u0947 \u092D\u0930\u0947 \u0924\u091F \u092A\u0930
      \u092C\u093F\u0924\u093E\u092F\u093E \u092F\u0939 \u0926\u093F\u0928 \u090F\u0915\u0926\u092E
      \u092C\u0947\u0939\u0924\u0930\u0940\u0928 \u0939\u0948\u0964"
    Ar: "\u0639\u0644\u0649 \u0634\u0627\u0637\u0626 \u062A\u062A\u0644\u0627\u0637\u0645
      \u0641\u064A\u0647 \u0627\u0644\u0623\u0645\u0648\u0627\u062C \u0627\u0644\u0632\u0631\u0642\u0627\u0621\u060C
      \u064A\u0628\u0646\u064A \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621 \u0642\u0644\u0627\u0639\u064B\u0627
      \u0645\u0646 \u0627\u0644\u0631\u0645\u0644. \u0628\u0639\u0636\u0647\u0645
      \u064A\u0631\u0643\u0628 \u0627\u0644\u0623\u0645\u0648\u0627\u062C \u0648\u0628\u0639\u0636\u0647\u0645
      \u064A\u0637\u0641\u0648 \u0639\u0644\u0649 \u0627\u0644\u0639\u0648\u0627\u0645\u0627\u062A\u060C
      \u0648\u0627\u0644\u062C\u0645\u064A\u0639 \u064A\u0633\u062A\u0645\u062A\u0639
      \u0628\u0628\u062D\u0631 \u0627\u0644\u0635\u064A\u0641. \u0625\u0646\u0647
      \u064A\u0648\u0645 \u0645\u062B\u0627\u0644\u064A \u0639\u0644\u0649 \u0634\u0627\u0637\u0626
      \u062A\u063A\u0645\u0631\u0647 \u0627\u0644\u0634\u0645\u0633."
  - Key: 200134
    En: In their pajamas, the friends start a pillow fight on the bed. Fluffy pillows
      fly through the air and the room fills with laughter. It's a fun pajama party
      that lasts long into the night.
    Ko: "\uC7A0\uC637\uC744 \uC785\uC740 \uCE5C\uAD6C\uB4E4\uC774 \uCE68\uB300 \uC704\uC5D0\uC11C
      \uBCA0\uAC1C \uC2F8\uC6C0\uC744 \uBC8C\uC785\uB2C8\uB2E4. \uD3ED\uC2E0\uD55C
      \uBCA0\uAC1C\uAC00 \uB0A0\uC544\uB2E4\uB2C8\uACE0 \uBC29 \uC548\uC740 \uC6C3\uC74C\uC73C\uB85C
      \uAC00\uB4DD\uD569\uB2C8\uB2E4. \uBC24\uB2A6\uB3C4\uB85D \uC774\uC5B4\uC9C0\uB294
      \uC990\uAC70\uC6B4 \uD30C\uC790\uB9C8 \uD30C\uD2F0\uC785\uB2C8\uB2E4."
    Ja: "\u30D1\u30B8\u30E3\u30DE\u3092\u7740\u305F\u4EF2\u9593\u305F\u3061\u304C\u30D9\u30C3\u30C9\u306E\u4E0A\u3067\u6795\u6295\u3052\u3092\u59CB\u3081\u307E\u3059\u3002\u3075\u308F\u3075\u308F\u306E\u6795\u304C\u98DB\u3073\u4EA4\u3044\u3001\u90E8\u5C4B\u306F\u7B11\u3044\u58F0\u3067\u3044\u3063\u3071\u3044\u3067\u3059\u3002\u591C\u9045\u304F\u307E\u3067\u7D9A\u304F\u697D\u3057\u3044\u30D1\u30B8\u30E3\u30DE\u30D1\u30FC\u30C6\u30A3\u30FC\u3067\u3059\u3002"
    Zh: "\u7A7F\u7740\u7761\u8863\u7684\u670B\u53CB\u4EEC\u5728\u5E8A\u4E0A\u5C55\u5F00\u6795\u5934\u5927\u6218\u3002\u8F6F\u7EF5\u7EF5\u7684\u6795\u5934\u6EE1\u5929\u98DE\uFF0C\u623F\u95F4\u91CC\u5145\u6EE1\u6B22\u7B11\u3002\u8FD9\u662F\u4E00\u573A\u6301\u7EED\u5230\u6DF1\u591C\u7684\u5FEB\u4E50\u7761\u8863\u6D3E\u5BF9\u3002"
    Vi: "Trong b\u1ED9 pyjama, nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n b\xE0y tr\xF2
      n\xE9m g\u1ED1i tr\xEAn gi\u01B0\u1EDDng. Nh\u1EEFng chi\u1EBFc g\u1ED1i \xEAm
      \xE1i bay kh\u1EAFp n\u01A1i v\xE0 c\u0103n ph\xF2ng ng\u1EADp ti\u1EBFng c\u01B0\u1EDDi.
      \u0110\xF3 l\xE0 b\u1EEFa ti\u1EC7c pyjama vui v\u1EBB k\xE9o d\xE0i \u0111\u1EBFn
      t\u1EADn khuya."
    Hi: "\u092A\u091C\u093E\u092E\u093E \u092A\u0939\u0928\u0947 \u0926\u094B\u0938\u094D\u0924
      \u092C\u093F\u0938\u094D\u0924\u0930 \u092A\u0930 \u0924\u0915\u093F\u092F\u093E
      \u0932\u0921\u093C\u093E\u0908 \u0936\u0941\u0930\u0942 \u0915\u0930 \u0926\u0947\u0924\u0947
      \u0939\u0948\u0902\u0964 \u092E\u0941\u0932\u093E\u092F\u092E \u0924\u0915\u093F\u090F
      \u0939\u0935\u093E \u092E\u0947\u0902 \u0909\u0921\u093C\u0924\u0947 \u0939\u0948\u0902
      \u0914\u0930 \u0915\u092E\u0930\u093E \u0939\u0901\u0938\u0940 \u0938\u0947
      \u092D\u0930 \u091C\u093E\u0924\u093E \u0939\u0948\u0964 \u092F\u0939 \u0926\u0947\u0930
      \u0930\u093E\u0924 \u0924\u0915 \u091A\u0932\u0928\u0947 \u0935\u093E\u0932\u0940
      \u092E\u091C\u093C\u0947\u0926\u093E\u0930 \u092A\u091C\u093E\u092E\u093E \u092A\u093E\u0930\u094D\u091F\u0940
      \u0939\u0948\u0964"
    Ar: "\u0628\u0645\u0644\u0627\u0628\u0633 \u0627\u0644\u0646\u0648\u0645\u060C
      \u064A\u0628\u062F\u0623 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621 \u0645\u0639\u0631\u0643\u0629
      \u0648\u0633\u0627\u0626\u062F \u0641\u0648\u0642 \u0627\u0644\u0633\u0631\u064A\u0631.
      \u062A\u062A\u0637\u0627\u064A\u0631 \u0627\u0644\u0648\u0633\u0627\u0626\u062F
      \u0627\u0644\u0648\u062B\u064A\u0631\u0629 \u0648\u062A\u0645\u062A\u0644\u0626
      \u0627\u0644\u063A\u0631\u0641\u0629 \u0628\u0627\u0644\u0636\u062D\u0643\u0627\u062A.
      \u0625\u0646\u0647\u0627 \u062D\u0641\u0644\u0629 \u0628\u064A\u062C\u0627\u0645\u0629
      \u0645\u0645\u062A\u0639\u0629 \u062A\u0645\u062A\u062F \u062D\u062A\u0649
      \u0648\u0642\u062A \u0645\u062A\u0623\u062E\u0631 \u0645\u0646 \u0627\u0644\u0644\u064A\u0644."
  - Key: 200135
    En: Dressed as explorers, the friends set out to discover the great pyramids
      and the Sphinx. They unfold their map and take photos as they come face to
      face with the mysteries of an ancient civilization. It's a thrilling grand
      adventure across the sandy desert.
    Ko: "\uD0D0\uD5D8\uAC00 \uBCF5\uC7A5\uC744 \uAC16\uCD98 \uCE5C\uAD6C\uB4E4\uC774
      \uAC70\uB300\uD55C \uD53C\uB77C\uBBF8\uB4DC\uC640 \uC2A4\uD551\uD06C\uC2A4\uB97C
      \uD0D0\uD5D8\uD569\uB2C8\uB2E4. \uC9C0\uB3C4\uB97C \uD3BC\uCE58\uACE0 \uC0AC\uC9C4\uC744
      \uCC0D\uC73C\uBA70 \uACE0\uB300 \uBB38\uBA85\uC758 \uC2E0\uBE44\uB97C \uB9C8\uC8FC\uD569\uB2C8\uB2E4.
      \uBAA8\uB798\uC0AC\uB9C9 \uC704\uC5D0\uC11C \uD3BC\uCCD0\uC9C0\uB294 \uD765\uBBF8\uC9C4\uC9C4\uD55C
      \uB300\uBAA8\uD5D8\uC785\uB2C8\uB2E4."
    Ja: "\u63A2\u691C\u5BB6\u306E\u670D\u88C5\u306B\u8EAB\u3092\u5305\u3093\u3060\u4EF2\u9593\u305F\u3061\u304C\u3001\u5DE8\u5927\u306A\u30D4\u30E9\u30DF\u30C3\u30C9\u3068\u30B9\u30D5\u30A3\u30F3\u30AF\u30B9\u3092\u63A2\u691C\u3057\u307E\u3059\u3002\u5730\u56F3\u3092\u5E83\u3052\u3001\u5199\u771F\u3092\u64AE\u308A\u306A\u304C\u3089\u53E4\u4EE3\u6587\u660E\u306E\u795E\u79D8\u3068\u5411\u304D\u5408\u3044\u307E\u3059\u3002\u7802\u6F20\u306E\u4E0A\u3067\u7E70\u308A\u5E83\u3052\u3089\u308C\u308B\u80F8\u8E8D\u308B\u5927\u5192\u967A\u3067\u3059\u3002"
    Zh: "\u8EAB\u7740\u63A2\u9669\u5BB6\u88C5\u626E\u7684\u670B\u53CB\u4EEC\uFF0C\u63A2\u7D22\u5DE8\u5927\u7684\u91D1\u5B57\u5854\u4E0E\u72EE\u8EAB\u4EBA\u9762\u50CF\u3002\u4ED6\u4EEC\u5C55\u5F00\u5730\u56FE\u3001\u62CD\u4E0B\u7167\u7247\uFF0C\u76F4\u9762\u53E4\u4EE3\u6587\u660E\u7684\u795E\u79D8\u3002\u8FD9\u662F\u4E00\u573A\u5728\u6C99\u6F20\u4E0A\u5C55\u5F00\u7684\u7CBE\u5F69\u5927\u5192\u9669\u3002"
    Vi: "Trong trang ph\u1EE5c nh\xE0 th\xE1m hi\u1EC3m, nh\u1EEFng ng\u01B0\u1EDDi
      b\u1EA1n kh\xE1m ph\xE1 kim t\u1EF1 th\xE1p kh\u1ED5ng l\u1ED3 v\xE0 t\u01B0\u1EE3ng
      Nh\xE2n s\u01B0. H\u1ECD m\u1EDF b\u1EA3n \u0111\u1ED3, ch\u1EE5p \u1EA3nh
      v\xE0 \u0111\u1ED1i di\u1EC7n v\u1EDBi b\xED \u1EA9n c\u1EE7a n\u1EC1n v\u0103n
      minh c\u1ED5 \u0111\u1EA1i. \u0110\xF3 l\xE0 chuy\u1EBFn phi\xEAu l\u01B0u
      l\u1EDBn \u0111\u1EA7y h\u1EA5p d\u1EABn gi\u1EEFa sa m\u1EA1c c\xE1t."
    Hi: "\u0916\u094B\u091C\u0940 \u0935\u0947\u0936\u092D\u0942\u0937\u093E \u092A\u0939\u0928\u0947
      \u0926\u094B\u0938\u094D\u0924 \u0935\u093F\u0936\u093E\u0932 \u092A\u093F\u0930\u093E\u092E\u093F\u0921\u094B\u0902
      \u0914\u0930 \u0938\u094D\u092B\u093F\u0902\u0915\u094D\u0938 \u0915\u0940
      \u0916\u094B\u091C \u092A\u0930 \u0928\u093F\u0915\u0932\u0924\u0947 \u0939\u0948\u0902\u0964
      \u0928\u0915\u094D\u0936\u093E \u0916\u094B\u0932\u0915\u0930 \u0914\u0930
      \u0924\u0938\u094D\u0935\u0940\u0930\u0947\u0902 \u0916\u0940\u0902\u091A\u0924\u0947
      \u0939\u0941\u090F \u0935\u0947 \u092A\u094D\u0930\u093E\u091A\u0940\u0928
      \u0938\u092D\u094D\u092F\u0924\u093E \u0915\u0947 \u0930\u0939\u0938\u094D\u092F\u094B\u0902
      \u0938\u0947 \u0930\u0942\u092C\u0930\u0942 \u0939\u094B\u0924\u0947 \u0939\u0948\u0902\u0964
      \u0930\u0947\u0924\u0940\u0932\u0947 \u0930\u0947\u0917\u093F\u0938\u094D\u0924\u093E\u0928
      \u092A\u0930 \u0939\u094B\u0928\u0947 \u0935\u093E\u0932\u093E \u092F\u0939
      \u090F\u0915 \u0930\u094B\u092E\u093E\u0902\u091A\u0915 \u092E\u0939\u093E-\u0905\u092D\u093F\u092F\u093E\u0928
      \u0939\u0948\u0964"
    Ar: "\u0628\u0645\u0644\u0627\u0628\u0633 \u0627\u0644\u0645\u0633\u062A\u0643\u0634\u0641\u064A\u0646\u060C
      \u064A\u0646\u0637\u0644\u0642 \u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
      \u0644\u0627\u0633\u062A\u0643\u0634\u0627\u0641 \u0627\u0644\u0623\u0647\u0631\u0627\u0645\u0627\u062A
      \u0627\u0644\u0636\u062E\u0645\u0629 \u0648\u0623\u0628\u064A \u0627\u0644\u0647\u0648\u0644.
      \u064A\u0641\u0631\u062F\u0648\u0646 \u0627\u0644\u062E\u0631\u064A\u0637\u0629
      \u0648\u064A\u0644\u062A\u0642\u0637\u0648\u0646 \u0627\u0644\u0635\u0648\u0631
      \u0648\u0647\u0645 \u064A\u0648\u0627\u062C\u0647\u0648\u0646 \u0623\u0633\u0631\u0627\u0631
      \u0627\u0644\u062D\u0636\u0627\u0631\u0629 \u0627\u0644\u0642\u062F\u064A\u0645\u0629.
      \u0625\u0646\u0647\u0627 \u0645\u063A\u0627\u0645\u0631\u0629 \u0643\u0628\u0631\u0649
      \u0648\u0645\u062B\u064A\u0631\u0629 \u0641\u0648\u0642 \u0631\u0645\u0627\u0644
      \u0627\u0644\u0635\u062D\u0631\u0627\u0621."
