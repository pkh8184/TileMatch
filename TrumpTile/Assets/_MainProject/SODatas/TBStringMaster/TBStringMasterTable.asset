  items:
  - Key: 1
    En: The change is complete.
    Ko: "\uBCC0\uACBD\uC774 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Ja: "\u5909\u66F4\u304C\u5B8C\u4E86\u3057\u307E\u3057\u305F\u3002"
    Zh: "\u53D8\u66F4\u5DF2\u5B8C\u6210\u3002"
    Vi: "Qu\xE1 tr\xECnh thay \u0111\u1ED5i \u0111\xE3 ho\xE0n t\u1EA5t."
    Hi: "\u092A\u0930\u093F\u0935\u0930\u094D\u0924\u0928 \u092A\u0942\u0930\u094D\u0923
      \u0939\u094B \u0917\u092F\u093E \u0939\u0948\u0964"
    Ar: "\u0644\u0642\u062F \u0627\u0643\u062A\u0645\u0644 \u0627\u0644\u062A\u063A\u064A\u064A\u0631."
  - Key: 2
    En: The purchase has been completed.
    Ko: "\uAD6C\uB9E4\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Ja: "\u8CFC\u5165\u304C\u5B8C\u4E86\u3057\u307E\u3057\u305F\u3002"
    Zh: "\u8D2D\u4E70\u5DF2\u5B8C\u6210\u3002"
    Vi: "Giao d\u1ECBch mua b\xE1n \u0111\xE3 ho\xE0n t\u1EA5t."
    Hi: "\u0916\u0930\u0940\u0926 \u092A\u094D\u0930\u0915\u094D\u0930\u093F\u092F\u093E
      \u092A\u0942\u0930\u0940 \u0939\u094B \u0917\u0908 \u0939\u0948\u0964"
    Ar: "\u062A\u0645 \u0625\u062A\u0645\u0627\u0645 \u0639\u0645\u0644\u064A\u0629
      \u0627\u0644\u0634\u0631\u0627\u0621."
  - Key: 3
    En: The latest version of the app has been updated.\n\nPlease download it from
      the Play Store.
    Ko: "\uD604\uC7AC \uCD5C\uC2E0 \uBC84\uC804\uC758 \uC571\uC774 \uC5C5\uB370\uC774\uD2B8
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \\n\uD50C\uB808\uC774\uC2A4\uD1A0\uC5B4\uC5D0\uC11C
      \uB2E4\uC6B4\uB85C\uB4DC \uD574\uC8FC\uC138\uC694."
    Ja: "\u73FE\u5728\u3001\u6700\u65B0\u30D0\u30FC\u30B8\u30E7\u30F3\u306E\u30A2\u30D7\u30EA\u304C\u66F4\u65B0\u3055\u308C\u307E\u3057\u305F\u3002
      \\n\u30D7\u30EC\u30A4\u30B9\u30C8\u30A2\u304B\u3089\u30C0\u30A6\u30F3\u30ED\u30FC\u30C9\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    Zh: "\u8BE5\u5E94\u7528\u5DF2\u66F4\u65B0\u81F3\u6700\u65B0\u7248\u672C\u3002\\n\\n\u8BF7\u4ECE\u5E94\u7528\u5546\u5E97\u4E0B\u8F7D\u3002"
    Vi: "\u1EE8ng d\u1EE5ng \u0111\xE3 \u0111\u01B0\u1EE3c c\u1EADp nh\u1EADt l\xEAn
      phi\xEAn b\u1EA3n m\u1EDBi nh\u1EA5t.\\n\\nVui l\xF2ng t\u1EA3i xu\u1ED1ng
      t\u1EEB Play Store."
    Hi: "\u0910\u092A \u0915\u093E \u0928\u0935\u0940\u0928\u0924\u092E \u0938\u0902\u0938\u094D\u0915\u0930\u0923
      \u0905\u092A\u0921\u0947\u091F \u0915\u0930 \u0926\u093F\u092F\u093E \u0917\u092F\u093E
      \u0939\u0948\u0964\\n\\n\u0915\u0943\u092A\u092F\u093E \u0907\u0938\u0947 \u092A\u094D\u0932\u0947
      \u0938\u094D\u091F\u094B\u0930 \u0938\u0947 \u0921\u093E\u0909\u0928\u0932\u094B\u0921
      \u0915\u0930\u0947\u0902\u0964"
    Ar: "\u062A\u0645 \u062A\u062D\u062F\u064A\u062B \u0627\u0644\u062A\u0637\u0628\u064A\u0642
      \u0625\u0644\u0649 \u0623\u062D\u062F\u062B \u0625\u0635\u062F\u0627\u0631.\\n\\n\u064A\u0631\u062C\u0649
      \u062A\u0646\u0632\u064A\u0644\u0647 \u0645\u0646 \u0645\u062A\u062C\u0631
      \u062C\u0648\u062C\u0644 \u0628\u0644\u0627\u064A."
  - Key: 4
    En: The purchase has been canceled.
    Ko: "\uAD6C\uB9E4\uAC00 \uCDE8\uC18C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Ja: "\u8CFC\u5165\u304C\u30AD\u30E3\u30F3\u30BB\u30EB\u3055\u308C\u307E\u3057\u305F\u3002"
    Zh: "\u8D2D\u4E70\u5DF2\u53D6\u6D88\u3002"
    Vi: "Giao d\u1ECBch mua h\xE0ng \u0111\xE3 b\u1ECB h\u1EE7y."
    Hi: "\u092F\u0939 \u0916\u0930\u0940\u0926 \u0930\u0926\u094D\u0926 \u0915\u0930
      \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964"
    Ar: "\u062A\u0645 \u0625\u0644\u063A\u0627\u0621 \u0639\u0645\u0644\u064A\u0629
      \u0627\u0644\u0634\u0631\u0627\u0621."
  - Key: 5
    En: We are currently unable to verify the network connection.\n\nPlease check
      the connection and try again.\n\nIf the issue persists, please contact Customer
      Service.
    Ko: "\uD604\uC7AC \uB124\uD2B8\uC6CC\uD06C \uC5F0\uACB0\uC744 \uD655\uC778\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\\n\uC5F0\uACB0\uC744 \uD655\uC778 \uD6C4 \uC2DC\uB3C4\uD574\uC8FC\uC138\uC694.
      \\n\uB9CC\uC57D \uC9C0\uC18D\uC801\uC778 \uBB38\uC81C\uAC00 \uBC1C\uC0DD\uD55C\uB2E4\uBA74
      \uACE0\uAC1D\uC13C\uD130\uC5D0 \uBB38\uC758\uD574\uC8FC\uC138\uC694."
    Ja: "\u73FE\u5728\u3001\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u63A5\u7D9A\u3092\u78BA\u8A8D\u3067\u304D\u307E\u305B\u3093\u3002\\n\u63A5\u7D9A\u78BA\u8A8D\u5F8C\u306B\u304A\u8A66\u3057\u304F\u3060\u3055\u3044\u3002
      \\n\u7D99\u7D9A\u7684\u306A\u554F\u984C\u304C\u767A\u751F\u3057\u305F\u5834\u5408\u306F\u3001\u30AB\u30B9\u30BF\u30DE\u30FC\u30BB\u30F3\u30BF\u30FC\u306B\u304A\u554F\u3044\u5408\u308F\u305B\u304F\u3060\u3055\u3044\u3002"
    Zh: "\u6211\u4EEC\u76EE\u524D\u65E0\u6CD5\u9A8C\u8BC1\u7F51\u7EDC\u8FDE\u63A5\u3002\\n\\n\u8BF7\u68C0\u67E5\u7F51\u7EDC\u8FDE\u63A5\u5E76\u91CD\u8BD5\u3002\\n\\n\u5982\u679C\u95EE\u9898\u4ECD\u7136\u5B58\u5728\uFF0C\u8BF7\u8054\u7CFB\u5BA2\u670D\u3002"
    Vi: "Hi\u1EC7n t\u1EA1i ch\xFAng t\xF4i kh\xF4ng th\u1EC3 x\xE1c minh k\u1EBFt
      n\u1ED1i m\u1EA1ng.\\n\\nVui l\xF2ng ki\u1EC3m tra l\u1EA1i k\u1EBFt n\u1ED1i
      v\xE0 th\u1EED l\u1EA1i.\\n\\nN\u1EBFu s\u1EF1 c\u1ED1 v\u1EABn ti\u1EBFp di\u1EC5n,
      vui l\xF2ng li\xEAn h\u1EC7 v\u1EDBi B\u1ED9 ph\u1EADn Ch\u0103m s\xF3c Kh\xE1ch
      h\xE0ng."
    Hi: "\u0939\u092E \u092B\u093F\u0932\u0939\u093E\u0932 \u0928\u0947\u091F\u0935\u0930\u094D\u0915
      \u0915\u0928\u0947\u0915\u094D\u0936\u0928 \u0915\u0940 \u092A\u0941\u0937\u094D\u091F\u093F
      \u0928\u0939\u0940\u0902 \u0915\u0930 \u092A\u093E \u0930\u0939\u0947 \u0939\u0948\u0902\u0964\\n\\n\u0915\u0943\u092A\u092F\u093E
      \u0915\u0928\u0947\u0915\u094D\u0936\u0928 \u0915\u0940 \u091C\u093E\u0901\u091A
      \u0915\u0930\u0947\u0902 \u0914\u0930 \u0926\u094B\u092C\u093E\u0930\u093E
      \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930\u0947\u0902\u0964\\n\\n\u092F\u0926\u093F
      \u0938\u092E\u0938\u094D\u092F\u093E \u092C\u0928\u0940 \u0930\u0939\u0924\u0940
      \u0939\u0948, \u0924\u094B \u0915\u0943\u092A\u092F\u093E \u0917\u094D\u0930\u093E\u0939\u0915
      \u0938\u0947\u0935\u093E \u0938\u0947 \u0938\u0902\u092A\u0930\u094D\u0915
      \u0915\u0930\u0947\u0902\u0964"
    Ar: "\u0644\u0627 \u064A\u0645\u0643\u0646\u0646\u0627 \u062D\u0627\u0644\u064A\u064B\u0627
      \u0627\u0644\u062A\u062D\u0642\u0642 \u0645\u0646 \u0627\u062A\u0635\u0627\u0644
      \u0627\u0644\u0634\u0628\u0643\u0629.\\n\\n\u064A\u0631\u062C\u0649 \u0627\u0644\u062A\u062D\u0642\u0642
      \u0645\u0646 \u0627\u0644\u0627\u062A\u0635\u0627\u0644 \u0648\u0627\u0644\u0645\u062D\u0627\u0648\u0644\u0629
      \u0645\u0631\u0629 \u0623\u062E\u0631\u0649.\\n\\n\u0625\u0630\u0627 \u0627\u0633\u062A\u0645\u0631\u062A
      \u0627\u0644\u0645\u0634\u0643\u0644\u0629\u060C \u064A\u0631\u062C\u0649 \u0627\u0644\u062A\u0648\u0627\u0635\u0644
      \u0645\u0639 \u062E\u062F\u0645\u0629 \u0627\u0644\u0639\u0645\u0644\u0627\u0621."
  - Key: 6
    En: Purchase restored!
    Ko: "\uAD6C\uB9E4\uAC00 \uBCF5\uC6D0\uB418\uC5C8\uC2B5\uB2C8\uB2E4!"
    Ja: "\u8CFC\u5165\u304C\u5FA9\u5143\u3055\u308C\u307E\u3057\u305F\uFF01"
    Zh: "\u8D2D\u4E70\u5DF2\u6062\u590D\uFF01"
    Vi: "Giao d\u1ECBch mua h\xE0ng \u0111\xE3 \u0111\u01B0\u1EE3c kh\xF4i ph\u1EE5c!"
    Hi: "\u0916\u0930\u0940\u0926 \u092C\u0939\u093E\u0932!"
    Ar: "\u062A\u0645\u062A \u0627\u0633\u062A\u0639\u0627\u062F\u0629 \u0639\u0645\u0644\u064A\u0629
      \u0627\u0644\u0634\u0631\u0627\u0621!"
  - Key: 1001
    En: Level 4 Open
    Ko: "4\uB808\uBCA8 \uC624\uD508"
    Ja: "4\u30EC\u30D9\u30EB\u30AA\u30FC\u30D7\u30F3"
    Zh: "4\u7EA7\u5F00\u653E"
    Vi: "C\u1EA5p \u0111\u1ED9 4 M\u1EDF c\u1EEDa"
    Hi: "\u0938\u094D\u0924\u0930 4 \u0916\u0941\u0932\u093E \u0939\u0948"
